// Ferric 外壳（Slint 版）。
//
// 对位原 egui 版的结构：自绘无边框窗口（标题栏 44px）+ 可搜索侧栏（默认 264px）
// + 主内容区 + 设置浮层 + toast 区。
//
// 与 egui 版的关键差别：这里是 retained mode —— 状态放在 property 上，Rust 侧用
// setter 灌数据、用 callback 收事件；不再每帧重跑 UI 代码。

import { Theme } from "theme.slint";
// 把 Theme 再导出一次：Slint 只为**本文件导出**的 global 生成 Rust 侧类型，
// 光 import 进来不够 —— Rust 需要 `win.global::<Theme>()` 来切深浅色。
export { Theme }
import { FieldLabel, FerricButton, IconButton, Segmented, FerricLineEdit, Card, Toast } from "widgets.slint";
import { CodeEditor } from "editor.slint";
import { ScrollView, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";

// 侧栏一行工具。
struct ToolEntry {
    id: string,
    name: string,
    desc: string,
    icon: string,
    group: string,
    // 是否已迁到 Slint（false = 显示「迁移中」占位）
    migrated: bool,
    favorite: bool,
    // 是否通过当前搜索过滤（Rust 侧按 name / desc / keywords 计算）
    visible: bool,
}

// 一条正则匹配结果（已由 Rust 侧摊平成可直接显示的形状）。
struct RegexMatch {
    label: string,
    text: string,
    groups: [string],
}

// UUID 工具的一次执行记录。
struct UuidHistEntry {
    label: string,
    body: string,
}

// 一个编辑区的全部可见状态。
//
// 打包成 struct 而不是散成十几个 property：编辑区会被每个文本类工具用到
//（json / diff 各两个、yaml / sql / regex / crypto / gm …），散着写等于
// 每加一个工具就往 AppWindow 上堆十几行。
struct EditorState {
    // 当前可见的那几十行（已由 Rust 侧按滚动位置与横向偏移裁好）
    lines: [string],
    // 视口顶端的绝对行号，行号槽显示用
    first-line: int,
    // 文档总行数，滚动条比例用
    total-lines: int,
    // 光标的视口内坐标
    cursor-line: int,
    cursor-col: int,
    cursor-visible: bool,
    // 选区高亮 (视口行, 起列, 列数)，已裁到视口内
    selection-spans: [[int]],
}

// 带标题栏的编辑区面板。
//
// `which` 是编辑区标识（如 "yaml-in" / "json-out"），所有回调都把它带回去 ——
// Rust 侧一个 match 就能分派到对应的 TextBuffer，不必为每个编辑区接一遍回调。
component EditorPane inherits Rectangle {
    in property <string> title;
    in property <string> which;
    in property <EditorState> state;
    in property <bool> read-only: false;
    in property <string> hint: "";

    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            FieldLabel {
                text: root.title;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.state.total-lines + " 行";
                font-family: Theme.font-mono;
                font-size: 11px;
                color: Theme.faint;
                vertical-alignment: center;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-family: Theme.font-ui;
                font-size: 11px;
                color: Theme.faint;
                vertical-alignment: center;
            }
        }

        CodeEditor {
            vertical-stretch: 1;
            lines: root.state.lines;
            first-line: root.state.first-line;
            total-lines: root.state.total-lines;
            cursor-line: root.state.cursor-line;
            cursor-col: root.state.cursor-col;
            cursor-visible: root.state.cursor-visible;
            selection-spans: root.state.selection-spans;
            read-only: root.read-only;

            viewport-changed(r, c) => { root.editor-viewport(root.which, r, c); }
            clicked(l, c, e) => { root.editor-click(root.which, l, c, e); }
            dragged(l, c) => { root.editor-drag(root.which, l, c); }
            triple-clicked => { root.editor-triple(root.which); }
            scrolled(dl, dc) => { root.editor-scroll(root.which, dl, dc); }
            scroll-to-line(l) => { root.editor-scroll-line(root.which, l); }
            key-pressed(t, ctrl, shift) => { root.editor-key(root.which, t, ctrl, shift); }
        }
    }
}

// ——— JSON → YAML（已迁移） ———
component YamlView inherits Rectangle {
    in property <EditorState> input-state;
    in property <EditorState> output-state;
    in property <bool> ok: true;
    in property <string> status;

    callback load-sample();
    callback clear-input();
    callback copy-output();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // 工具条
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "示例";
                clicked => { root.load-sample(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
            }
            FerricButton {
                text: "复制 YAML";
                variant: "primary";
                clicked => { root.copy-output(); }
            }
        }

        // 左输入 / 右输出
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            EditorPane {
                title: "JSON 输入";
                which: "yaml-in";
                state: root.input-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
            EditorPane {
                title: "YAML 输出";
                which: "yaml-out";
                state: root.output-state;
                read-only: true;
                hint: "只读";
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

// ——— SQL 格式化（已迁移） ———
component SqlView inherits Rectangle {
    in property <EditorState> input-state;
    in property <bool> uppercase: true;
    in property <string> status;

    callback do-format();
    callback do-minify();
    callback toggle-uppercase();
    callback clear-input();
    callback copy-input();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "格式化";
                variant: "primary";
                clicked => { root.do-format(); }
            }
            FerricButton {
                text: "压缩为单行";
                clicked => { root.do-minify(); }
            }
            // 关键字大写：用分段控件表达开关，与设置页同一套语言
            Segmented {
                options: ["关键字大写", "原样"];
                current: root.uppercase ? 0 : 1;
                changed(i) => { root.toggle-uppercase(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
            }
            FerricButton {
                text: "复制";
                variant: "subtle";
                clicked => { root.copy-input(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
        }

        EditorPane {
            title: "SQL";
            which: "sql-in";
            state: root.input-state;
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }
    }
}

// 正则标志的独立开关。不用分段控件：五个标志可以任意组合，
// 分段控件表达的是互斥选择，语义不对。
component FlagChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();

    height: 30px;
    min-width: chip-label.min-width + 20px;
    border-radius: 7px;
    background: root.on
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.border : Theme.code-bg);

    chip-label := Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.label;
        font-family: Theme.font-ui-medium;
        font-size: 12px;
        color: root.on ? Theme.accent-strong : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ——— 正则表达式（已迁移） ———
component RegexView inherits Rectangle {
    in-out property <string> pattern;
    in property <bool> fg;
    in property <bool> fi;
    in property <bool> fm;
    in property <bool> fs;
    in property <bool> fx;
    in property <EditorState> text-state;
    in property <[RegexMatch]> matches;
    in property <bool> ok: true;
    in property <string> status;

    callback pattern-edited(string);
    callback toggle-flag(int);
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // 模式 + 标志
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                FieldLabel { text: "模式"; }
                FerricLineEdit {
                    text <=> root.pattern;
                    placeholder: "如 (\\w+)@(\\w+\\.\\w+)";
                    mono: true;
                    edited(t) => { root.pattern-edited(t); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    FieldLabel { text: "标志"; vertical-alignment: center; }
                    // 五个标志各是一个独立开关（不是互斥分段）
                    FlagChip { label: "g 全局"; on: root.fg; clicked => { root.toggle-flag(0); } }
                    FlagChip { label: "i 忽略大小写"; on: root.fi; clicked => { root.toggle-flag(1); } }
                    FlagChip { label: "m 多行"; on: root.fm; clicked => { root.toggle-flag(2); } }
                    FlagChip { label: "s 点匹配换行"; on: root.fs; clicked => { root.toggle-flag(3); } }
                    FlagChip { label: "x 忽略空白"; on: root.fx; clicked => { root.toggle-flag(4); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.status;
                        font-family: Theme.font-ui;
                        font-size: 12px;
                        color: root.ok ? Theme.muted : Theme.danger;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 待匹配文本 / 匹配结果
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            EditorPane {
                title: "待匹配文本";
                which: "regex-in";
                state: root.text-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                HorizontalLayout {
                    FieldLabel { text: "匹配结果"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.matches.length + " 处";
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: start;
                            for m in root.matches: Rectangle {
                                background: Theme.bg;
                                border-radius: 7px;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: m.label;
                                            font-family: Theme.font-mono;
                                            font-size: 11px;
                                            color: Theme.faint;
                                        }
                                        Text {
                                            text: m.text;
                                            font-family: Theme.font-mono-medium;
                                            font-size: 12.5px;
                                            color: Theme.accent-strong;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    for g[gi] in m.groups: Text {
                                        text: "  $" + (gi + 1) + " = " + g;
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— RSA 密钥对（已迁移） ———
component RsaView inherits Rectangle {
    in property <int> bits-index;
    in property <bool> busy;
    in property <bool> ok: true;
    in property <string> status;
    in property <EditorState> pub-state;
    in property <EditorState> priv-state;

    callback bits-changed(int);
    callback generate();
    callback copy-pub();
    callback copy-priv();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            FieldLabel { text: "位数"; vertical-alignment: center; }
            Segmented {
                options: ["1024", "2048", "3072", "4096"];
                current: root.bits-index;
                changed(i) => { root.bits-changed(i); }
            }
            FerricButton {
                text: root.busy ? "生成中…" : "生成";
                variant: "primary";
                enabled: !root.busy;
                clicked => { root.generate(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                EditorPane {
                    title: "公钥 (PEM)";
                    which: "rsa-pub-out";
                    state: root.pub-state;
                    read-only: true;
                    hint: "只读";
                    vertical-stretch: 1;
                    editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                    editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                    editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                    editor-triple(w) => { root.editor-triple(w); }
                    editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                    editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                    editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                }
                FerricButton {
                    text: "复制公钥";
                    clicked => { root.copy-pub(); }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                EditorPane {
                    title: "私钥 (PEM)";
                    which: "rsa-priv-out";
                    state: root.priv-state;
                    read-only: true;
                    // 提醒用户这东西不会被存下来 —— 关掉窗口就没了
                    hint: "只读 · 不持久化";
                    vertical-stretch: 1;
                    editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                    editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                    editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                    editor-triple(w) => { root.editor-triple(w); }
                    editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                    editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                    editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                }
                FerricButton {
                    text: "复制私钥";
                    clicked => { root.copy-priv(); }
                }
            }
        }
    }
}

component SidebarRow inherits Rectangle {
    in property <ToolEntry> entry;
    in property <bool> active;
    callback selected();
    callback toggle-favorite();

    height: 40px;
    border-radius: 9px;
    background: active
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.border : transparent);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        Text {
            text: root.entry.icon;
            font-family: Theme.font-icons;
            font-size: 17px;
            color: root.active ? Theme.accent-strong : Theme.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.entry.name;
                font-family: Theme.font-ui-medium;
                font-size: 13.5px;
                color: root.active ? Theme.fg : Theme.fg-soft;
                overflow: elide;
            }
        }
        // 未迁移的工具挂一个小圆点提示
        if !root.entry.migrated: Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - 7px) / 2;
            border-radius: 4px;
            background: Theme.faint;
        }
        // 收藏星标：hover 或已收藏时可见
        if ta.has-hover || root.entry.favorite: IconButton {
            icon: root.entry.favorite ? "★" : "☆";
            icon-size: 13px;
            clicked => { root.toggle-favorite(); }
        }
    }

    ta := TouchArea {
        clicked => { root.selected(); }
    }
}

// ——— 迁移中占位（9 个尚未迁的工具共用） ———
component MigrationPlaceholder inherits Rectangle {
    in property <string> tool-name;
    in property <string> tool-desc;

    VerticalLayout {
        alignment: center;
        spacing: 14px;

        Text {
            text: "⚙";
            font-family: Theme.font-icons;
            font-size: 40px;
            color: Theme.faint;
            horizontal-alignment: center;
        }
        Text {
            text: root.tool-name + " · 正在迁移到 Slint";
            font-family: Theme.font-ui-semibold;
            font-size: 16px;
            color: Theme.fg;
            horizontal-alignment: center;
        }
        Text {
            text: root.tool-desc;
            font-family: Theme.font-ui;
            font-size: 13px;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "该工具的业务逻辑在 ferric-core 里已就绪且带单测；\n这里只差 Slint 视图层。见 feat/slint-migration 分支的 phase 3。";
            font-family: Theme.font-ui;
            font-size: 12px;
            color: Theme.faint;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// ——— UUID 生成器（已完整迁移） ———
component UuidView inherits Rectangle {
    // 输入侧（双向：Rust 灌初值，UI 改了回写）
    in-out property <int> kind-index: 0;
    in-out property <int> count: 10;
    in-out property <int> namespace-index: 0;
    in-out property <string> custom-ns;
    in-out property <string> name-input: "example.com";
    in-out property <bool> upper: false;
    in-out property <bool> nohyphen: false;
    in-out property <bool> as-json: false;
    in-out property <int> hist-keep-index: 0;

    // 输出侧（只读：Rust 算完写进来）
    in property <string> output;
    in property <bool> ok: true;
    in property <string> status: "就绪";
    in property <[UuidHistEntry]> history;

    // v5 才需要命名空间 + name
    property <bool> needs-namespace: root.kind-index == 2;

    callback regenerate();
    callback copy-output();
    callback restore-history(int);

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // —— 参数区 ——
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: "版本"; }
                        Segmented {
                            options: ["v4 随机", "v7 时间序", "v5 命名", "v6 时间序"];
                            current <=> root.kind-index;
                            changed(i) => { root.regenerate(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        width: 140px;
                        FieldLabel { text: "数量"; }
                        SpinBox {
                            minimum: 1;
                            maximum: 1000;
                            value <=> root.count;
                            edited(v) => { root.regenerate(); }
                        }
                    }
                }

                // v5 专属：命名空间 + name
                if root.needs-namespace: HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 6px;
                        width: 200px;
                        FieldLabel { text: "命名空间"; }
                        ComboBox {
                            model: ["DNS", "URL", "OID", "X500", "自定义"];
                            current-index <=> root.namespace-index;
                            selected(v) => { root.regenerate(); }
                        }
                    }
                    if root.namespace-index == 4: VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "自定义命名空间 UUID"; }
                        FerricLineEdit {
                            text <=> root.custom-ns;
                            placeholder: "如 6ba7b810-9dad-11d1-80b4-00c04fd430c8";
                            mono: true;
                            edited(t) => { root.regenerate(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "名称"; }
                        FerricLineEdit {
                            text <=> root.name-input;
                            placeholder: "example.com";
                            edited(t) => { root.regenerate(); }
                        }
                    }
                }

                // 输出格式开关
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;
                    CheckBox {
                        text: "大写";
                        checked <=> root.upper;
                        toggled => { root.regenerate(); }
                    }
                    CheckBox {
                        text: "去连字符";
                        checked <=> root.nohyphen;
                        toggled => { root.regenerate(); }
                    }
                    CheckBox {
                        text: "JSON 数组";
                        checked <=> root.as-json;
                        toggled => { root.regenerate(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    FerricButton {
                        text: "重新生成";
                        icon: "⟳";
                        variant: "primary";
                        clicked => { root.regenerate(); }
                    }
                }
            }
        }

        // —— 输出区 ——
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "输出"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.status;
                        font-family: Theme.font-ui;
                        font-size: 12px;
                        color: root.ok ? Theme.ok : Theme.danger;
                        vertical-alignment: center;
                    }
                    FerricButton {
                        text: "复制";
                        icon: "⧉";
                        variant: "default";
                        clicked => { root.copy-output(); }
                    }
                }

                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;

                    ScrollView {
                        Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            text: root.output;
                            font-family: Theme.font-mono-medium;
                            font-size: 13px;
                            color: Theme.fg;
                            wrap: no-wrap;
                        }
                    }
                }
            }
        }

        // —— 执行历史 ——
        Card {
            vertical-stretch: 0;
            height: 132px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "执行记录"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    FieldLabel { text: "保留"; vertical-alignment: center; }
                    Segmented {
                        options: ["3", "5", "10", "20"];
                        current <=> root.hist-keep-index;
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for h[i] in root.history: Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: hist-ta.has-hover ? Theme.border : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: h.label;
                                    font-family: Theme.font-ui;
                                    font-size: 12px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if hist-ta.has-hover: Text {
                                    text: "点击恢复";
                                    font-family: Theme.font-ui;
                                    font-size: 11px;
                                    color: Theme.accent-strong;
                                    vertical-alignment: center;
                                }
                            }
                            hist-ta := TouchArea {
                                clicked => { root.restore-history(i); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— 设置浮层 ———
component SettingsOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> tab: 0;
    in-out property <int> theme-mode: 0;     // 0 系统 / 1 亮 / 2 暗
    in-out property <float> ui-scale: 1.0;
    in-out property <bool> auto-update: true;
    in property <string> backend-label;
    in property <string> gpu-desc;
    in property <bool> gpu-software;
    in property <string> version;
    in property <string> data-dir;
    in property <string> mem-status: "";

    callback close();
    callback open-data-dir();
    callback record-memory();
    callback check-update();

    visible: root.open;
    background: rgba(0, 0, 0, 0.45);

    // 点背景关闭
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(720px, parent.width - 80px);
        height: min(560px, parent.height - 80px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-2;

        // 吞掉点击，避免穿透到背景的关闭逻辑
        TouchArea { }

        VerticalLayout {
            // 标题栏
            Rectangle {
                height: 48px;
                background: Theme.titlebar;
                border-radius: 14px;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    Text {
                        text: "设置";
                        font-family: Theme.font-ui-semibold;
                        font-size: 15px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: "✕";
                        icon-size: 14px;
                        clicked => { root.close(); }
                    }
                }
            }

            HorizontalLayout {
                // 分类栏
                Rectangle {
                    width: 148px;
                    background: Theme.rail;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        alignment: start;
                        for label[i] in ["外观", "字体", "渲染", "更新", "数据", "关于"]: Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: i == root.tab
                                ? Theme.accent-soft
                                : (cat-ta.has-hover ? Theme.border : transparent);
                            Text {
                                x: 12px;
                                width: parent.width - 12px;
                                height: 100%;
                                text: label;
                                font-family: Theme.font-ui-medium;
                                font-size: 13px;
                                color: i == root.tab ? Theme.accent-strong : Theme.fg-soft;
                                vertical-alignment: center;
                            }
                            cat-ta := TouchArea {
                                clicked => { root.tab = i; }
                            }
                        }
                    }
                }

                // 内容区
                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;
                        alignment: start;

                        // —— 外观 ——
                        if root.tab == 0: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "主题"; }
                            Segmented {
                                options: ["跟随系统", "亮色", "暗色"];
                                current <=> root.theme-mode;
                            }
                            FieldLabel { text: "界面缩放"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: Math.round(root.ui-scale * 100) + "%";
                                    font-family: Theme.font-mono-medium;
                                    font-size: 13px;
                                    color: Theme.fg;
                                    vertical-alignment: center;
                                    width: 56px;
                                }
                                FerricButton {
                                    text: "−";
                                    clicked => {
                                        root.ui-scale = max(0.8, root.ui-scale - 0.1);
                                    }
                                }
                                FerricButton {
                                    text: "+";
                                    clicked => {
                                        root.ui-scale = min(1.6, root.ui-scale + 0.1);
                                    }
                                }
                                FerricButton {
                                    text: "重置 100%";
                                    variant: "subtle";
                                    clicked => { root.ui-scale = 1.0; }
                                }
                            }
                        }

                        // —— 字体 ——
                        if root.tab == 1: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "内嵌字体"; }
                            Text {
                                text: "UI：Plus Jakarta Sans（Regular / Medium / SemiBold / Bold）\n等宽：JetBrains Mono（Regular / Medium）\n图标：Lucide\n中文：从系统加载（微软雅黑 / 苹方 / Noto CJK）";
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }

                        // —— 渲染 ——
                        if root.tab == 2: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "渲染后端"; }
                            Text {
                                text: root.backend-label;
                                font-family: Theme.font-ui-medium;
                                font-size: 13px;
                                color: Theme.fg;
                            }
                            Text {
                                text: root.gpu-desc;
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: root.gpu-software ? Theme.danger : Theme.muted;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Slint 软件渲染：不建任何 GPU 上下文，进程内存与「一个窗口 + 一块位图」相当。\n这是迁移的主要收益 —— egui/wgpu 时代同一台机器上是 ~611MB。";
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.faint;
                                wrap: word-wrap;
                            }
                        }

                        // —— 更新 ——
                        if root.tab == 3: VerticalLayout {
                            spacing: 10px;
                            CheckBox {
                                text: "自动检查更新并后台下载";
                                checked <=> root.auto-update;
                            }
                            FerricButton {
                                text: "立即检查更新";
                                variant: "default";
                                clicked => { root.check-update(); }
                            }
                        }

                        // —— 数据 ——
                        if root.tab == 4: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "数据目录"; }
                            Text {
                                text: root.data-dir;
                                font-family: Theme.font-mono-medium;
                                font-size: 12px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                FerricButton {
                                    text: "打开数据文件夹";
                                    icon: "⌸";
                                    clicked => { root.open-data-dir(); }
                                }
                                FerricButton {
                                    text: "记录 30 秒内存";
                                    clicked => { root.record-memory(); }
                                }
                            }
                            if root.mem-status != "": Text {
                                text: root.mem-status;
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.accent-strong;
                            }
                        }

                        // —— 关于 ——
                        if root.tab == 5: VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "Ferric " + root.version;
                                font-family: Theme.font-ui-semibold;
                                font-size: 16px;
                                color: Theme.fg;
                            }
                            Text {
                                text: "跨平台原生 Rust 开发者工具箱。\nGUI：Slint（软件渲染）。";
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Ferric";
    // 与原 eframe 版一致的默认尺寸与下限。
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 360px;
    min-height: 280px;
    no-frame: true;
    background: Theme.canvas;

    // ——— 状态（Rust 侧读写） ———
    in property <[ToolEntry]> tools;
    in-out property <int> active-tool: 0;
    in-out property <string> rail-filter: "";
    in-out property <length> rail-width: 264px;
    in-out property <bool> settings-open: false;
    in property <string> version: "0.2.0";
    in property <string> backend-label: "软渲染（CPU）";
    in property <string> gpu-desc: "CPU 软渲染（Slint software renderer）";
    in property <bool> gpu-software: true;
    in property <string> data-dir: "";
    in property <string> mem-status: "";
    // 侧栏底部的迁移进度（Rust 侧按 registry 里 migrated 的数量算）
    in property <string> migration-note: "";
    in property <[string]> toasts;

    // 设置项（双向）
    in-out property <int> theme-mode: 0;
    in-out property <float> ui-scale: 1.0;
    in-out property <bool> auto-update: true;
    in-out property <int> settings-tab: 0;

    // UUID 工具状态
    in-out property <int> uuid-kind: 0;
    in-out property <int> uuid-count: 10;
    in-out property <int> uuid-namespace: 0;
    in-out property <string> uuid-custom-ns: "";
    in-out property <string> uuid-name: "example.com";
    in-out property <bool> uuid-upper: false;
    in-out property <bool> uuid-nohyphen: false;
    in-out property <bool> uuid-as-json: false;
    in-out property <int> uuid-hist-keep: 0;
    in property <string> uuid-output: "";
    in property <bool> uuid-ok: true;
    in property <string> uuid-status: "就绪";
    in property <[UuidHistEntry]> uuid-history;

    // YAML 工具状态
    in property <EditorState> yaml-input;
    in property <EditorState> yaml-output;
    in property <bool> yaml-ok: true;
    in property <string> yaml-status: "";

    // SQL 工具状态
    in property <EditorState> sql-input;
    in property <bool> sql-uppercase: true;
    in property <string> sql-status: "";

    // 正则工具状态
    in-out property <string> regex-pattern;
    in property <bool> regex-fg: true;
    in property <bool> regex-fi;
    in property <bool> regex-fm;
    in property <bool> regex-fs;
    in property <bool> regex-fx;
    in property <EditorState> regex-text;
    in property <[RegexMatch]> regex-matches;
    in property <bool> regex-ok: true;
    in property <string> regex-status: "";

    // RSA 工具状态
    in property <int> rsa-bits: 1;
    in property <bool> rsa-busy;
    in property <bool> rsa-ok: true;
    in property <string> rsa-status: "";
    in property <EditorState> rsa-pub;
    in property <EditorState> rsa-priv;

    // ——— 回调（Rust 侧接管） ———
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    callback select-tool(int);
    callback toggle-favorite(int);
    callback theme-changed(int);
    callback scale-changed(float);
    callback open-data-dir();
    callback record-memory();
    callback check-update();
    callback uuid-regenerate();
    callback uuid-copy();
    callback uuid-restore-history(int);

    // 编辑区通用回调。第一个参数是编辑区标识（如 "yaml-in"），
    // Rust 侧一个 match 分派到对应的 TextBuffer —— 每加一个文本类工具
    // 不需要再接一遍回调。
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    // YAML 工具
    callback yaml-sample();
    callback yaml-clear();
    callback yaml-copy();

    // SQL 工具
    callback sql-format();
    callback sql-minify();
    callback sql-toggle-uppercase();
    callback sql-clear();
    callback sql-copy();

    // 正则工具
    callback regex-pattern-edited(string);
    callback regex-toggle-flag(int);

    // RSA 工具
    callback rsa-bits-changed(int);
    callback rsa-generate();
    callback rsa-copy-pub();
    callback rsa-copy-priv();

    // 当前工具（tools 可能为空，取值前保护）
    property <ToolEntry> current: root.tools.length > 0
        ? root.tools[min(root.active-tool, root.tools.length - 1)]
        : { id: "", name: "", desc: "", icon: "", group: "", migrated: false, favorite: false, visible: true };

    VerticalLayout {
        // ===== 标题栏 44px =====
        Rectangle {
            height: 44px;
            background: Theme.titlebar;

            // 拖拽区（按钮覆盖其上）
            drag-ta := TouchArea {
                width: parent.width - 140px;
                height: parent.height;
                moved => { root.window-drag(); }
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 4px;
                spacing: 0px;

                Text {
                    text: "Ferric";
                    font-family: Theme.font-ui-bold;
                    font-size: 14.5px;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 12px;
                }
                Text {
                    text: root.version;
                    font-family: Theme.font-mono-medium;
                    font-size: 11.5px;
                    color: Theme.faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // 设置入口
                IconButton {
                    icon: "⚙";
                    icon-size: 16px;
                    clicked => { root.settings-open = true; }
                }
                Rectangle { width: 4px; }
                // 窗口按钮
                IconButton {
                    icon: "—";
                    icon-size: 14px;
                    clicked => { root.window-minimize(); }
                }
                IconButton {
                    icon: "▢";
                    icon-size: 13px;
                    clicked => { root.window-maximize(); }
                }
                IconButton {
                    icon: "✕";
                    icon-size: 14px;
                    clicked => { root.window-close(); }
                }
            }

            // 底部分隔线
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }
        }

        HorizontalLayout {
            // ===== 侧栏 =====
            Rectangle {
                width: root.rail-width;
                background: Theme.rail;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // 搜索框
                    FerricLineEdit {
                        placeholder: "搜索工具…";
                        text <=> root.rail-filter;
                    }

                    // 工具列表
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for t[i] in root.tools: SidebarRow {
                                entry: t;
                                active: i == root.active-tool;
                                // 搜索过滤在 Rust 侧做（Slint 的 string 没有
                                // contains；且中文匹配要按 char 比，交给 Rust 更稳）。
                                visible: t.visible;
                                selected => { root.select-tool(i); }
                                toggle-favorite => { root.toggle-favorite(i); }
                            }
                        }
                    }

                    // 底部：迁移进度提示
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    Text {
                        text: root.migration-note;
                        font-family: Theme.font-ui;
                        font-size: 11px;
                        color: Theme.faint;
                        horizontal-alignment: center;
                    }
                }

                // 右边缘分隔线
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }
            }

            // ===== 主内容区 =====
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg;

                VerticalLayout {
                    // 工具标题条
                    Rectangle {
                        height: 64px;
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.current.name;
                                    font-family: Theme.font-ui-bold;
                                    font-size: 19px;
                                    color: Theme.fg;
                                }
                                Text {
                                    text: root.current.desc;
                                    font-family: Theme.font-ui;
                                    font-size: 12.5px;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: Theme.border;
                        }
                    }

                    // 工具主体：已迁移的走真实视图，其余走占位
                    if root.current.id == "uuid": UuidView {
                        vertical-stretch: 1;
                        kind-index <=> root.uuid-kind;
                        count <=> root.uuid-count;
                        namespace-index <=> root.uuid-namespace;
                        custom-ns <=> root.uuid-custom-ns;
                        name-input <=> root.uuid-name;
                        upper <=> root.uuid-upper;
                        nohyphen <=> root.uuid-nohyphen;
                        as-json <=> root.uuid-as-json;
                        hist-keep-index <=> root.uuid-hist-keep;
                        output: root.uuid-output;
                        ok: root.uuid-ok;
                        status: root.uuid-status;
                        history: root.uuid-history;
                        regenerate => { root.uuid-regenerate(); }
                        copy-output => { root.uuid-copy(); }
                        restore-history(i) => { root.uuid-restore-history(i); }
                    }
                    if root.current.id == "yaml": YamlView {
                        vertical-stretch: 1;
                        input-state: root.yaml-input;
                        output-state: root.yaml-output;
                        ok: root.yaml-ok;
                        status: root.yaml-status;
                        load-sample => { root.yaml-sample(); }
                        clear-input => { root.yaml-clear(); }
                        copy-output => { root.yaml-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "sql": SqlView {
                        vertical-stretch: 1;
                        input-state: root.sql-input;
                        uppercase: root.sql-uppercase;
                        status: root.sql-status;
                        do-format => { root.sql-format(); }
                        do-minify => { root.sql-minify(); }
                        toggle-uppercase => { root.sql-toggle-uppercase(); }
                        clear-input => { root.sql-clear(); }
                        copy-input => { root.sql-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "regex": RegexView {
                        vertical-stretch: 1;
                        pattern <=> root.regex-pattern;
                        fg: root.regex-fg;
                        fi: root.regex-fi;
                        fm: root.regex-fm;
                        fs: root.regex-fs;
                        fx: root.regex-fx;
                        text-state: root.regex-text;
                        matches: root.regex-matches;
                        ok: root.regex-ok;
                        status: root.regex-status;
                        pattern-edited(t) => { root.regex-pattern-edited(t); }
                        toggle-flag(i) => { root.regex-toggle-flag(i); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "rsa": RsaView {
                        vertical-stretch: 1;
                        bits-index: root.rsa-bits;
                        busy: root.rsa-busy;
                        ok: root.rsa-ok;
                        status: root.rsa-status;
                        pub-state: root.rsa-pub;
                        priv-state: root.rsa-priv;
                        bits-changed(i) => { root.rsa-bits-changed(i); }
                        generate => { root.rsa-generate(); }
                        copy-pub => { root.rsa-copy-pub(); }
                        copy-priv => { root.rsa-copy-priv(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    // 未迁移的工具走占位。条件用 `migrated` 而不是逐个列 id ——
                    // 每迁完一个只需把 Tool::migrated 翻成 true 并加上面那样一个分支。
                    if !root.current.migrated: MigrationPlaceholder {
                        vertical-stretch: 1;
                        tool-name: root.current.name;
                        tool-desc: root.current.desc;
                    }
                }
            }
        }
    }

    // ===== Toast 区（右下角堆叠） =====
    VerticalLayout {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
        width: 340px;
        spacing: 8px;
        alignment: end;
        for msg in root.toasts: Toast { text: msg; }
    }

    // ===== 设置浮层 =====
    SettingsOverlay {
        width: parent.width;
        height: parent.height;
        open <=> root.settings-open;
        tab <=> root.settings-tab;
        theme-mode <=> root.theme-mode;
        ui-scale <=> root.ui-scale;
        auto-update <=> root.auto-update;
        backend-label: root.backend-label;
        gpu-desc: root.gpu-desc;
        gpu-software: root.gpu-software;
        version: root.version;
        data-dir: root.data-dir;
        mem-status: root.mem-status;
        close => { root.settings-open = false; }
        open-data-dir => { root.open-data-dir(); }
        record-memory => { root.record-memory(); }
        check-update => { root.check-update(); }
    }
}