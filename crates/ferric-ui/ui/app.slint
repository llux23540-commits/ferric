                        enc-ok: root.crypto-enc-ok;
                        dec-ok: root.crypto-dec-ok;
                        enc-status: root.crypto-enc-status;
                        dec-status: root.crypto-dec-status;
                        enc-algo-changed(i) => { root.crypto-enc-algo-changed(i); }
                        dec-algo-changed(i) => { root.crypto-dec-algo-changed(i); }
                        enc-key-edited(k) => { root.crypto-enc-key-edited(k); }
                        dec-key-edited(k) => { root.crypto-dec-key-edited(k); }
                        do-encrypt => { root.crypto-encrypt(); }
                        do-decrypt => { root.crypto-decrypt(); }
                        send-to-decrypt => { root.crypto-send-to-decrypt(); }
                        copy-enc => { root.crypto-copy-enc(); }
                        copy-dec => { root.crypto-copy-dec(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-fold(w, r) => { root.editor-fold(w, r); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "gm": GmView {
                        vertical-stretch: 1;
                        pub-key <=> root.gm-pub-key;
                        priv-key <=> root.gm-priv-key;
                        key-status: root.gm-key-status;
                        enc-algos: root.gm-enc-algos;
                        dec-algos: root.gm-dec-algos;
                        fmts: root.gm-fmts;
                        enc-algo: root.gm-enc-algo;
                        dec-algo: root.gm-dec-algo;
                        fmt-index: root.gm-fmt;
                        enc-needs-key: root.gm-enc-needs-key;
                        enc-key-label: root.gm-enc-key-label;
                        dec-key-label: root.gm-dec-key-label;
                        enc-key <=> root.gm-enc-key;
                        dec-key <=> root.gm-dec-key;
                        enc-in: root.gm-enc-in;
                        enc-out: root.gm-enc-out;
                        dec-in: root.gm-dec-in;
                        dec-out: root.gm-dec-out;
                        enc-ok: root.gm-enc-ok;
                        dec-ok: root.gm-dec-ok;
