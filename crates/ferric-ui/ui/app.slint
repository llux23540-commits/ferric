// Ferric 外壳（Slint 版）。
//
// 对位原 egui 版的结构：自绘无边框窗口（标题栏 44px）+ 可搜索侧栏（默认 264px）
// + 主内容区 + 设置浮层 + toast 区。
//
// 与 egui 版的关键差别：这里是 retained mode —— 状态放在 property 上，Rust 侧用
// setter 灌数据、用 callback 收事件；不再每帧重跑 UI 代码。

import { Theme, Icons } from "theme.slint";
// 把 Theme 再导出一次：Slint 只为**本文件导出**的 global 生成 Rust 侧类型，
// 光 import 进来不够 —— Rust 需要 `win.global::<Theme>()` 来切深浅色。
export { Theme }
import { FieldLabel, FerricButton, IconButton, VDivider, Segmented, FerricLineEdit, Card, Toast, Tooltip, FilterTag } from "widgets.slint";
import { CodeEditor, TokenLine, CellSpan } from "editor.slint";
import { ScrollView, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";

// 侧栏一行工具。
struct ToolEntry {
    // 在 Rust 侧 `AppState::tools` 里的下标。选中 / 收藏回调都传它 ——
    // 模型经过搜索过滤，`for` 的循环下标已经不是工具下标了。
    idx: int,
    id: string,
    name: string,
    desc: string,
    icon: string,
    group: string,
    favorite: bool,
    // 是否整宽铺开（编辑器类工具）。false = 收进 1080px 居中列。
    wide: bool,
}

// 一条提示。`level`：0 普通 / 1 警告 / 2 失败；`id` 是 Rust 侧的序号，
// 点「×」时按它关掉那一条（用下标会在别的提示同时过期时关错人）。
struct ToastRow {
    id: int,
    text: string,
    level: int,
}

// 一条操作记录（提示的长期落点）。`at` 是 HH:MM:SS。
struct ActivityRow {
    at: string,
    text: string,
    level: int,
}

// 侧栏的一行。分组标题与工具行混在同一个模型里：`group == true` 是标题。
// 这样分组顺序、收藏置顶都由 Rust 侧一次算好（见 `rail_rows`），
// Slint 只按 kind 画两种行。
struct RailRow {
    group: bool,
    label: string,
    icon: string,
    desc: string,
    // 工具在 Rust 侧 `AppState::tools` 里的下标；标题行是 -1。
    idx: int,
    favorite: bool,
}

// 一条正则匹配结果（已由 Rust 侧摊平成可直接显示的形状）。
struct RegexMatch {
    label: string,
    text: string,
    groups: [string],
}

// 插件 manifest 声明的一个选项控件。
// kind: 0 分段 / 1 开关 / 2 文本
struct PluginOption {
    kind: int,
    label: string,
    values: [string],
    selected: int,
    on: bool,
    text: string,
    hint: string,
}

// 插件市场的一张卡片。
struct PluginCard {
    slug: string,
    name: string,
    desc: string,
    version: string,
    installed: string,
    has-update: bool,
    is-installed: bool,
    size-text: string,
    downloads-text: string,
    // 这张卡正在安装
    busy: bool,
    // 已点过安装、在等前面那个装完（同一时刻只装一个）
    queued: bool,
}

// JSON 粘贴记录的一行（右侧抽屉）。一条记录 = 数据目录里的一个文件，
// `name` 就是文件名。
struct HistoryRow {
    name: string,
    when: string,
    size: string,
    preview: string,
}


// 时区列表里的一项。
struct TzRow {
    name: string,
    label: string,
}

// UUID 工具的一次执行记录。
struct UuidHistEntry {
    label: string,
    body: string,
}

// 语法着色片段（`TokenRun`）定义在 editor.slint 里：编辑区是它的唯一消费者，
// 而 app.slint 已经 import 了那个文件（反过来 import 会成环）。

// 一个编辑区的全部可见状态。
//
// 打包成 struct 而不是散成十几个 property：编辑区会被每个文本类工具用到
//（json / diff 各两个、yaml / sql / regex / crypto / gm …），散着写等于
// 每加一个工具就往 AppWindow 上堆十几行。
struct EditorState {
    // 当前可见的那几十行（已由 Rust 侧按滚动位置与横向偏移裁好）
    lines: [string],
    // 每个可见行的真实行号（1 基）。折叠之后行号不连续，只能逐行给
    line-nos: [int],
    // 视口顶端是第几个可见行，滚动条位置用
    first-line: int,
    // 可见行总数（折叠算进去了），滚动条比例与拖动刻度用
    total-lines: int,
    // 文档真实行数，标题栏那句「N 行」用
    doc-lines: int,
    // 每个可见行的折叠标记：0 不是区块开头 / 1 可折叠 / 2 已折叠
    fold-marks: [int],
    // 这一屏里有没有可折叠的行（决定行号槽要不要让出折叠列）
    foldable: bool,
    // 差异种类（每个可见行）：0 相同 / 1 删除 / 2 新增 —— 整行底色按它上
    row-kinds: [int],
    // 这一屏里有没有差异行（决定行号槽要不要让出 -/+ 那一列）
    diffed: bool,
    // 字符级高亮：改动行里「改了哪几个字」（坐标是窄字宽的倍数）
    emph-spans: [CellSpan],
    // 光标的视口内位置：行是整数，横向是窄字宽的倍数（中文一个字宽过一格）
    cursor-line: int,
    cursor-x: float,
    cursor-visible: bool,
    // 语法着色的片段（JSON 工具用）。Slint 没有富文本，所以一行是一串
    // 顺次排开的片段 —— 宽度交给字体，中文才不会互相压字。
    tokens: [TokenLine],
    // 这一屏有没有着色片段（有就不再画整行纯文本，免得画两遍）
    highlighted: bool,
    // 选区高亮，已裁到视口内（坐标同为窄字宽的倍数）
    selection-spans: [CellSpan],
}

// 带标题栏的编辑区面板。
//
// `which` 是编辑区标识（如 "yaml-in" / "json-out"），所有回调都把它带回去 ——
// Rust 侧一个 match 就能分派到对应的 TextBuffer，不必为每个编辑区接一遍回调。
component EditorPane inherits Rectangle {
    in property <string> title;
    in property <string> which;
    in property <EditorState> state;
    in property <bool> read-only: false;
    in property <string> hint: "";

    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    // 让外面能把焦点交回编辑区（JSON 工具收起查找条时要用）。
    forward-focus: ed;

    VerticalLayout {
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            FieldLabel {
                text: root.title;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.state.doc-lines + " 行";
                font-family: Theme.font-mono;
                font-size: 11px;
                color: Theme.faint;
                vertical-alignment: center;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-family: Theme.font-ui;
                font-size: 11px;
                color: Theme.faint;
                vertical-alignment: center;
            }
        }

        ed := CodeEditor {
            vertical-stretch: 1;
            lines: root.state.lines;
            line-nos: root.state.line-nos;
            first-line: root.state.first-line;
            total-lines: root.state.total-lines;
            fold-marks: root.state.fold-marks;
            foldable: root.state.foldable;
            row-kinds: root.state.row-kinds;
            diffed: root.state.diffed;
            emph-spans: root.state.emph-spans;
            tokens: root.state.tokens;
            highlighted: root.state.highlighted;
            cursor-line: root.state.cursor-line;
            cursor-x: root.state.cursor-x;
            cursor-visible: root.state.cursor-visible;
            selection-spans: root.state.selection-spans;
            read-only: root.read-only;

            viewport-changed(r, c) => { root.editor-viewport(root.which, r, c); }
            wide-ratio-changed(v) => { root.editor-wide-ratio(v); }
            clicked(l, c, e) => { root.editor-click(root.which, l, c, e); }
            dragged(l, c) => { root.editor-drag(root.which, l, c); }
            triple-clicked => { root.editor-triple(root.which); }
            scrolled(dl, dc) => { root.editor-scroll(root.which, dl, dc); }
            scroll-to-line(l) => { root.editor-scroll-line(root.which, l); }
            fold-toggled(r) => { root.editor-fold(root.which, r); }
            key-pressed(t, ctrl, shift) => { root.editor-key(root.which, t, ctrl, shift); }
        }
    }
}

// ——— JSON → YAML ———
component YamlView inherits Rectangle {
    in property <EditorState> input-state;
    in property <EditorState> output-state;
    in property <bool> ok: true;
    in property <string> status;

    callback load-sample();
    callback clear-input();
    callback copy-output();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // 工具条
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "示例";
                clicked => { root.load-sample(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
            }
            FerricButton {
                text: "复制 YAML";
                variant: "primary";
                clicked => { root.copy-output(); }
            }
        }

        // 左输入 / 右输出
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            EditorPane {
                title: "JSON 输入";
                which: "yaml-in";
                state: root.input-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
            EditorPane {
                title: "YAML 输出";
                which: "yaml-out";
                state: root.output-state;
                read-only: true;
                hint: "只读";
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

// ——— SQL 格式化 ———
component SqlView inherits Rectangle {
    in property <EditorState> input-state;
    in property <bool> uppercase: true;
    in property <string> status;

    callback do-format();
    callback do-minify();
    callback set-case(int);
    callback clear-input();
    callback copy-input();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "格式化";
                variant: "primary";
                clicked => { root.do-format(); }
            }
            FerricButton {
                text: "压缩为单行";
                clicked => { root.do-minify(); }
            }
            // 关键字大小写：两档都是**真的会变**的（关掉不是「保持原样」——
            // 那一档一旦排过一次就再也回不去，按下去毫无变化）。
            FieldLabel {
                text: "关键字";
                vertical-alignment: center;
            }
            Segmented {
                options: ["大写", "小写"];
                current: root.uppercase ? 0 : 1;
                changed(i) => { root.set-case(i); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
            }
            FerricButton {
                text: "复制";
                variant: "subtle";
                clicked => { root.copy-input(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
        }

        EditorPane {
            title: "SQL";
            which: "sql-in";
            state: root.input-state;
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-fold(w, r) => { root.editor-fold(w, r); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }
    }
}

// 正则标志的独立开关。不用分段控件：五个标志可以任意组合，
// 分段控件表达的是互斥选择，语义不对。
component FlagChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();

    height: 30px;
    min-width: chip-label.min-width + 20px;
    border-radius: 7px;
    background: root.on
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.border : Theme.code-bg);

    chip-label := Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.label;
        font-family: Theme.font-ui-medium;
        font-size: 12px;
        color: root.on ? Theme.accent-strong : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ——— 正则表达式 ———
component RegexView inherits Rectangle {
    in-out property <string> pattern;
    in property <bool> fg;
    in property <bool> fi;
    in property <bool> fm;
    in property <bool> fs;
    in property <bool> fx;
    in property <EditorState> text-state;
    in property <[RegexMatch]> matches;
    in property <bool> ok: true;
    in property <string> status;

    callback pattern-edited(string);
    callback toggle-flag(int);
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // 模式 + 标志
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                FieldLabel { text: "模式"; }
                FerricLineEdit {
                    text <=> root.pattern;
                    placeholder: "如 (\\w+)@(\\w+\\.\\w+)";
                    mono: true;
                    edited(t) => { root.pattern-edited(t); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    FieldLabel { text: "标志"; vertical-alignment: center; }
                    // 五个标志各是一个独立开关（不是互斥分段）
                    FlagChip { label: "g 全局"; on: root.fg; clicked => { root.toggle-flag(0); } }
                    FlagChip { label: "i 忽略大小写"; on: root.fi; clicked => { root.toggle-flag(1); } }
                    FlagChip { label: "m 多行"; on: root.fm; clicked => { root.toggle-flag(2); } }
                    FlagChip { label: "s 点匹配换行"; on: root.fs; clicked => { root.toggle-flag(3); } }
                    FlagChip { label: "x 忽略空白"; on: root.fx; clicked => { root.toggle-flag(4); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.status;
                        font-family: Theme.font-ui;
                        font-size: 12px;
                        color: root.ok ? Theme.muted : Theme.danger;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 待匹配文本 / 匹配结果
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            EditorPane {
                title: "待匹配文本";
                which: "regex-in";
                state: root.text-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                HorizontalLayout {
                    FieldLabel { text: "匹配结果"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.matches.length + " 处";
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: start;
                            for m in root.matches: Rectangle {
                                background: Theme.bg;
                                border-radius: 7px;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: m.label;
                                            font-family: Theme.font-mono;
                                            font-size: 11px;
                                            color: Theme.faint;
                                        }
                                        Text {
                                            text: m.text;
                                            font-family: Theme.font-mono-medium;
                                            font-size: 12.5px;
                                            color: Theme.accent-strong;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    for g[gi] in m.groups: Text {
                                        text: "  $" + (gi + 1) + " = " + g;
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— RSA 密钥对 ———
component RsaView inherits Rectangle {
    in property <int> bits-index;
    in property <bool> busy;
    in property <bool> ok: true;
    in property <string> status;
    in property <EditorState> pub-state;
    in property <EditorState> priv-state;

    callback bits-changed(int);
    callback generate();
    callback copy-pub();
    callback copy-priv();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            FieldLabel { text: "位数"; vertical-alignment: center; }
            Segmented {
                options: ["1024", "2048", "3072", "4096"];
                current: root.bits-index;
                changed(i) => { root.bits-changed(i); }
            }
            FerricButton {
                text: root.busy ? "生成中…" : "生成";
                variant: "primary";
                enabled: !root.busy;
                clicked => { root.generate(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
            }
        }

        // 公钥在上、私钥在下（对位 egui 版）。PEM 一行 64 字符，左右分栏时
        // 每栏都不够宽，反倒都要横向滚。私钥那块给更多高度：它更长。
        VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            VerticalLayout {
                vertical-stretch: 1;
                spacing: 6px;
                EditorPane {
                    title: "公钥 (PEM)";
                    which: "rsa-pub-out";
                    state: root.pub-state;
                    read-only: true;
                    hint: "只读";
                    vertical-stretch: 1;
                    editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                    editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                    editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                    editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                    editor-triple(w) => { root.editor-triple(w); }
                    editor-fold(w, r) => { root.editor-fold(w, r); }
                    editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                    editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                    editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                }
                FerricButton {
                    text: "复制公钥";
                    clicked => { root.copy-pub(); }
                }
            }

            VerticalLayout {
                vertical-stretch: 2;
                spacing: 6px;
                EditorPane {
                    title: "私钥 (PEM)";
                    which: "rsa-priv-out";
                    state: root.priv-state;
                    read-only: true;
                    // 提醒用户这东西不会被存下来 —— 关掉窗口就没了
                    hint: "只读 · 不持久化";
                    vertical-stretch: 1;
                    editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                    editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                    editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                    editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                    editor-triple(w) => { root.editor-triple(w); }
                    editor-fold(w, r) => { root.editor-fold(w, r); }
                    editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                    editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                    editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                }
                FerricButton {
                    text: "复制私钥";
                    clicked => { root.copy-priv(); }
                }
            }
        }
    }
}

// 加密 / 解密的一侧。两侧同构，收成一个组件 —— 散着写等于同一段抄两遍。
component CryptoSide inherits Rectangle {
    in property <string> title;
    in property <string> action-label;
    in property <string> which-in;
    in property <string> which-out;
    in property <[string]> algos;
    in property <int> algo-index;
    in-out property <string> key;
    in property <EditorState> input-state;
    in property <EditorState> output-state;
    in property <bool> ok: true;
    in property <string> status;
    in property <string> input-title;
    in property <string> output-title;

    callback algo-changed(int);
    callback key-edited(string);
    callback run();
    callback copy-output();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.title;
            font-family: Theme.font-ui-semibold;
            font-size: 14px;
            color: Theme.fg;
        }

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                width: 40%;
                FieldLabel { text: "算法"; }
                ComboBox {
                    model: root.algos;
                    current-index: root.algo-index;
                    selected(v) => { root.algo-changed(self.current-index); }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                FieldLabel { text: "口令（不持久化）"; }
                FerricLineEdit {
                    text <=> root.key;
                    placeholder: "口令";
                    edited(t) => { root.key-edited(t); }
                }
            }
        }

        EditorPane {
            title: root.input-title;
            which: root.which-in;
            state: root.input-state;
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-fold(w, r) => { root.editor-fold(w, r); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }

        HorizontalLayout {
            spacing: 8px;
            FerricButton {
                text: root.action-label;
                variant: "primary";
                clicked => { root.run(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 11.5px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
                overflow: elide;
            }
            FerricButton {
                text: "复制";
                variant: "subtle";
                clicked => { root.copy-output(); }
            }
        }

        EditorPane {
            title: root.output-title;
            which: root.which-out;
            state: root.output-state;
            read-only: true;
            hint: "只读";
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-fold(w, r) => { root.editor-fold(w, r); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }
    }
}

// ——— 加密 / 解密文本 ———
component CryptoView inherits Rectangle {
    in property <[string]> algos;
    in property <int> enc-algo;
    in property <int> dec-algo;
    in-out property <string> enc-key;
    in-out property <string> dec-key;
    in property <EditorState> enc-in;
    in property <EditorState> enc-out;
    in property <EditorState> dec-in;
    in property <EditorState> dec-out;
    in property <bool> enc-ok: true;
    in property <bool> dec-ok: true;
    in property <string> enc-status;
    in property <string> dec-status;

    callback enc-algo-changed(int);
    callback dec-algo-changed(int);
    callback enc-key-edited(string);
    callback dec-key-edited(string);
    callback do-encrypt();
    callback do-decrypt();
    callback send-to-decrypt();
    callback copy-enc();
    callback copy-dec();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            alignment: start;
            FerricButton {
                text: "把密文送去解密";
                icon: Icons.chevron-right;
                clicked => { root.send-to-decrypt(); }
            }
        }

        // 加密卡在上、解密卡在下（对位 egui 版的两张卡上下堆叠）。
        // 并排的话每侧只剩一半宽度，Base64 密文换行更频繁，反而更难读。
        VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            CryptoSide {
                vertical-stretch: 1;
                title: "加密";
                action-label: "加密";
                which-in: "crypto-enc-in";
                which-out: "crypto-enc-out";
                input-title: "明文";
                output-title: "密文 (Base64)";
                algos: root.algos;
                algo-index: root.enc-algo;
                key <=> root.enc-key;
                input-state: root.enc-in;
                output-state: root.enc-out;
                ok: root.enc-ok;
                status: root.enc-status;
                algo-changed(i) => { root.enc-algo-changed(i); }
                key-edited(k) => { root.enc-key-edited(k); }
                run => { root.do-encrypt(); }
                copy-output => { root.copy-enc(); }
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }

            CryptoSide {
                vertical-stretch: 1;
                title: "解密";
                action-label: "解密";
                which-in: "crypto-dec-in";
                which-out: "crypto-dec-out";
                input-title: "密文 (Base64)";
                output-title: "明文";
                algos: root.algos;
                algo-index: root.dec-algo;
                key <=> root.dec-key;
                input-state: root.dec-in;
                output-state: root.dec-out;
                ok: root.dec-ok;
                status: root.dec-status;
                algo-changed(i) => { root.dec-algo-changed(i); }
                key-edited(k) => { root.dec-key-edited(k); }
                run => { root.do-decrypt(); }
                copy-output => { root.copy-dec(); }
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

// ——— 国密 SM ———
component GmView inherits Rectangle {
    // 密钥对
    in-out property <string> pub-key;
    in-out property <string> priv-key;
    in property <string> key-status;
    // 加密 / 解密
    in property <[string]> enc-algos;
    in property <[string]> dec-algos;
    in property <[string]> fmts;
    in property <int> enc-algo;
    in property <int> dec-algo;
    in property <int> fmt-index;
    in property <bool> enc-needs-key: true;
    in property <string> enc-key-label: "口令";
    in property <string> dec-key-label: "口令";
    in-out property <string> enc-key;
    in-out property <string> dec-key;
    in property <EditorState> enc-in;
    in property <EditorState> enc-out;
    in property <EditorState> dec-in;
    in property <EditorState> dec-out;
    in property <bool> enc-ok: true;
    in property <bool> dec-ok: true;
    in property <string> enc-status;
    in property <string> dec-status;
    // 签名
    in property <EditorState> sig-state;
    in-out property <string> sig-hex;
    in property <bool> sig-ok: true;
    in property <string> sig-status;

    callback gen-keypair();
    callback derive-pub();
    callback enc-algo-changed(int);
    callback dec-algo-changed(int);
    callback fmt-changed(int);
    callback enc-key-edited(string);
    callback dec-key-edited(string);
    callback pub-key-edited(string);
    callback priv-key-edited(string);
    callback sig-hex-edited(string);
    callback do-encrypt();
    callback do-decrypt();
    callback send-to-decrypt();
    callback do-sign();
    callback do-verify();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    // 只允许纵向滚动：内容宽度钉在可视宽度上。不钉的话长公钥 / 双栏编辑区
    // 会把布局顶出右边界（实测右半边被裁掉），而横向滚动条对这种表单没意义。
    ScrollView {
        VerticalLayout {
            width: root.width;
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // ===== SM2 密钥对 =====
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SM2 密钥对";
                            font-family: Theme.font-ui-semibold;
                            font-size: 14px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        FerricButton {
                            text: "生成密钥对";
                            variant: "primary";
                            clicked => { root.gen-keypair(); }
                        }
                        FerricButton {
                            text: "由私钥推公钥";
                            clicked => { root.derive-pub(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.key-status;
                            font-family: Theme.font-ui;
                            font-size: 11.5px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            FieldLabel { text: "公钥"; }
                            FerricLineEdit {
                                text <=> root.pub-key;
                                placeholder: "04…";
                                mono: true;
                                edited(t) => { root.pub-key-edited(t); }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            FieldLabel { text: "私钥"; }
                            FerricLineEdit {
                                text <=> root.priv-key;
                                placeholder: "hex";
                                mono: true;
                                edited(t) => { root.priv-key-edited(t); }
                            }
                        }
                    }
                }
            }

            // ===== 加密 / 解密 =====
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "加密 / 解密";
                            font-family: Theme.font-ui-semibold;
                            font-size: 14px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        FieldLabel { text: "SM2 密文排布"; vertical-alignment: center; }
                        ComboBox {
                            model: root.fmts;
                            current-index: root.fmt-index;
                            selected(v) => { root.fmt-changed(self.current-index); }
                        }
                        FerricButton {
                            text: "把密文送去解密";
                            clicked => { root.send-to-decrypt(); }
                        }
                    }

                    // 加密在上、解密在下（对位 egui 版的两张独立卡片）。
                    // hex 密文很长，并排时每侧都不够宽。
                    VerticalLayout {
                        spacing: 14px;

                        // 加密侧
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    width: 45%;
                                    FieldLabel { text: "算法"; }
                                    ComboBox {
                                        model: root.enc-algos;
                                        current-index: root.enc-algo;
                                        selected(v) => { root.enc-algo-changed(self.current-index); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    // SM3 是摘要，没有口令可言 —— 那一栏整体隐掉，
                                    // 比留一个灰掉的空框清楚
                                    FieldLabel {
                                        text: root.enc-needs-key ? root.enc-key-label : "（SM3 摘要，无需口令）";
                                    }
                                    if root.enc-needs-key: FerricLineEdit {
                                        text <=> root.enc-key;
                                        mono: true;
                                        edited(t) => { root.enc-key-edited(t); }
                                    }
                                }
                            }
                            EditorPane {
                                title: "输入";
                                which: "gm-enc-in";
                                state: root.enc-in;
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-fold(w, r) => { root.editor-fold(w, r); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                FerricButton {
                                    text: "加密 / 摘要";
                                    variant: "primary";
                                    clicked => { root.do-encrypt(); }
                                }
                                Text {
                                    text: root.enc-status;
                                    font-family: Theme.font-ui;
                                    font-size: 11.5px;
                                    color: root.enc-ok ? Theme.muted : Theme.danger;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            EditorPane {
                                title: "输出 (hex)";
                                which: "gm-enc-out";
                                state: root.enc-out;
                                read-only: true;
                                hint: "只读";
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-fold(w, r) => { root.editor-fold(w, r); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        // 解密侧
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    width: 45%;
                                    FieldLabel { text: "算法"; }
                                    ComboBox {
                                        model: root.dec-algos;
                                        current-index: root.dec-algo;
                                        selected(v) => { root.dec-algo-changed(self.current-index); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    FieldLabel { text: root.dec-key-label; }
                                    FerricLineEdit {
                                        text <=> root.dec-key;
                                        mono: true;
                                        edited(t) => { root.dec-key-edited(t); }
                                    }
                                }
                            }
                            EditorPane {
                                title: "密文 (hex)";
                                which: "gm-dec-in";
                                state: root.dec-in;
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-fold(w, r) => { root.editor-fold(w, r); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                FerricButton {
                                    text: "解密";
                                    variant: "primary";
                                    clicked => { root.do-decrypt(); }
                                }
                                Text {
                                    text: root.dec-status;
                                    font-family: Theme.font-ui;
                                    font-size: 11.5px;
                                    color: root.dec-ok ? Theme.muted : Theme.danger;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            EditorPane {
                                title: "明文";
                                which: "gm-dec-out";
                                state: root.dec-out;
                                read-only: true;
                                hint: "只读";
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-fold(w, r) => { root.editor-fold(w, r); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                        }
                    }
                }
            }

            // ===== 签名 / 验签 =====
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SM2 签名 / 验签";
                            font-family: Theme.font-ui-semibold;
                            font-size: 14px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        FerricButton {
                            text: "签名（用私钥）";
                            variant: "primary";
                            clicked => { root.do-sign(); }
                        }
                        FerricButton {
                            text: "验签（用公钥）";
                            clicked => { root.do-verify(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.sig-status;
                            font-family: Theme.font-ui-medium;
                            font-size: 12px;
                            color: root.sig-ok ? Theme.ok : Theme.danger;
                            vertical-alignment: center;
                        }
                    }
                    EditorPane {
                        title: "待签名 / 待验签文本";
                        which: "gm-sig-in";
                        state: root.sig-state;
                        height: 130px;
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-fold(w, r) => { root.editor-fold(w, r); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: "签名 (hex)"; }
                        FerricLineEdit {
                            text <=> root.sig-hex;
                            placeholder: "签名结果，也可粘入他人的签名做验签";
                            mono: true;
                            edited(t) => { root.sig-hex-edited(t); }
                        }
                    }
                }
            }
        }
    }
}

// ——— 时间戳 ———
component TimestampView inherits Rectangle {
    in property <string> now-text;
    in property <string> now-ms-text;
    in property <bool> running;
    in property <string> offset;
    in property <string> tz-label;
    in-out property <string> tz-filter;
    in property <[TzRow]> tz-hits;
    // 下拉开着没有。默认关 —— 597 行列表平时不该占着半屏。
    in-out property <bool> tz-open: false;
    in-out property <string> ts-input;
    in property <string> ts-output;
    in property <bool> ts-ok: true;
    in-out property <string> date-input;
    in property <string> date-output;
    in property <bool> date-ok: true;

    callback toggle-running();
    callback refresh-now();
    callback use-now();
    callback copy-now();
    callback filter-edited(string);
    callback select-tz(string);
    callback ts-edited(string);
    callback date-edited(string);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // ===== 当前时间戳 =====
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    FieldLabel { text: "当前 Unix 时间戳"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.offset;
                        font-family: Theme.font-mono;
                        font-size: 11.5px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                    Segmented {
                        options: ["实时刷新", "手动"];
                        current: root.running ? 0 : 1;
                        changed(i) => { root.toggle-running(); }
                    }
                    if !root.running: FerricButton {
                        text: "刷新";
                        clicked => { root.refresh-now(); }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: root.now-text;
                        font-family: Theme.font-mono-medium;
                        font-size: 22px;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.now-ms-text;
                        font-family: Theme.font-mono;
                        font-size: 13px;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    FerricButton {
                        text: "填入下方";
                        clicked => { root.use-now(); }
                    }
                    FerricButton {
                        text: "复制";
                        variant: "subtle";
                        clicked => { root.copy-now(); }
                    }
                }
            }
        }

        // 三块自上而下：当前时间戳 → 两个换算卡 → 时区面板（对位 egui 版
        // 的三张全宽卡上下堆叠）。时区以前常驻右侧 40%，把换算卡挤成窄条 ——
        // 那是「整页变左右布局」最直接的一处。
        VerticalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 12px;

                Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        FieldLabel { text: "时间戳 → 日期时间（秒 / 毫秒自动识别）"; }
                        FerricLineEdit {
                            text <=> root.ts-input;
                            placeholder: "1700000000 或 1700000000000";
                            mono: true;
                            edited(t) => { root.ts-edited(t); }
                        }
                        Text {
                            text: root.ts-output;
                            font-family: Theme.font-mono-medium;
                            font-size: 13px;
                            color: root.ts-ok ? Theme.accent-strong : Theme.danger;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        FieldLabel { text: "日期时间 → 时间戳"; }
                        FerricLineEdit {
                            text <=> root.date-input;
                            placeholder: "2023-11-14 22:13:20";
                            mono: true;
                            edited(t) => { root.date-edited(t); }
                        }
                        Text {
                            text: root.date-output;
                            font-family: Theme.font-mono-medium;
                            font-size: 13px;
                            color: root.date-ok ? Theme.accent-strong : Theme.danger;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // ===== 目标时区（下拉筛选选择）=====
            //
            // 以前是「搜索框 + 常驻 597 行列表」，占掉整个下半屏，而且那 597 行
            // 一直挂在布局里。现在收成一个 select：点开才有列表，筛选框钉在顶部。
            Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    FieldLabel { text: "目标时区"; }
                    tzfield := Rectangle {
                        height: 38px;
                        border-radius: 9px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: root.tz-open ? Theme.accent : Theme.field-bd;

                        Text {
                            x: 12px;
                            width: parent.width - 44px;
                            height: 100%;
                            text: root.tz-label;
                            font-family: Theme.font-mono-medium;
                            font-size: 13px;
                            color: Theme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: parent.width - 28px;
                            width: 16px;
                            height: 100%;
                            text: Icons.chevron-down;
                            font-family: Theme.font-icons;
                            font-size: 15px;
                            color: Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.tz-open = !root.tz-open; }
                        }
                    }
                }
            }

            // 下面留白：三张卡靠上，别被拉成半屏高的空卡片。
            Rectangle { vertical-stretch: 1; }
        }
    }

    // 下拉浮层。声明在布局**之后** = 画在它上面（Slint 里同一父级按声明顺序绘制）。
    // 不用 PopupWindow：那东西会抢输入，筛选框在里面拿不到键盘。
    //
    // 时区这张卡在最下面，下方经常放不下 300px —— 放不下就朝上开
    //（真 select 的做法；否则列表被窗口底边裁成两三行，等于不能用）。
    property <length> tz-field-y: tzfield.absolute-position.y - root.absolute-position.y;
    property <length> tz-room-below: root.height - root.tz-field-y - tzfield.height - 12px;
    property <bool> tz-up: root.tz-room-below < 220px;
    property <length> tz-panel-h: root.tz-up
        ? min(300px, max(root.tz-field-y - 12px, 120px))
        : min(300px, root.tz-room-below);

    if root.tz-open: Rectangle {
        width: 100%;
        height: 100%;

        // 点浮层外面收起
        TouchArea {
            clicked => { root.tz-open = false; }
        }

        Rectangle {
            x: tzfield.absolute-position.x - root.absolute-position.x;
            y: root.tz-up
                ? root.tz-field-y - root.tz-panel-h - 4px
                : root.tz-field-y + tzfield.height + 4px;
            width: tzfield.width;
            height: root.tz-panel-h;
            background: Theme.bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-2;
            clip: true;

            // 吞掉浮层内的点击，否则会穿到上面那层「点外面收起」
            TouchArea { }

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        FerricLineEdit {
                            width: 100%;
                            height: 100%;
                            pad-left: 32px;
                            placeholder: "搜索时区（支持中文，如「上海」）";
                            text <=> root.tz-filter;
                            // 一打开就聚焦：下拉的用法就是「打开→打字→回车/点选」
                            init => { self.focus(); }
                            edited(t) => { root.filter-edited(t); }
                        }
                        Text {
                            x: 10px;
                            width: 16px;
                            height: 100%;
                            text: Icons.search;
                            font-family: Theme.font-icons;
                            font-size: 13px;
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.tz-hits.length + " / 597";
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 1px;
                        alignment: start;
                        for z in root.tz-hits: Rectangle {
                            height: 26px;
                            border-radius: 5px;
                            background: tz-ta.has-hover
                                ? Theme.border
                                : (z.label == root.tz-label ? Theme.accent-soft : transparent);
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                text: z.label;
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: z.label == root.tz-label ? Theme.accent-strong : Theme.fg-soft;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            tz-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.select-tz(z.name);
                                    root.tz-open = false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— JSON 工具 ———
component JsonView inherits Rectangle {
    // 抽屉收起时停在窗口外，必须裁掉（提示气泡画在 AppWindow 顶层，不受影响）
    clip: true;
    in property <EditorState> input-state;
    in property <int> indent-index;
    in property <bool> sort;
    in property <bool> wrap;
    in property <bool> ok: true;
    in property <string> status;
    in-out property <string> find;
    // 查找条默认不在：它平时只占地方，Ctrl+F（或工具条上的放大镜）才拉出来。
    in-out property <bool> find-open: false;
    in property <int> hit-count;
    in property <int> hit-index;
    in property <bool> can-undo;
    in property <bool> can-redo;

    // ——— 粘贴记录抽屉 ———
    in property <bool> history-open;
    in property <[HistoryRow]> history-rows;
    in-out property <string> history-query;
    // 正在改名的可见行号，-1 = 没有
    in property <int> renaming: -1;
    in property <string> history-status;

    callback do-format();
    callback do-minify();
    callback do-escape();
    callback do-unescape();
    callback toggle-sort();
    callback toggle-wrap();
    callback indent-changed(int);
    callback clear-input();
    callback copy-output();
    callback do-undo();
    callback do-redo();
    callback find-edited(string);
    callback do-search();
    callback next-hit();
    callback prev-hit();
    callback toggle-history();
    callback history-query-edited(string);
    callback restore-history(int);
    callback rename-start(int);
    callback rename-history(int, string);
    callback rename-cancel();
    callback delete-history(int);
    callback clear-history();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    // 每次 Ctrl+F 都要把焦点抓回查找框（哪怕它已经开着）。Slint 里没有
    // 「从 Rust 直接聚焦某个元素」的入口，用一个自增计数当脉冲：Rust 每按一次
    // 就 +1，这里的 changed 把焦点交给输入框。
    in property <int> focus-tick;
    changed focus-tick => {
        finder.focus();
    }

    // 收起时把焦点还给编辑区，否则接着打字会打进一个看不见的输入框。
    changed find-open => {
        if (root.find-open) {
            finder.focus();
        } else {
            pane.focus();
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // 工具条：一整排图标按钮（对位 egui 版的 toolbar_row）。
        // 刻意不用文字按钮 —— 十四个中文按钮换行成两排，且每次加一个操作
        // 都会把这一排挤到下一行。图标 + 悬停提示是原来的形态。
        HorizontalLayout {
            spacing: 2px;
            alignment: start;

            IconButton {
                icon: Icons.align-left;
                icon-size: 19px;
                tooltip: "格式化 / 美化";
                clicked => { root.do-format(); }
            }
            IconButton {
                icon: Icons.fold-vertical;
                icon-size: 19px;
                tooltip: "压缩为单行";
                clicked => { root.do-minify(); }
            }
            IconButton {
                icon: Icons.quote;
                icon-size: 19px;
                tooltip: "转义为 JSON 字符串";
                clicked => { root.do-escape(); }
            }
            IconButton {
                icon: Icons.code;
                icon-size: 19px;
                tooltip: "去除转义（多层一次剥完）";
                clicked => { root.do-unescape(); }
            }

            VDivider {}

            IconButton {
                icon: Icons.undo-2;
                icon-size: 19px;
                enabled: root.can-undo;
                tooltip: "撤销（Ctrl+Z）";
                clicked => { root.do-undo(); }
            }
            IconButton {
                icon: Icons.redo-2;
                icon-size: 19px;
                enabled: root.can-redo;
                tooltip: "重做（Ctrl+Y）";
                clicked => { root.do-redo(); }
            }

            VDivider {}

            // 缩进档位：2 / 4 / Tab。数字用 label（Lucide 里没有数字字形）。
            IconButton {
                label: "2";
                icon-size: 19px;
                active: root.indent-index == 0;
                tooltip: "缩进 2 空格（下次格式化生效）";
                clicked => { root.indent-changed(0); }
            }
            IconButton {
                label: "4";
                icon-size: 19px;
                active: root.indent-index == 1;
                tooltip: "缩进 4 空格（下次格式化生效）";
                clicked => { root.indent-changed(1); }
            }
            IconButton {
                icon: Icons.indent-increase;
                icon-size: 19px;
                active: root.indent-index == 2;
                tooltip: "Tab 缩进（下次格式化生效）";
                clicked => { root.indent-changed(2); }
            }
            IconButton {
                icon: Icons.arrow-up-a-z;
                icon-size: 19px;
                active: root.sort;
                tooltip: root.sort ? "键名排序：开" : "键名排序：关";
                clicked => { root.toggle-sort(); }
            }
            IconButton {
                icon: Icons.wrap-text;
                icon-size: 19px;
                active: root.wrap;
                tooltip: root.wrap
                    ? "自动换行：开"
                    : "自动换行：关（长行用横向滚动看）";
                clicked => { root.toggle-wrap(); }
            }

            VDivider {}

            IconButton {
                icon: Icons.search;
                icon-size: 19px;
                active: root.find-open;
                tooltip: "查找（Ctrl+F）";
                clicked => { root.find-open = !root.find-open; }
            }
            IconButton {
                icon: Icons.copy;
                icon-size: 19px;
                tooltip: "复制全文";
                clicked => { root.copy-output(); }
            }
            IconButton {
                icon: Icons.trash;
                icon-size: 19px;
                tooltip: "清空输入";
                clicked => { root.clear-input(); }
            }
            // 粘贴记录：往输入区粘东西时自动存一条（一条 = 数据目录里一个文件）
            IconButton {
                icon: Icons.list-checks;
                icon-size: 19px;
                active: root.history-open;
                tooltip: "粘贴记录（自动保存，右侧抽屉）";
                clicked => { root.toggle-history(); }
            }

            Rectangle { horizontal-stretch: 1; min-width: 12px; }

            // 实时校验结果。工具条右端而不是单独一行：那一行只有这一句话。
            HorizontalLayout {
                spacing: 5px;
                Text {
                    text: root.ok ? Icons.circle-check : Icons.circle-alert;
                    font-family: Theme.font-icons;
                    font-size: 13px;
                    color: root.ok ? Theme.ok : Theme.danger;
                    vertical-alignment: center;
                }
                Text {
                    text: root.status;
                    font-family: Theme.font-ui;
                    font-size: 12px;
                    color: root.ok ? Theme.muted : Theme.danger;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        pane := EditorPane {
            title: "JSON";
            which: "json-in";
            state: root.input-state;
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-fold(w, r) => { root.editor-fold(w, r); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }
    }

    // ===== 查找条：浮在编辑区右上角的一颗药丸 =====
    //
    // 原来是通栏一行：一个铺满整宽的输入框（搜三个字符也占 960px），
    // 计数与三个按钮松散地飘在右边，开合时还把编辑区整块往下推。
    // 改成一整块 400px 的浮层，输入 / 计数 / 上一处 / 下一处 / 关闭都在同一个
    // 圆角容器里，开合不再挤动布局（各家编辑器的查找框都是这么浮着的）。
    //
    // 仍然**始终实例化**：放进 `if` 里的元素拿不到 id，而 `finder.focus()`
    // 是 Ctrl+F 的全部意义。收起时 visible:false + 两个交互区禁用。
    Rectangle {
        x: parent.width - self.width - 26px;
        y: 92px;
        width: 400px;
        height: 40px;
        visible: root.find-open;
        border-radius: 10px;
        background: Theme.bg;
        border-width: 1px;
        border-color: finder.focused ? Theme.accent : Theme.border-2;
        drop-shadow-blur: 12px;
        drop-shadow-color: rgba(0, 0, 0, 0.16);
        drop-shadow-offset-y: 2px;

        // 吞掉点击：浮层底下就是正文，漏过去会把光标挪到别处
        TouchArea { enabled: root.find-open; }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 5px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 4px;

            Text {
                text: Icons.search;
                font-family: Theme.font-icons;
                font-size: 13px;
                color: Theme.faint;
                vertical-alignment: center;
            }
            finder := FerricLineEdit {
                horizontal-stretch: 1;
                height: 30px;
                flat: true;
                pad-left: 6px;
                text <=> root.find;
                placeholder: "查找…";
                mono: true;
                edited(t) => { root.find-edited(t); }
                // Enter 实际是 Rust 的按键钩子接的（单行 TextInput 会把回车
                // 吃掉，`accepted` 收不到）；这里保留是为了不依赖那个绕行。
                accepted(t) => { root.next-hit(); }
            }
            // 计数贴在输入框右边，而不是飘在中间；没命中时直接说「无匹配」
            Text {
                text: root.find == ""
                    ? ""
                    : (root.hit-count > 0
                        ? (root.hit-index + 1) + "/" + root.hit-count
                        : "无匹配");
                font-family: Theme.font-mono;
                font-size: 11px;
                color: root.find != "" && root.hit-count == 0 ? Theme.danger : Theme.faint;
                vertical-alignment: center;
                horizontal-alignment: right;
                min-width: 46px;
            }
            IconButton {
                icon: Icons.chevron-left;
                icon-size: 15px;
                // 刻意不按命中数置灰：第一次点它就是「去搜」的入口
                //（Rust 侧 next_hit/prev_hit 没有命中时会先跑一次搜索）。
                tooltip: "上一处（Shift+Enter）";
                clicked => { root.prev-hit(); }
            }
            IconButton {
                icon: Icons.chevron-right;
                icon-size: 15px;
                tooltip: "下一处（Enter）";
                clicked => { root.next-hit(); }
            }
            IconButton {
                icon: Icons.x;
                icon-size: 13px;
                tooltip: "关闭（Esc）";
                clicked => { root.find-open = false; }
            }
        }
    }

    // ===== 粘贴记录抽屉（从右侧滑出）=====
    //
    // 始终实例化、靠 x 动画滑进滑出：放进 `if` 里的元素一创建就在终点位置，
    // 动画无从发生（与查找条那条经验同源）。收起时整块停在窗口外由 root 的
    // clip 裁掉，两个 TouchArea 一并禁用 —— 否则一层看不见的遮罩会吃掉
    // 编辑区的点击。
    Rectangle {
        width: 100%;
        height: 100%;
        background: root.history-open ? rgba(0, 0, 0, 0.28) : transparent;
        animate background { duration: 160ms; }

        // 点抽屉外面收起
        TouchArea {
            enabled: root.history-open;
            clicked => { root.toggle-history(); }
        }

        Rectangle {
            width: min(460px, parent.width - 60px);
            height: 100%;
            x: root.history-open ? parent.width - self.width : parent.width;
            animate x { duration: 170ms; easing: ease-out; }
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.border;

            // 吞掉点击，别穿到背后的「点外面收起」
            TouchArea { enabled: root.history-open; }

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "粘贴记录";
                        font-family: Theme.font-ui-semibold;
                        font-size: 15px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: Icons.trash;
                        icon-size: 15px;
                        danger: true;
                        enabled: root.history-rows.length > 0;
                        tooltip: "清空全部记录";
                        clicked => { root.clear-history(); }
                    }
                    IconButton {
                        icon: Icons.x;
                        icon-size: 15px;
                        tooltip: "收起";
                        clicked => { root.toggle-history(); }
                    }
                }

                // 按名称查询
                Rectangle {
                    height: 36px;
                    FerricLineEdit {
                        width: 100%;
                        height: 100%;
                        pad-left: 32px;
                        text <=> root.history-query;
                        placeholder: "按名称搜索…";
                        edited(t) => { root.history-query-edited(t); }
                    }
                    Text {
                        x: 11px;
                        width: 16px;
                        height: 100%;
                        text: Icons.search;
                        font-family: Theme.font-icons;
                        font-size: 13px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.history-status;
                    font-family: Theme.font-ui;
                    font-size: 11.5px;
                    color: Theme.faint;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.code-bg;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    if root.history-rows.length == 0: Text {
                        width: 100%;
                        height: 100%;
                        text: root.history-query != ""
                            ? "没有名字含「" + root.history-query + "」的记录"
                            : "还没有记录";
                        font-family: Theme.font-ui;
                        font-size: 12.5px;
                        color: Theme.faint;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 8px;
                            alignment: start;

                            for row[i] in root.history-rows: card := Rectangle {
                                // 改名输入框的当前值。放在这一行自己身上：
                                // `for` 的每个实例各有一份，不会互相串。
                                property <string> draft: row.name;
                                background: Theme.bg;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: root.renaming == i ? Theme.accent : Theme.border;
                                height: 104px;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 6px;

                                    // 名字行（或改名输入）
                                    HorizontalLayout {
                                        spacing: 6px;
                                        if root.renaming != i: Text {
                                            text: row.name;
                                            font-family: Theme.font-ui-semibold;
                                            font-size: 12.5px;
                                            color: Theme.fg;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        if root.renaming != i: Text {
                                            text: row.when + " · " + row.size;
                                            font-family: Theme.font-mono;
                                            font-size: 10.5px;
                                            color: Theme.faint;
                                            vertical-alignment: center;
                                        }
                                        if root.renaming == i: FerricLineEdit {
                                            height: 30px;
                                            horizontal-stretch: 1;
                                            text: row.name;
                                            placeholder: "起个名字（就是文件名）";
                                            edited(t) => { card.draft = t; }
                                            accepted(t) => { root.rename-history(i, t); }
                                        }
                                        if root.renaming == i: IconButton {
                                            icon: Icons.circle-check;
                                            icon-size: 15px;
                                            tooltip: "保存名字";
                                            clicked => { root.rename-history(i, card.draft); }
                                        }
                                        if root.renaming == i: IconButton {
                                            icon: Icons.x;
                                            icon-size: 15px;
                                            tooltip: "取消";
                                            clicked => { root.rename-cancel(); }
                                        }
                                    }

                                    Text {
                                        text: row.preview;
                                        font-family: Theme.font-mono;
                                        font-size: 11px;
                                        color: Theme.muted;
                                        vertical-stretch: 1;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        FerricButton {
                                            text: "恢复到输入区";
                                            height: 28px;
                                            clicked => { root.restore-history(i); }
                                        }
                                        FerricButton {
                                            text: "改名";
                                            variant: "subtle";
                                            height: 28px;
                                            clicked => { root.rename-start(i); }
                                        }
                                        FerricButton {
                                            text: "删除";
                                            variant: "subtle";
                                            height: 28px;
                                            clicked => { root.delete-history(i); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— 文本 / 文件对比 ———
component DiffView inherits Rectangle {
    in property <EditorState> left-state;
    in property <EditorState> right-state;
    in property <string> status;
    in property <bool> has-diff: false;

    callback do-compare();
    callback do-swap();
    callback clear-input();
    callback copy-result();
    callback next-hunk();
    callback prev-hunk();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // 工具条
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "对比";
                variant: "primary";
                clicked => { root.do-compare(); }
            }
            FerricButton {
                text: "左右互换";
                clicked => { root.do-swap(); }
            }

            VDivider {}

            // 跳 hunk 取代了从前那份「只看差异」的清单：差异现在就画在原文上，
            // 需要的是「带我去下一处」，而不是把上下文摘掉。
            IconButton {
                icon: Icons.chevron-up;
                icon-size: 18px;
                enabled: root.has-diff;
                tooltip: "上一处差异";
                clicked => { root.prev-hunk(); }
            }
            IconButton {
                icon: Icons.chevron-down;
                icon-size: 18px;
                enabled: root.has-diff;
                tooltip: "下一处差异";
                clicked => { root.next-hunk(); }
            }

            Rectangle { horizontal-stretch: 1; min-width: 12px; }

            Text {
                text: root.status;
                font-family: Theme.font-mono;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }
            IconButton {
                icon: Icons.copy;
                icon-size: 19px;
                tooltip: "复制统一 diff 文本";
                clicked => { root.copy-result(); }
            }
            IconButton {
                icon: Icons.trash;
                icon-size: 19px;
                tooltip: "清空两侧";
                clicked => { root.clear-input(); }
            }
        }

        // 左右并排，差异直接画在原文上：删除行偏红、新增行偏绿、
        // 改动的字加深底色，行号槽跟 `-` / `+`。滚一侧另一侧跟着对位。
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            EditorPane {
                title: "左侧（原文）";
                which: "diff-left-in";
                state: root.left-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
            EditorPane {
                title: "右侧（新文）";
                which: "diff-right-in";
                state: root.right-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

// 卡片上的状态徽标。内层布局撑宽 + 固定 18px 高 —— 与侧栏那颗更新胶囊
// 同一个做法：放进 HorizontalLayout 时不会被拉成整行高。
component MarketBadge inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <color> tint;
    in property <brush> fill;

    height: 18px;
    horizontal-stretch: 0;
    border-radius: 9px;
    background: root.fill;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 7px;
        spacing: 3px;
        if root.icon != "": Text {
            text: root.icon;
            font-family: Theme.font-icons;
            font-size: 10px;
            color: root.tint;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-family: Theme.font-ui-medium;
            font-size: 10.5px;
            color: root.tint;
            vertical-alignment: center;
        }
    }
}

// 卡片右侧的操作组：主操作与「卸载」合成一颗药丸（split button）。
//
// 分开摆时两个控件的高度来源不一样：`FerricButton` 自己写死 38px，
// `IconButton` 只声明 min-height，进了 HorizontalLayout 就被拉到整行高、
// 字形再在那一整块里居中 —— 两者的中线差了十几像素，看着就是「没在一行」。
// 合进同一个容器后两段共用一个高度与一条基线，不可能再错位；
// 顺带把「卸载」写成文字，图标按钮那种「不知道点了会发生什么」也一并省掉。
component MarketActions inherits Rectangle {
    in property <string> text;
    // 主操作用主色（只有「更新」用）
    in property <bool> primary;
    in property <bool> enabled: true;
    // 是否带「卸载」那一段
    in property <bool> removable;
    callback act();
    callback remove();

    height: 34px;
    horizontal-stretch: 0;
    min-width: row.min-width;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.border-2;
    // 底色始终是中性的：主色只涂主操作那一段。整颗药丸都涂绿的话，
    // 「卸载」就变成绿底上的灰字（实测几乎读不出来），而且每一行的
    // 「卸载」看起来还不一样。
    background: Theme.code-bg;
    // `clip` 只按矩形裁，不管圆角（实测 hover 的红底会在两个右角戳出直角），
    // 所以两段各自把外侧的两个角圆掉：外圈 9px 减去 1px 边 = 8px。

    property <color> main-fg: !root.enabled
        ? Theme.faint
        : (root.primary ? #ffffff : Theme.fg-soft);

    row := HorizontalLayout {
        spacing: 0px;

        Rectangle {
            min-width: main-label.min-width + 28px;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            // 只有一段时右边也得圆
            border-top-right-radius: root.removable ? 0px : 8px;
            border-bottom-right-radius: root.removable ? 0px : 8px;
            background: !root.enabled
                ? transparent
                : (root.primary
                    ? (main-ta.has-hover ? Theme.accent-strong : Theme.accent)
                    : (main-ta.has-hover ? Theme.border-2 : transparent));
            main-label := Text {
                text: root.text;
                font-family: Theme.font-ui-medium;
                font-size: 13px;
                color: root.main-fg;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
            }
            main-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.act(); }
            }
        }

        if root.removable: Rectangle {
            width: 1px;
            background: Theme.border-2;
        }
        if root.removable: Rectangle {
            min-width: rm-label.min-width + 22px;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
            // 卸载是不可逆的，hover 直接整段变红 + 文字反白，
            // 与关闭按钮同一套语言（误点的代价最大的那个键要长得不一样）。
            background: rm-ta.has-hover ? Theme.danger : transparent;
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                spacing: 4px;
                alignment: center;
                Text {
                    text: Icons.trash;
                    font-family: Theme.font-icons;
                    font-size: 13px;
                    color: rm-ta.has-hover ? #ffffff : Theme.muted;
                    vertical-alignment: center;
                }
                rm-label := Text {
                    text: "卸载";
                    font-family: Theme.font-ui-medium;
                    font-size: 13px;
                    color: rm-ta.has-hover ? #ffffff : Theme.muted;
                    vertical-alignment: center;
                }
            }
            rm-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.remove(); }
            }
        }
    }
}

// ——— 插件市场 ———
//
// 三段：搜索 / 操作 → 标签过滤 + 状态 → 卡片列表。
// 过滤（标签 + 搜索）全在 Rust 侧算完（`MarketTool::visible`），
// 这里拿到的 `cards` 就是要画的那些 —— 界面不做筛选逻辑。
component MarketView inherits Rectangle {
    in-out property <string> query;
    in property <[PluginCard]> cards;
    in property <bool> loading;
    in property <bool> ok: true;
    in property <string> status;
    in property <int> progress-pct;
    in property <bool> installing;
    in property <int> pending-updates;
    // 0 全部 / 1 已安装
    in property <int> tab;
    in property <int> count-all;
    in property <int> count-installed;

    callback query-edited(string);
    callback do-refresh();
    callback do-install(string);
    callback do-uninstall(string);
    callback do-update-all();
    callback tab-changed(int);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ——— 搜索 + 操作 ———
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                horizontal-stretch: 1;
                height: 38px;
                FerricLineEdit {
                    width: 100%;
                    height: 100%;
                    pad-left: 34px;
                    text <=> root.query;
                    placeholder: "搜索插件（名称 / 简介；回车向服务端重查）";
                    // 打字即时过滤已拉到的列表，回车才发请求：每敲一个字都
                    // 等一趟网络往返的话，搜索框会一直「慢半拍」。
                    edited(t) => { root.query-edited(t); }
                    accepted(t) => { root.do-refresh(); }
                }
                Text {
                    x: 12px;
                    width: 16px;
                    height: 100%;
                    text: Icons.search;
                    font-family: Theme.font-icons;
                    font-size: 14px;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                // 清空：搜索词自己就是个过滤器，得有一键退出的办法
                if root.query != "": IconButton {
                    x: parent.width - 32px;
                    y: 6px;
                    width: 26px;
                    height: 26px;
                    icon: Icons.x;
                    icon-size: 13px;
                    tooltip: "清空搜索";
                    clicked => {
                        root.query = "";
                        root.query-edited("");
                    }
                }
            }
            FerricButton {
                text: root.loading ? "获取中…" : "刷新";
                icon: Icons.refresh;
                enabled: !root.loading;
                clicked => { root.do-refresh(); }
            }
            FerricButton {
                text: root.pending-updates > 0
                    ? "全部更新（" + root.pending-updates + "）"
                    : "全部更新";
                variant: "primary";
                enabled: root.pending-updates > 0 && !root.installing;
                clicked => { root.do-update-all(); }
            }
        }

        // ——— 标签过滤 + 状态 + 安装进度 ———
        HorizontalLayout {
            spacing: 8px;

            FilterTag {
                text: "全部";
                count: root.count-all;
                active: root.tab == 0;
                clicked => { root.tab-changed(0); }
            }
            FilterTag {
                text: "已安装";
                count: root.count-installed;
                active: root.tab == 1;
                clicked => { root.tab-changed(1); }
            }

            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.installing: Rectangle {
                width: 140px;
                height: 6px;
                y: (parent.height - 6px) / 2;
                border-radius: 3px;
                background: Theme.border;
                Rectangle {
                    x: 0;
                    width: parent.width * (root.progress-pct / 100);
                    height: parent.height;
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            if root.installing: Text {
                text: root.progress-pct + "%";
                font-family: Theme.font-mono-medium;
                font-size: 11px;
                color: Theme.accent-strong;
                vertical-alignment: center;
            }
        }

        // ——— 卡片列表 ———
        Rectangle {
            background: Theme.code-bg;
            border-radius: 9px;
            border-width: 1px;
            border-color: Theme.border;
            vertical-stretch: 1;
            clip: true;

            // 空列表要说清「为什么空」：没搜到 / 这个标签下没有 / 真的没有。
            // 一句干巴巴的「没有插件」会让人以为源坏了。
            if root.cards.length == 0: VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.loading ? Icons.refresh : Icons.box;
                    font-family: Theme.font-icons;
                    font-size: 26px;
                    color: Theme.faint;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.loading
                        ? "正在获取插件列表…"
                        : (root.query != ""
                            ? "没有匹配「" + root.query + "」的插件"
                            : (root.tab == 1 ? "还没有安装任何插件" : "这个源里没有插件"));
                    font-family: Theme.font-ui-medium;
                    font-size: 13px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
                if !root.loading && (root.tab == 1 || root.query != ""): Text {
                    text: root.tab == 1 && root.query == ""
                        ? "切到「全部」挑一个装上"
                        : "换个关键词，或按回车向服务端重查";
                    font-family: Theme.font-ui;
                    font-size: 11.5px;
                    color: Theme.faint;
                    horizontal-alignment: center;
                }
            }

            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: start;
                    for c in root.cards: Rectangle {
                        background: Theme.bg;
                        border-radius: 10px;
                        border-width: 1px;
                        // 正在装的那张卡自己描边：进度条在页顶，列表长了就看不见
                        // 到底在装哪一个。
                        border-color: c.busy ? Theme.accent : Theme.border;
                        height: 86px;
                        clip: true;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            // 图标方块：每张卡有个视觉锚点，已装的填强调色
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 42px;
                                    height: 42px;
                                    border-radius: 11px;
                                    background: c.is-installed ? Theme.accent-soft : Theme.code-bg;
                                    Text {
                                        text: Icons.box;
                                        font-family: Theme.font-icons;
                                        font-size: 19px;
                                        color: c.is-installed ? Theme.accent-strong : Theme.faint;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: c.name;
                                        font-family: Theme.font-ui-semibold;
                                        font-size: 13.5px;
                                        color: Theme.fg;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "v" + c.version;
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.faint;
                                        vertical-alignment: center;
                                    }
                                    // 状态徽标按优先级只出一个：装着 > 排队 >
                                    // 有更新 > 已安装。四个一起挂会把标题挤没。
                                    if c.busy: MarketBadge {
                                        text: root.progress-pct + "%";
                                        icon: Icons.file-down;
                                        tint: #ffffff;
                                        fill: Theme.accent;
                                    }
                                    if !c.busy && c.queued: MarketBadge {
                                        text: "排队中";
                                        tint: Theme.muted;
                                        fill: Theme.code-bg;
                                    }
                                    // 「可更新」是要人动手的，用强调色；「已安装」
                                    // 是静态事实，只给一个灰底绿勾 —— 两个都填
                                    // accent-soft 的话根本分不出哪个要处理。
                                    if !c.busy && !c.queued && c.has-update: MarketBadge {
                                        text: "可更新 · 已装 v" + c.installed;
                                        icon: Icons.file-down;
                                        tint: Theme.accent-strong;
                                        fill: Theme.accent-soft;
                                    }
                                    if !c.busy && !c.queued && c.is-installed && !c.has-update: MarketBadge {
                                        text: "已安装";
                                        icon: Icons.circle-check;
                                        tint: Theme.ok;
                                        fill: Theme.border;
                                    }
                                }
                                Text {
                                    text: c.desc;
                                    font-family: Theme.font-ui;
                                    font-size: 12px;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                                Text {
                                    text: c.size-text + " · " + c.downloads-text;
                                    font-family: Theme.font-mono;
                                    font-size: 10.5px;
                                    color: Theme.faint;
                                }
                            }

                            // 操作组：竖向自己居中（外层是横向布局，不给个
                            // VerticalLayout 的话这一段会被拉到整行高）
                            VerticalLayout {
                                alignment: center;
                                MarketActions {
                                    text: c.busy
                                        ? "安装中…"
                                        : (c.has-update ? "更新" : (c.is-installed ? "重装" : "安装"));
                                    // 只有「更新」用主色：一屏五张卡全是绿按钮时，
                                    // 真正需要动手的那一张就淹了。
                                    primary: c.has-update;
                                    enabled: !c.busy && !c.queued;
                                    removable: c.is-installed;
                                    act => { root.do-install(c.slug); }
                                    remove => { root.do-uninstall(c.slug); }
                                }
                            }
                        }

                        // 装到哪儿了：贴在卡片下沿的一条细进度
                        if c.busy: Rectangle {
                            x: 0;
                            y: parent.height - 3px;
                            width: parent.width * (root.progress-pct / 100);
                            height: 3px;
                            background: Theme.accent;
                        }
                    }
                }
            }
        }
    }
}

// ——— WASM 插件的通用视图（按 manifest 渲染控件） ———
//
// 插件 ABI 是「JSON 进、JSON 出」，选项由 manifest 声明。这里按声明的三种
// 形态（分段 / 开关 / 文本）各画一段，插件本身不需要知道界面长什么样。
component PluginView inherits Rectangle {
    in property <[PluginOption]> options;
    in property <EditorState> input-state;
    in property <EditorState> output-state;
    in property <bool> ok: true;
    in property <string> status;

    callback option-changed(int, int, string);
    callback do-run();
    callback copy-output();
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // manifest 声明的选项
        if root.options.length > 0: Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                for opt[i] in root.options: HorizontalLayout {
                    spacing: 10px;
                    height: 38px;
                    FieldLabel {
                        text: opt.label;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    // 分段单选
                    if opt.kind == 0: Segmented {
                        options: opt.values;
                        current: opt.selected;
                        changed(n) => { root.option-changed(i, n, ""); }
                    }
                    // 开关
                    if opt.kind == 1: Segmented {
                        options: ["开", "关"];
                        current: opt.on ? 0 : 1;
                        changed(n) => { root.option-changed(i, n == 0 ? 1 : 0, ""); }
                    }
                    // 单行文本
                    if opt.kind == 2: FerricLineEdit {
                        horizontal-stretch: 1;
                        text: opt.text;
                        placeholder: opt.hint;
                        edited(t) => { root.option-changed(i, 0, t); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            FerricButton {
                text: "运行";
                variant: "primary";
                clicked => { root.do-run(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
                overflow: elide;
            }
            FerricButton {
                text: "复制输出";
                variant: "subtle";
                clicked => { root.copy-output(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            EditorPane {
                title: "输入";
                which: "plugin-in";
                state: root.input-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
            EditorPane {
                title: "输出";
                which: "plugin-out";
                state: root.output-state;
                read-only: true;
                hint: "只读";
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-fold(w, r) => { root.editor-fold(w, r); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

// 侧栏分组标题（图标 + 组名，安静的小字）。
component RailGroup inherits Rectangle {
    in property <string> label;
    in property <string> icon;

    height: 26px;
    HorizontalLayout {
        padding-left: 10px;
        spacing: 6px;
        Text {
            text: root.icon;
            font-family: Theme.font-icons;
            font-size: 12px;
            color: Theme.faint;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-family: Theme.font-ui-semibold;
            font-size: 11px;
            color: Theme.faint;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component SidebarRow inherits Rectangle {
    in property <RailRow> entry;
    in property <bool> active;
    callback selected();
    callback toggle-favorite();

    height: 38px;
    border-radius: 9px;
    background: active
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.border : transparent);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 10px;

        Text {
            text: root.entry.icon;
            font-family: Theme.font-icons;
            font-size: 17px;
            color: root.active ? Theme.accent-strong : Theme.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.entry.label;
                // 选中态换字重 + 主色（对位 egui 版：选中项是绿色加粗，
                // 只换颜色的话在长列表里不够跳）。
                font-family: root.active ? Theme.font-ui-semibold : Theme.font-ui-medium;
                font-size: 13.5px;
                color: root.active ? Theme.accent-strong : Theme.fg-soft;
                overflow: elide;
            }
        }
        // 收藏：hover 或已收藏时才占位。图标走 Lucide 码点 ——
        // 「★ / ☆」这类字符内嵌字体里没有，画出来是空白。
        if ta.has-hover || root.entry.favorite: IconButton {
            icon: Icons.heart;
            icon-size: 13px;
            active: root.entry.favorite;
            clicked => { root.toggle-favorite(); }
        }
    }

    ta := TouchArea {
        clicked => { root.selected(); }
    }
}

// ——— UUID 生成器 ———
component UuidView inherits Rectangle {
    // 输入侧（双向：Rust 灌初值，UI 改了回写）
    in-out property <int> kind-index: 0;
    in-out property <int> count: 10;
    in-out property <int> namespace-index: 0;
    in-out property <string> custom-ns;
    in-out property <string> name-input: "example.com";
    in-out property <bool> upper: false;
    in-out property <bool> nohyphen: false;
    in-out property <bool> as-json: false;
    in-out property <int> hist-keep-index: 0;

    // 输出侧（只读编辑区：可以用鼠标拖选、双击选整行、Ctrl+C）
    in property <EditorState> out;
    in property <bool> ok: true;
    in property <string> status: "就绪";
    in property <[UuidHistEntry]> history;

    // v5 才需要命名空间 + name
    property <bool> needs-namespace: root.kind-index == 2;

    callback regenerate();
    callback copy-output();
    callback restore-history(int);
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // —— 参数区 ——
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: "版本"; }
                        Segmented {
                            options: ["v4 随机", "v7 时间序", "v5 命名", "v6 时间序"];
                            current <=> root.kind-index;
                            changed(i) => { root.regenerate(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        width: 140px;
                        FieldLabel { text: "数量"; }
                        SpinBox {
                            minimum: 1;
                            maximum: 1000;
                            value <=> root.count;
                            edited(v) => { root.regenerate(); }
                        }
                    }
                }

                // v5 专属：命名空间 + name
                if root.needs-namespace: HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 6px;
                        width: 200px;
                        FieldLabel { text: "命名空间"; }
                        ComboBox {
                            model: ["DNS", "URL", "OID", "X500", "自定义"];
                            current-index <=> root.namespace-index;
                            selected(v) => { root.regenerate(); }
                        }
                    }
                    if root.namespace-index == 4: VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "自定义命名空间 UUID"; }
                        FerricLineEdit {
                            text <=> root.custom-ns;
                            placeholder: "如 6ba7b810-9dad-11d1-80b4-00c04fd430c8";
                            mono: true;
                            edited(t) => { root.regenerate(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "名称"; }
                        FerricLineEdit {
                            text <=> root.name-input;
                            placeholder: "example.com";
                            edited(t) => { root.regenerate(); }
                        }
                    }
                }

                // 输出格式开关
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;
                    CheckBox {
                        text: "大写";
                        checked <=> root.upper;
                        toggled => { root.regenerate(); }
                    }
                    CheckBox {
                        text: "去连字符";
                        checked <=> root.nohyphen;
                        toggled => { root.regenerate(); }
                    }
                    CheckBox {
                        text: "JSON 数组";
                        checked <=> root.as-json;
                        toggled => { root.regenerate(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    FerricButton {
                        text: "重新生成";
                        icon: Icons.refresh;
                        variant: "primary";
                        clicked => { root.regenerate(); }
                    }
                }
            }
        }

        // —— 输出区 ——
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "输出"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.status;
                        font-family: Theme.font-ui;
                        font-size: 12px;
                        color: root.ok ? Theme.ok : Theme.danger;
                        vertical-alignment: center;
                    }
                    FerricButton {
                        text: "复制";
                        icon: Icons.copy;
                        variant: "default";
                        clicked => { root.copy-output(); }
                    }
                }

                // 只读编辑区：鼠标可以横跨若干行任意拖选、双击选整行、
                // Ctrl+A / Ctrl+C 照常。用 CodeEditor 而不是 EditorPane 是
                // 因为这张卡自己已经有「输出 / 状态 / 复制」那一行标题了。
                //
                // 中间做过一版「点一行高亮一行」——只能整行选，用户要拖着选。
                CodeEditor {
                    vertical-stretch: 1;
                    read-only: true;
                    lines: root.out.lines;
                    line-nos: root.out.line-nos;
                    first-line: root.out.first-line;
                    total-lines: root.out.total-lines;
                    fold-marks: root.out.fold-marks;
                    foldable: root.out.foldable;
                    row-kinds: root.out.row-kinds;
                    diffed: root.out.diffed;
                    emph-spans: root.out.emph-spans;
                    tokens: root.out.tokens;
                    highlighted: root.out.highlighted;
                    cursor-line: root.out.cursor-line;
                    cursor-x: root.out.cursor-x;
                    cursor-visible: root.out.cursor-visible;
                    selection-spans: root.out.selection-spans;

                    viewport-changed(r, c) => { root.editor-viewport("uuid-out", r, c); }
                    wide-ratio-changed(v) => { root.editor-wide-ratio(v); }
                    clicked(l, c, e) => { root.editor-click("uuid-out", l, c, e); }
                    dragged(l, c) => { root.editor-drag("uuid-out", l, c); }
                    triple-clicked => { root.editor-triple("uuid-out"); }
                    scrolled(dl, dc) => { root.editor-scroll("uuid-out", dl, dc); }
                    scroll-to-line(l) => { root.editor-scroll-line("uuid-out", l); }
                    fold-toggled(r) => { root.editor-fold("uuid-out", r); }
                    key-pressed(t, ctrl, shift) => { root.editor-key("uuid-out", t, ctrl, shift); }
                }
            }
        }

        // —— 执行历史 ——
        Card {
            vertical-stretch: 0;
            height: 132px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "执行记录"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    FieldLabel { text: "保留"; vertical-alignment: center; }
                    Segmented {
                        options: ["3", "5", "10", "20"];
                        current <=> root.hist-keep-index;
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for h[i] in root.history: Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: hist-ta.has-hover ? Theme.border : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: h.label;
                                    font-family: Theme.font-ui;
                                    font-size: 12px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if hist-ta.has-hover: Text {
                                    text: "点击恢复";
                                    font-family: Theme.font-ui;
                                    font-size: 11px;
                                    color: Theme.accent-strong;
                                    vertical-alignment: center;
                                }
                            }
                            hist-ta := TouchArea {
                                clicked => { root.restore-history(i); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— 设置浮层 ———
component SettingsOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> tab: 0;
    in-out property <int> theme-mode: 0;     // 0 系统 / 1 亮 / 2 暗
    in-out property <float> ui-scale: 1.0;
    in-out property <bool> auto-update: true;
    in property <string> version;
    in property <string> build-number: "0";
    in property <string> data-dir;
    in property <string> mem-status: "";
    // 更新器状态（0 空闲 / 1 检查中 / 2 已最新 / 3 发现新版 / 4 下载中 / 5 可安装 / 6 失败）
    in property <int> update-phase;
    in property <string> update-version: "";
    in property <int> update-progress;
    in property <string> update-note: "";
    in property <bool> updater-busy: false;
    in property <string> last-check: "尚未成功检查过";
    in property <bool> last-check-stale: false;
    // 数据源：0 自动 / 1 服务器 / 2 GitHub / 3 演示
    in property <int> source-index: 0;

    callback close();
    // 挪窗口（弹框盖住主标题栏时，标题条就是唯一的抓手）
    callback window-drag();
    callback open-data-dir();
    callback record-memory();
    callback check-update();
    callback reset-demo();
    callback source-changed(int);
    callback clear-drafts();
    callback reset-rail-width();

    visible: root.open;
    background: rgba(0, 0, 0, 0.45);

    // 点背景关闭
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(720px, parent.width - 80px);
        height: min(560px, parent.height - 80px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-2;

        // 吞掉点击，避免穿透到背景的关闭逻辑
        TouchArea { }

        VerticalLayout {
            // 标题栏
            Rectangle {
                height: 48px;
                background: Theme.titlebar;
                border-radius: 14px;

                // 抓着弹框的标题条也能挪窗口。弹框铺满整窗，主标题栏被它盖住，
                // 于是浮层一开窗口就动不了了 —— 那一刻用户唯一能抓的就是这一条。
                // 与主标题栏同一个做法：在**按下瞬间**就交给系统拖（winit 的
                // drag_window 要求鼠标仍按下），并且声明在按钮之前（后声明的
                // 元素先收事件，关闭按钮才不会被这块吃掉）。
                TouchArea {
                    mouse-cursor: default;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.left) {
                            root.window-drag();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    Text {
                        text: "设置";
                        font-family: Theme.font-ui-semibold;
                        font-size: 15px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        // 图标字体是 lucide 子集，只有登记过的私用区码位。
                        // 这里以前写死了字面量 "✕"（U+2715）—— 子集里没有这个
                        // 码位，画出来是空白，于是「设置」右上角看着根本没有关闭按钮。
                        icon: Icons.x;
                        icon-size: 14px;
                        clicked => { root.close(); }
                    }
                }
            }

            HorizontalLayout {
                // 分类栏
                Rectangle {
                    width: 148px;
                    background: Theme.rail;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        alignment: start;
                        for label[i] in ["外观", "字体", "渲染", "更新", "数据", "关于"]: Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: i == root.tab
                                ? Theme.accent-soft
                                : (cat-ta.has-hover ? Theme.border : transparent);
                            Text {
                                x: 12px;
                                width: parent.width - 12px;
                                height: 100%;
                                text: label;
                                font-family: Theme.font-ui-medium;
                                font-size: 13px;
                                color: i == root.tab ? Theme.accent-strong : Theme.fg-soft;
                                vertical-alignment: center;
                            }
                            cat-ta := TouchArea {
                                clicked => { root.tab = i; }
                            }
                        }
                    }
                }

                // 内容区
                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;
                        alignment: start;

                        // —— 外观 ——
                        if root.tab == 0: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "主题"; }
                            Segmented {
                                options: ["跟随系统", "亮色", "暗色"];
                                current <=> root.theme-mode;
                            }
                            FieldLabel { text: "界面缩放"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: Math.round(root.ui-scale * 100) + "%";
                                    font-family: Theme.font-mono-medium;
                                    font-size: 13px;
                                    color: Theme.fg;
                                    vertical-alignment: center;
                                    width: 56px;
                                }
                                FerricButton {
                                    text: "−";
                                    clicked => {
                                        root.ui-scale = max(0.8, root.ui-scale - 0.1);
                                    }
                                }
                                FerricButton {
                                    text: "+";
                                    clicked => {
                                        root.ui-scale = min(1.6, root.ui-scale + 0.1);
                                    }
                                }
                                FerricButton {
                                    text: "重置 100%";
                                    variant: "subtle";
                                    clicked => { root.ui-scale = 1.0; }
                                }
                            }
                        }

                        // —— 字体 ——
                        if root.tab == 1: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "内嵌字体"; }
                            Text {
                                text: "UI：Plus Jakarta Sans（Regular / Medium / SemiBold / Bold）\n等宽：JetBrains Mono（Regular / Medium）\n图标：Lucide\n中文：从系统加载（微软雅黑 / 苹方 / Noto CJK）";
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }

                        // —— 渲染 ——
                        if root.tab == 2: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "渲染后端"; }
                            // 渲染路径是编译期定死的（slint 只启用 renderer-software），
                            // 不再有「试 GPU 失败再降级」那套状态，所以这两段是静态文案。
                            Text {
                                text: "软渲染（CPU · Slint）";
                                font-family: Theme.font-ui-medium;
                                font-size: 13px;
                                color: Theme.fg;
                            }
                            Text {
                                text: "Slint software renderer —— 不建任何 GPU 上下文";
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "进程内存与「一个窗口 + 一块位图」相当：同一台机器上，旧版（egui + wgpu 退化成 WARP）是 ~611MB。";
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.faint;
                                wrap: word-wrap;
                            }
                        }

                        // —— 更新 ——
                        if root.tab == 3: VerticalLayout {
                            spacing: 10px;

                            // 当前状态。**六个阶段都要有话说** —— 只画「就绪」
                            // 那一档的话，检查失败与「已是最新」在界面上无从区分，
                            // 中间人丢包就能伪装成「你已经是最新版」。
                            FieldLabel { text: "状态"; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.update-phase == 6
                                        ? Icons.circle-alert
                                        : (root.update-phase == 2 || root.update-phase == 5
                                            ? Icons.circle-check
                                            : Icons.refresh);
                                    font-family: Theme.font-icons;
                                    font-size: 13px;
                                    color: root.update-phase == 6
                                        ? Theme.danger
                                        : (root.update-phase == 2 || root.update-phase == 5
                                            ? Theme.accent-strong
                                            : Theme.muted);
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.update-phase == 1
                                        ? "正在检查…"
                                        : (root.update-phase == 2
                                            ? "已是最新版本"
                                            : (root.update-phase == 3
                                                ? "发现新版本 v" + root.update-version
                                                : (root.update-phase == 4
                                                    ? "下载中 " + root.update-progress + "%"
                                                    : (root.update-phase == 5
                                                        ? "v" + root.update-version + " 已下载，签名与校验和均已通过"
                                                        : (root.update-phase == 6
                                                            ? "检查失败：" + root.update-note
                                                            : "空闲")))));
                                    font-family: Theme.font-ui;
                                    font-size: 12.5px;
                                    color: root.update-phase == 6 ? Theme.danger : Theme.fg-soft;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                            Text {
                                text: "上次成功检查：" + root.last-check;
                                font-family: Theme.font-ui;
                                font-size: 11.5px;
                                color: root.last-check-stale ? Theme.danger : Theme.faint;
                            }

                            FieldLabel { text: "数据源"; }
                            Segmented {
                                options: ["自动", "服务器", "GitHub", "演示"];
                                current: root.source-index;
                                changed(i) => { root.source-changed(i); }
                            }
                            Text {
                                text: "没有配置更新服务器的构建里，选「演示」可以把插件市场与更新流程点开看。";
                                font-family: Theme.font-ui;
                                font-size: 11.5px;
                                color: Theme.faint;
                                wrap: word-wrap;
                            }

                            CheckBox {
                                text: "自动检查更新并后台下载";
                                checked <=> root.auto-update;
                            }
                            Text {
                                text: root.auto-update
                                    ? "下好之后侧栏左下角会出现「安装 vX」，绝不自动装。"
                                    : "只在手动点「立即检查更新」时联网。";
                                font-family: Theme.font-ui;
                                font-size: 11.5px;
                                color: Theme.faint;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                FerricButton {
                                    // 检查中禁用：点两下就是两次并发检查。
                                    text: root.updater-busy ? "检查中…" : "立即检查更新";
                                    variant: "default";
                                    enabled: !root.updater-busy;
                                    clicked => { root.check-update(); }
                                }
                            }
                        }

                        // —— 数据 ——
                        if root.tab == 4: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "数据目录"; }
                            Text {
                                text: root.data-dir;
                                font-family: Theme.font-mono-medium;
                                font-size: 12px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                FerricButton {
                                    text: "打开数据文件夹";
                                    clicked => { root.open-data-dir(); }
                                }
                                FerricButton {
                                    text: "记录 30 秒内存";
                                    clicked => { root.record-memory(); }
                                }
                                FerricButton {
                                    text: "重置演示数据";
                                    variant: "subtle";
                                    clicked => { root.reset-demo(); }
                                }
                            }
                            if root.mem-status != "": Text {
                                text: root.mem-status;
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.accent-strong;
                            }
                            FieldLabel { text: "清理"; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                FerricButton {
                                    text: "清除收藏与工具草稿";
                                    variant: "subtle";
                                    clicked => { root.clear-drafts(); }
                                }
                                FerricButton {
                                    text: "侧栏宽度恢复默认";
                                    variant: "subtle";
                                    clicked => { root.reset-rail-width(); }
                                }
                            }
                        }

                        // —— 关于 ——
                        if root.tab == 5: VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "Ferric";
                                font-family: Theme.font-ui-semibold;
                                font-size: 16px;
                                color: Theme.fg;
                            }
                            // 版本 + 构建号：报 bug 时说不清是哪个 build 等于白报。
                            Text {
                                text: "v" + root.version + "  (build " + root.build-number + ")";
                                font-family: Theme.font-mono-medium;
                                font-size: 12.5px;
                                color: Theme.muted;
                            }
                            Text {
                                text: "跨平台原生 Rust 开发者工具箱。GUI：Slint（软件渲染）。\n工具数据仅存于本机；只有检查更新与插件市场会联网。";
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— 操作记录 ———
//
// 提示条只活 4 秒，这里是它们的**统一落点**：复制了什么、更新查到哪一步、
// 插件为什么没加载起来、安装为什么失败，一次会话内都能回头看。
// 由 Rust 侧的 `Shared::activity` 灌进来（上限 200 条，超了丢最旧的）。
component ActivityPanel inherits Rectangle {
    in property <[ActivityRow]> rows;
    callback clear();
    callback dismiss();
    // 挪窗口（同 SettingsOverlay：浮层盖住主标题栏时的唯一抓手）
    callback window-drag();

    background: rgba(0, 0, 0, 0.42);

    // 点背景关闭
    TouchArea {
        clicked => { root.dismiss(); }
    }

    Rectangle {
        width: min(560px, parent.width - 80px);
        height: min(480px, parent.height - 120px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-2;

        // 吞掉点击，避免穿透到背景的关闭逻辑
        TouchArea { }

        VerticalLayout {
            // 标题条
            Rectangle {
                height: 48px;
                background: Theme.titlebar;
                border-radius: 14px;
                TouchArea {
                    mouse-cursor: default;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.left) {
                            root.window-drag();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: "操作记录";
                        font-family: Theme.font-ui-semibold;
                        font-size: 15px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.rows.length + " 条";
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                    IconButton {
                        icon: Icons.trash;
                        icon-size: 14px;
                        enabled: root.rows.length > 0;
                        clicked => { root.clear(); }
                    }
                    IconButton {
                        icon: Icons.x;
                        icon-size: 14px;
                        clicked => { root.dismiss(); }
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 10px;
                    spacing: 1px;
                    alignment: start;
                    // 新的在上：刚发生的事最可能是用户要找的那条。
                    for r in root.rows: Rectangle {
                        height: max(30px, row-text.min-height + 12px);
                        border-radius: 7px;
                        background: row-ta.has-hover ? Theme.code-bg : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text {
                                text: r.level == 2
                                    ? Icons.circle-alert
                                    : (r.level == 1 ? Icons.circle-alert : Icons.circle-check);
                                font-family: Theme.font-icons;
                                font-size: 12px;
                                color: r.level == 2
                                    ? Theme.danger
                                    : (r.level == 1 ? #e0a23a : Theme.accent);
                                vertical-alignment: center;
                            }
                            Text {
                                text: r.at;
                                font-family: Theme.font-mono;
                                font-size: 11px;
                                color: Theme.faint;
                                vertical-alignment: center;
                            }
                            row-text := Text {
                                text: r.text;
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: r.level == 2 ? Theme.danger : Theme.fg-soft;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        row-ta := TouchArea { }
                    }
                }
            }

            if root.rows.length == 0: Text {
                text: "还没有记录";
                font-family: Theme.font-ui;
                font-size: 12.5px;
                color: Theme.faint;
                horizontal-alignment: center;
            }
        }
    }
}

// ——— 命令面板（Ctrl+K） ———
//
// 只做一件事：不摸鼠标也能跳到任意工具。行由 Rust 侧按同一套搜索规则给
//（名称 / 描述 / 关键词，见 `tool_rows`），所以面板与侧栏的命中结果一致。
component CommandPalette inherits Rectangle {
    in property <[ToolEntry]> rows;
    in-out property <string> query;
    in-out property <int> sel;
    callback query-edited(string);
    // 参数是工具在 Rust 侧 `AppState::tools` 里的下标
    callback pick(int);
    callback dismiss();

    background: rgba(0, 0, 0, 0.42);

    // 点背景关闭
    TouchArea {
        clicked => { root.dismiss(); }
    }

    // 选中项：列表可能被过滤到更短，取值前夹住
    property <int> cur: min(root.sel, max(root.rows.length - 1, 0));

    // 上下 / 回车 / Esc **不在这里接**：单行 TextInput 会把方向键与回车吃掉
    //（实测挂在祖先 FocusScope 上的 key-pressed 收不到），所以这几个键统一在
    // Rust 侧的 winit 事件里拦（见 `Shell::wire_palette`）。这里只管显示与鼠标。
        Rectangle {
            width: min(620px, parent.width - 80px);
            height: min(430px, parent.height - 140px);
            x: (parent.width - self.width) / 2;
            y: 84px;
            background: Theme.bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-2;

            // 吞掉点击，避免穿透到背景的关闭逻辑
            TouchArea { }

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                input := FerricLineEdit {
                    placeholder: "跳到工具…（↑↓ 选择，回车打开，Esc 关闭）";
                    text <=> root.query;
                    edited(t) => { root.query-edited(t); }
                    accepted(t) => {
                        if (root.rows.length > 0) {
                            root.pick(root.rows[root.cur].idx);
                        }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 2px;
                        alignment: start;
                        for t[i] in root.rows: Rectangle {
                            height: 46px;
                            border-radius: 9px;
                            background: i == root.cur
                                ? Theme.accent-soft
                                : (row-ta.has-hover ? Theme.border : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text {
                                    text: t.icon;
                                    font-family: Theme.font-icons;
                                    font-size: 16px;
                                    color: i == root.cur ? Theme.accent-strong : Theme.muted;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: t.name;
                                        font-family: Theme.font-ui-medium;
                                        font-size: 13.5px;
                                        color: Theme.fg;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: t.desc;
                                        font-family: Theme.font-ui;
                                        font-size: 11.5px;
                                        color: Theme.faint;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: t.group;
                                    font-family: Theme.font-ui;
                                    font-size: 11px;
                                    color: Theme.faint;
                                    vertical-alignment: center;
                                }
                            }
                            row-ta := TouchArea {
                                clicked => { root.pick(t.idx); }
                            }
                        }
                    }
                }

                if root.rows.length == 0: Text {
                    text: "没有匹配的工具";
                    font-family: Theme.font-ui;
                    font-size: 12.5px;
                    color: Theme.faint;
                    horizontal-alignment: center;
                }
            }
        }

    // 打开即聚焦输入框：面板是键盘入口，打开还要先点一下就没意义了。
    init => { input.focus(); }
}

export component AppWindow inherits Window {
    title: "Ferric";
    // 与原 eframe 版一致的默认尺寸与下限。
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 360px;
    min-height: 280px;
    no-frame: true;
    // 无边框窗口自己没有系统边框可拖。Slint 的 winit 后端会在离边缘
    // `resize-border-width` 以内接管指针（换 resize 光标 + 调 drag_resize_window），
    // 但这个属性默认 0px —— 不给值就等于「窗口不能拖着改大小」。
    resize-border-width: 6px;
    background: Theme.canvas;

    // ——— 状态（Rust 侧读写） ———
    // 侧栏行（分组标题 + 工具，由 Rust 侧 `rail_rows` 一次算好）
    in property <[RailRow]> rail;
    in-out property <int> active-tool: 0;
    in-out property <string> rail-filter: "";
    in-out property <length> rail-width: 264px;
    in-out property <bool> settings-open: false;
    // 命令面板（Ctrl+K）：行由 Rust 侧按搜索词给
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-sel: 0;
    in property <[ToolEntry]> palette-rows;
    in property <string> version: "0.2.0";
    in property <string> build-number: "0";
    // 更新器辅助状态（阶段本身在「更新器」一节）
    in property <bool> updater-busy: false;
    in property <string> last-check: "尚未成功检查过";
    in property <bool> last-check-stale: false;
    // 数据源：0 自动 / 1 服务器 / 2 GitHub / 3 演示
    in property <int> source-index: 0;
    in property <string> data-dir: "";
    in property <string> mem-status: "";
    // 提示条（4 秒自动消失，也可点「×」）与它们的长期落点「操作记录」
    in property <[ToastRow]> toasts;
    in property <[ActivityRow]> activity;
    in-out property <bool> log-open: false;

    // 设置项（双向）
    in-out property <int> theme-mode: 0;
    in-out property <float> ui-scale: 1.0;
    in-out property <bool> auto-update: true;
    in-out property <int> settings-tab: 0;

    // UUID 工具状态
    in-out property <int> uuid-kind: 0;
    in-out property <int> uuid-count: 10;
    in-out property <int> uuid-namespace: 0;
    in-out property <string> uuid-custom-ns: "";
    in-out property <string> uuid-name: "example.com";
    in-out property <bool> uuid-upper: false;
    in-out property <bool> uuid-nohyphen: false;
    in-out property <bool> uuid-as-json: false;
    in-out property <int> uuid-hist-keep: 0;
    // 输出走只读编辑区（可拖选 / Ctrl+C），与其它工具的输出面板一致
    in property <EditorState> uuid-out;
    in property <bool> uuid-ok: true;
    in property <string> uuid-status: "就绪";
    in property <[UuidHistEntry]> uuid-history;

    // YAML 工具状态
    in property <EditorState> yaml-input;
    in property <EditorState> yaml-output;
    in property <bool> yaml-ok: true;
    in property <string> yaml-status: "";

    // SQL 工具状态
    in property <EditorState> sql-input;
    in property <bool> sql-uppercase: true;
    in property <string> sql-status: "";

    // 正则工具状态
    in-out property <string> regex-pattern;
    in property <bool> regex-fg: true;
    in property <bool> regex-fi;
    in property <bool> regex-fm;
    in property <bool> regex-fs;
    in property <bool> regex-fx;
    in property <EditorState> regex-text;
    in property <[RegexMatch]> regex-matches;
    in property <bool> regex-ok: true;
    in property <string> regex-status: "";

    // RSA 工具状态
    in property <int> rsa-bits: 1;
    in property <bool> rsa-busy;
    in property <bool> rsa-ok: true;
    in property <string> rsa-status: "";
    in property <EditorState> rsa-pub;
    in property <EditorState> rsa-priv;

    // 加密 / 解密工具状态
    in property <[string]> crypto-algos;
    in property <int> crypto-enc-algo;
    in property <int> crypto-dec-algo;
    in-out property <string> crypto-enc-key;
    in-out property <string> crypto-dec-key;
    in property <EditorState> crypto-enc-in;
    in property <EditorState> crypto-enc-out;
    in property <EditorState> crypto-dec-in;
    in property <EditorState> crypto-dec-out;
    in property <bool> crypto-enc-ok: true;
    in property <bool> crypto-dec-ok: true;
    in property <string> crypto-enc-status: "";
    in property <string> crypto-dec-status: "";

    // 国密 SM 工具状态
    in-out property <string> gm-pub-key;
    in-out property <string> gm-priv-key;
    in property <string> gm-key-status: "";
    in property <[string]> gm-enc-algos;
    in property <[string]> gm-dec-algos;
    in property <[string]> gm-fmts;
    in property <int> gm-enc-algo;
    in property <int> gm-dec-algo;
    in property <int> gm-fmt;
    in property <bool> gm-enc-needs-key: true;
    in property <string> gm-enc-key-label: "口令";
    in property <string> gm-dec-key-label: "口令";
    in-out property <string> gm-enc-key;
    in-out property <string> gm-dec-key;
    in property <EditorState> gm-enc-in;
    in property <EditorState> gm-enc-out;
    in property <EditorState> gm-dec-in;
    in property <EditorState> gm-dec-out;
    in property <bool> gm-enc-ok: true;
    in property <bool> gm-dec-ok: true;
    in property <string> gm-enc-status: "";
    in property <string> gm-dec-status: "";
    in property <EditorState> gm-sig;
    in-out property <string> gm-sig-hex;
    in property <bool> gm-sig-ok: true;
    in property <string> gm-sig-status: "";

    // 时间戳工具状态
    in property <string> ts-now: "";
    in property <string> ts-now-ms: "";
    in property <bool> ts-running;
    in property <string> ts-offset: "";
    in property <string> ts-tz-label: "";
    in-out property <string> ts-tz-filter;
    in property <[TzRow]> ts-tz-hits;
    in-out property <string> ts-ts-input;
    in property <string> ts-ts-output: "";
    in property <bool> ts-ts-ok: true;
    in-out property <string> ts-date-input;
    in property <string> ts-date-output: "";
    in property <bool> ts-date-ok: true;

    // JSON 工具状态
    in property <EditorState> json-input;
    // Ctrl+F 的聚焦脉冲（自增即请求聚焦，见 JsonView 的 focus-tick）。
    in-out property <int> json-find-focus-tick;
    in property <int> json-indent;
    in property <bool> json-sort;
    in property <bool> json-wrap: true;
    in property <bool> json-ok: true;
    in property <string> json-status: "";
    in-out property <string> json-find;
    // 查找条开着没有。Rust 侧的全局按键钩子（Ctrl+F / Esc）也写这个属性。
    in-out property <bool> json-find-open: false;
    in property <int> json-hit-count;
    in property <int> json-hit-index;
    in property <bool> json-can-undo;
    in property <bool> json-can-redo;
    // 粘贴记录（右侧抽屉）。一条记录 = `<数据目录>/json-history/<名字>.json`，
    // 存文件不存数据库：记录本身就是文档，名字就是文件名，用户能直接拿走。
    in property <bool> json-history-open;
    in property <[HistoryRow]> json-history-rows;
    in-out property <string> json-history-query;
    in property <int> json-history-renaming: -1;
    in property <string> json-history-status;

    // 对比工具状态
    in property <EditorState> diff-left;
    in property <EditorState> diff-right;
    // 有没有差异（决定「上一处 / 下一处」两个按钮能不能点）
    in property <bool> diff-has-diff;
    in property <string> diff-status: "";

    // 插件市场状态
    in-out property <string> market-query;
    in property <[PluginCard]> market-cards;
    in property <bool> market-loading;
    in property <bool> market-ok: true;
    in property <string> market-status: "";
    in property <int> market-progress;
    in property <bool> market-installing;
    in property <int> market-pending;
    // 标签过滤（0 全部 / 1 已安装）与两个标签上的计数。计数由 Rust 侧按
    // 「搜索命中 + 是否已装」算好 —— 标签上的数字必须等于点进去看到的条数。
    in property <int> market-tab;
    in property <int> market-count-all;
    in property <int> market-count-installed;

    // 当前选中的 WASM 插件（内置工具时为空）
    in property <[PluginOption]> plugin-options;
    in property <EditorState> plugin-in;
    in property <EditorState> plugin-out;
    in property <bool> plugin-ok: true;
    in property <string> plugin-status: "";
    // 当前工具是不是插件 —— 决定走 PluginView 还是内置分支
    in property <bool> current-is-plugin;

    // 更新器状态
    // 0 空闲 / 1 检查中 / 2 已最新 / 3 发现新版 / 4 下载中 / 5 可安装 / 6 失败
    in property <int> update-phase;
    in property <string> update-version: "";
    in property <int> update-progress;
    in property <string> update-note: "";
    in-out property <bool> update-dialog-open;

    // ——— 回调（Rust 侧接管） ———
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    callback select-tool(int);
    callback toggle-favorite(int);
    callback theme-changed(int);
    callback scale-changed(float);
    callback auto-update-changed(bool);
    // 搜索词由 Rust 侧持有（过滤在那边算），这里只把每次输入送过去。
    callback filter-changed(string);
    // 命令面板的搜索词（行由 Rust 侧算完灌回 palette-rows）
    callback palette-query-changed(string);
    callback rail-width-changed(float);
    callback open-data-dir();
    callback record-memory();
    callback check-update();
    // 提示与操作记录
    callback dismiss-toast(int);
    callback clear-activity();
    // 设置里的动作
    callback source-changed(int);
    callback clear-drafts();
    callback reset-rail-width();
    callback uuid-regenerate();
    callback uuid-copy();
    callback uuid-restore-history(int);

    // 编辑区通用回调。第一个参数是编辑区标识（如 "yaml-in"），
    // Rust 侧一个 match 分派到对应的 TextBuffer —— 每加一个文本类工具
    // 不需要再接一遍回调。
    callback editor-viewport(string, int, int);
    callback editor-wide-ratio(float);
    callback editor-click(string, int, float, bool);
    callback editor-drag(string, int, float);
    callback editor-triple(string);
    callback editor-fold(string, int);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    // YAML 工具
    callback yaml-sample();
    callback yaml-clear();
    callback yaml-copy();

    // SQL 工具
    callback sql-format();
    callback sql-minify();
    callback sql-set-case(int);
    callback sql-clear();
    callback sql-copy();

    // 正则工具
    callback regex-pattern-edited(string);
    callback regex-toggle-flag(int);

    // RSA 工具
    callback rsa-bits-changed(int);
    callback rsa-generate();
    callback rsa-copy-pub();
    callback rsa-copy-priv();

    // 加密 / 解密工具
    callback crypto-enc-algo-changed(int);
    callback crypto-dec-algo-changed(int);
    callback crypto-enc-key-edited(string);
    callback crypto-dec-key-edited(string);
    callback crypto-encrypt();
    callback crypto-decrypt();
    callback crypto-send-to-decrypt();
    callback crypto-copy-enc();
    callback crypto-copy-dec();

    // 国密 SM 工具
    callback gm-gen-keypair();
    callback gm-derive-pub();
    callback gm-enc-algo-changed(int);
    callback gm-dec-algo-changed(int);
    callback gm-fmt-changed(int);
    callback gm-enc-key-edited(string);
    callback gm-dec-key-edited(string);
    callback gm-pub-key-edited(string);
    callback gm-priv-key-edited(string);
    callback gm-sig-hex-edited(string);
    callback gm-encrypt();
    callback gm-decrypt();
    callback gm-send-to-decrypt();
    callback gm-sign();
    callback gm-verify();

    // 时间戳工具
    callback ts-toggle-running();
    callback ts-refresh-now();
    callback ts-use-now();
    callback ts-copy-now();
    callback ts-filter-edited(string);
    callback ts-select-tz(string);
    callback ts-input-edited(string);
    callback ts-date-edited(string);

    // JSON 工具
    callback json-format();
    callback json-minify();
    callback json-escape();
    callback json-unescape();
    callback json-toggle-sort();
    callback json-toggle-wrap();
    callback json-indent-changed(int);
    callback json-clear();
    callback json-copy();
    callback json-undo();
    callback json-redo();
    callback json-find-edited(string);
    callback json-search();
    callback json-next-hit();
    callback json-prev-hit();
    callback json-history-toggle();
    callback json-history-query-edited(string);
    callback json-history-restore(int);
    callback json-history-rename-start(int);
    callback json-history-rename(int, string);
    callback json-history-rename-cancel();
    callback json-history-delete(int);
    callback json-history-clear();

    // 对比工具
    callback diff-compare();
    callback diff-next-hunk();
    callback diff-prev-hunk();
    callback diff-swap();
    callback diff-clear();
    callback diff-copy();

    // 插件市场
    callback market-query-edited(string);
    callback market-refresh();
    callback market-install(string);
    callback market-uninstall(string);
    callback market-update-all();
    callback market-tab-changed(int);

    // WASM 插件
    callback plugin-option-changed(int, int, string);
    callback plugin-run();
    callback plugin-copy();

    // 更新器
    callback update-install();
    callback update-dismiss();
    callback reset-demo();

    // 当前工具（Rust 侧灌：侧栏模型被过滤后没法按下标取）
    in property <ToolEntry> current;

    // 双向属性改了就通知 Rust：界面上的改动必须落到状态里（保存 + 生效），
    // 光靠 `<=>` 只会停在 property 上。Rust 自己灌值那一拍也会走到这里 ——
    // 回调侧按值相等提前返回。
    changed theme-mode => { root.theme-changed(self.theme-mode); }
    changed ui-scale => { root.scale-changed(self.ui-scale); }
    changed auto-update => { root.auto-update-changed(self.auto-update); }
    changed rail-width => { root.rail-width-changed(self.rail-width / 1px); }

    VerticalLayout {
        // ===== 标题栏 44px =====
        Rectangle {
            height: 44px;
            background: Theme.titlebar;

            // 拖拽区（右侧留出 96px 给三个窗口按钮，按钮声明在后面因此覆盖其上）。
            //
            // 在**按下瞬间**就交给系统拖动，而不是等 `moved`：winit 的
            // drag_window 要求在鼠标仍按下时调用，等移动事件到达时那一拍
            // 已经过去了（实测「拖了没反应」就是这个原因）。
            drag-ta := TouchArea {
                width: parent.width - 96px;
                height: parent.height;
                mouse-cursor: default;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                        root.window-drag();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 6px;
                spacing: 0px;

                // 品牌区：图标 + 名字 + 版本
                Text {
                    text: Icons.box;
                    font-family: Theme.font-icons;
                    font-size: 16px;
                    color: Theme.accent-strong;
                    vertical-alignment: center;
                }
                Rectangle { width: 8px; }
                Text {
                    text: "Ferric";
                    font-family: Theme.font-ui-bold;
                    font-weight: Theme.weight-bold;
                    font-size: 14.5px;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                Rectangle { width: 10px; }
                Text {
                    text: root.version;
                    font-family: Theme.font-mono-medium;
                    font-size: 11.5px;
                    color: Theme.faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // 窗口按钮。字形一律取 Lucide 码点（`Icons.*`）——
                // 写「▢」「✕」这类相似字符时内嵌字体里没有，按钮会整个变空白。
                IconButton {
                    icon: Icons.minus;
                    icon-size: 15px;
                    clicked => { root.window-minimize(); }
                }
                IconButton {
                    icon: Icons.square;
                    icon-size: 13px;
                    clicked => { root.window-maximize(); }
                }
                IconButton {
                    icon: Icons.x;
                    icon-size: 15px;
                    danger: true;
                    clicked => { root.window-close(); }
                }
            }

            // 底部分隔线
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }
        }

        HorizontalLayout {
            // ===== 侧栏 =====
            Rectangle {
                width: root.rail-width;
                background: Theme.rail;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // 搜索框：左侧放大镜 + 「Ctrl K」提示（命令面板的唯一线索，
                    // 不写出来用户无从知道有这个快捷键）。
                    Rectangle {
                        height: 38px;
                        FerricLineEdit {
                            width: 100%;
                            height: 100%;
                            pad-left: 34px;
                            placeholder: "搜索工具…   Ctrl K";
                            text <=> root.rail-filter;
                            // 用 `edited` 而不是 `changed rail-filter`：内建 TextInput
                            // 的 text 走双向绑定时，根组件上的 changed 不会被触发
                            //（实测输入后侧栏纹丝不动）。
                            edited(t) => { root.filter-changed(t); }
                        }
                        Text {
                            x: 12px;
                            width: 16px;
                            height: 100%;
                            text: Icons.search;
                            font-family: Theme.font-icons;
                            font-size: 14px;
                            color: Theme.faint;
                            vertical-alignment: center;
                        }
                    }

                    // 工具列表：分组标题与工具行同在一个模型里（`rail_rows`）。
                    // 过滤也在 Rust 侧算（Slint 的 string 没有 contains，
                    // 中文还要按 char 比），不命中的行根本不进模型。
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for r in root.rail: Rectangle {
                                height: r.group ? 26px : 38px;
                                if r.group: RailGroup {
                                    label: r.label;
                                    icon: r.icon;
                                }
                                if !r.group: SidebarRow {
                                    entry: r;
                                    active: r.idx == root.active-tool;
                                    selected => { root.select-tool(r.idx); }
                                    toggle-favorite => { root.toggle-favorite(r.idx); }
                                }
                            }
                        }
                    }

                    // ===== 底部：更新状态 + 品牌 + 一排入口 =====
                    //
                    // 位置对齐 egui 版的左下角。更新入口刻意不放标题栏：那儿只该
                    // 有窗口按钮，一个绿按钮紧贴关闭键既抢眼又容易误点。
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // 品牌块。更新入口是**跟在版本号后面的一个小胶囊** ——
                    // 以前是品牌行上方一条通栏绿按钮，在 264px 宽的侧栏里
                    // 比工具名还抢眼，用户的话是「看着奇奇怪怪的」。
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 9px;
                            background: Theme.accent;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: Icons.box;
                                font-family: Theme.font-icons;
                                font-size: 17px;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Ferric";
                                font-family: Theme.font-ui-semibold;
                                font-size: 13px;
                                color: Theme.fg;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: "v" + root.version;
                                    font-family: Theme.font-mono;
                                    font-size: 10.5px;
                                    color: Theme.faint;
                                    vertical-alignment: center;
                                }

                                // 有事才出现：下载中 / 可安装。空闲、已最新、
                                // **失败**都不占地方 —— 失败是后台自动检查的结果，
                                // 用户没要求过这件事，拿一颗红胶囊堵在版本号旁边
                                // 只会让人焦虑又无从处理（网络不通时每次启动都挂着）。
                                // 详情两处都留着：设置 → 更新的状态行，以及操作记录。
                                if root.update-phase == 4 || root.update-phase == 5: chip := Rectangle {
                                    // 可安装 = 要人点的那一档，用主色；下载中是中性灰。
                                    property <bool> ready: root.update-phase == 5;
                                    height: 18px;
                                    horizontal-stretch: 0;
                                    border-radius: 9px;
                                    background: chip.ready
                                        ? (chip-ta.has-hover ? Theme.accent-strong : Theme.accent)
                                        : Theme.border;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 7px;
                                        spacing: 3px;
                                        Text {
                                            text: chip.ready ? Icons.file-down : Icons.refresh;
                                            font-family: Theme.font-icons;
                                            font-size: 10px;
                                            color: chip.ready ? #ffffff : Theme.muted;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: chip.ready
                                                ? "安装 v" + root.update-version
                                                : root.update-progress + "%";
                                            font-family: Theme.font-ui-medium;
                                            font-size: 10.5px;
                                            color: chip.ready ? #ffffff : Theme.muted;
                                            vertical-alignment: center;
                                        }
                                    }

                                    chip-ta := TouchArea {
                                        // 下载中不可点：还没下完，点了也没得装
                                        enabled: chip.ready;
                                        mouse-cursor: pointer;
                                        clicked => { root.update-dialog-open = true; }
                                    }
                                }
                            }
                        }
                    }

                    // 入口行：主题 / 操作记录 / 关于 / 设置
                    // 图标比别处大一号：这一排是侧栏最底下的常用入口，
                    // 15px 在 264px 宽的侧栏里偏小（用户反馈「有点小」）。
                    HorizontalLayout {
                        spacing: 2px;
                        IconButton {
                            icon: Theme.dark ? Icons.sun : Icons.moon;
                            icon-size: 19px;
                            // 单击就在亮 / 暗之间来回。「跟随系统」留在设置里 ——
                            // 三态循环按钮点两下才回到原处，反而难用。
                            clicked => { root.theme-mode = Theme.dark ? 1 : 2; }
                        }
                        IconButton {
                            icon: Icons.list-checks;
                            icon-size: 19px;
                            active: root.log-open;
                            clicked => { root.log-open = !root.log-open; }
                        }
                        IconButton {
                            icon: Icons.info;
                            icon-size: 19px;
                            clicked => {
                                root.settings-tab = 5;
                                root.settings-open = true;
                            }
                        }
                        IconButton {
                            icon: Icons.settings;
                            icon-size: 19px;
                            active: root.settings-open;
                            clicked => {
                                root.settings-tab = 0;
                                root.settings-open = true;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // 右边缘：分隔线 + 拖宽手柄（宽度上下限与 Rust 侧 RAIL_MIN /
                // RAIL_MAX 一致；越界值 Rust 会夹住再推回来）。
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: rail-resize.has-hover || rail-resize.pressed
                        ? Theme.accent-strong
                        : Theme.border;
                }
                rail-resize := TouchArea {
                    x: parent.width - 3px;
                    width: 6px;
                    height: parent.height;
                    mouse-cursor: col-resize;
                    // 宽度 = 指针在窗口内的横坐标（手柄贴着侧栏右缘，抓点即等宽）。
                    //
                    // 不能用 `mouse-x - pressed-x`：手柄自己跟着 rail-width 走，
                    // 参考系一起移动，位移会被吃掉一半（实测拖 90px 只宽了 45px）。
                    // `absolute-position + mouse-x` 与手柄位置无关，天然自洽。
                    moved => {
                        root.rail-width = min(max(
                            self.absolute-position.x + self.mouse-x,
                            196px), 460px);
                    }
                }
            }

            // ===== 主内容区 =====
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg;

                VerticalLayout {
                    // 工具标题条：名称 + 收藏
                    Rectangle {
                        height: 60px;
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 14px;
                            spacing: 12px;
                            Text {
                                text: root.current.name;
                                font-family: Theme.font-ui-bold;
                                font-weight: Theme.weight-bold;
                                font-size: 19px;
                                color: Theme.fg;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // 收藏：收藏组会置顶到侧栏最上，所以这颗心是有用的。
                            IconButton {
                                icon: Icons.heart;
                                icon-size: 16px;
                                active: root.current.favorite;
                                clicked => { root.toggle-favorite(root.current.idx); }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: Theme.border;
                        }
                    }

                    // 说明条：accent 竖条 + 描述（对位 egui 版的 page-intro；
                    // 挤在标题下面当小灰字读起来太轻，那是页面在自我介绍）。
                    if root.current.desc != "": HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 14px;
                        spacing: 10px;
                        Rectangle {
                            width: 3px;
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                        Text {
                            text: root.current.desc;
                            font-family: Theme.font-ui;
                            font-size: 13px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    // 内容列：宽屏时收窄居中到 1080px（对位 egui 版 content_metrics）。
                    // 不收窄的话同一组控件在 1280px+ 的窗口里被拉开，一行字的
                    // 扫视距离过长 —— 这也是「怎么都变成左右布局了」的观感来源。
                    // 编辑器类工具（`wide`）照旧整宽。
                    Rectangle {
                        vertical-stretch: 1;
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: 0;
                            width: root.current.wide ? parent.width : min(1080px, parent.width);
                            height: parent.height;
                            VerticalLayout {

                    // 工具主体：按 current.id 分派（新增工具漏了分支这里就是空白）
                    if root.current.id == "uuid": UuidView {
                        vertical-stretch: 1;
                        kind-index <=> root.uuid-kind;
                        count <=> root.uuid-count;
                        namespace-index <=> root.uuid-namespace;
                        custom-ns <=> root.uuid-custom-ns;
                        name-input <=> root.uuid-name;
                        upper <=> root.uuid-upper;
                        nohyphen <=> root.uuid-nohyphen;
                        as-json <=> root.uuid-as-json;
                        hist-keep-index <=> root.uuid-hist-keep;
                        out: root.uuid-out;
                        ok: root.uuid-ok;
                        status: root.uuid-status;
                        history: root.uuid-history;
                        regenerate => { root.uuid-regenerate(); }
                        copy-output => { root.uuid-copy(); }
                        restore-history(i) => { root.uuid-restore-history(i); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-fold(w, r) => { root.editor-fold(w, r); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "yaml": YamlView {
                        vertical-stretch: 1;
                        input-state: root.yaml-input;
                        output-state: root.yaml-output;
                        ok: root.yaml-ok;
                        status: root.yaml-status;
                        load-sample => { root.yaml-sample(); }
                        clear-input => { root.yaml-clear(); }
                        copy-output => { root.yaml-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
