// 复用 UI 组件，对位原 widgets/mod.rs 的那一套（primary / ghost / subtle 按钮、
// 图标按钮、分段控件、字段标签）。样式全部从 Theme global 取，不在这里写死颜色。

import { Theme, Icons } from "theme.slint";

// 区块小标题（原 field_label）。
export component FieldLabel inherits Text {
    font-family: Theme.font-ui-medium;
    font-size: 12.5px;
    color: Theme.fg-soft;
}

// 工具条上的竖分隔线（原 widgets::tb_sep）。整块占位、线只画中间那一段 ——
// 在 HorizontalLayout 里给子元素固定高度会被拉伸，所以线是内层画的。
export component VDivider inherits Rectangle {
    in property <length> line-height: 18px;
    min-width: 9px;
    horizontal-stretch: 0;

    Rectangle {
        x: 4px;
        y: (parent.height - root.line-height) / 2;
        width: 1px;
        height: root.line-height;
        background: Theme.border;
    }
}

// ——— 按钮 ———
// 原 widgets::btn 的三个 variant 合成一个组件，用 `variant` 选。
// 尺寸沿用原实现：高 38、primary/default 横向 padding 16、subtle 12、圆角 10。
export component FerricButton inherits Rectangle {
    in property <string> text;
    // 可选前置图标（Lucide 字符）。空串 = 不画图标。
    in property <string> icon: "";
    // "primary" | "default" | "subtle"
    in property <string> variant: "default";
    in property <bool> enabled: true;
    callback clicked();

    property <bool> is-primary: variant == "primary";
    property <bool> is-subtle: variant == "subtle";
    property <length> pad: is-subtle ? 12px : 16px;

    height: 38px;
    min-width: layout.min-width;
    border-radius: 10px;

    background: !enabled
        ? (is-primary ? Theme.accent.with-alpha(0.45) : Theme.code-bg)
        : is-primary
            ? (ta.pressed ? Theme.accent-strong : (ta.has-hover ? Theme.accent-strong : Theme.accent))
            : is-subtle
                ? (ta.has-hover ? Theme.border : transparent)
                : (ta.has-hover ? Theme.border-2 : Theme.code-bg);

    property <color> fg: is-primary
        ? #ffffff
        : is-subtle
            ? (ta.has-hover ? Theme.fg : Theme.muted)
            : Theme.fg-soft;

    layout := HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 8px;
        alignment: center;

        if root.icon != "": Text {
            text: root.icon;
            font-family: Theme.font-icons;
            font-size: 16px;
            color: root.fg;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-family: Theme.font-ui-medium;
            font-size: 13.5px;
            color: root.fg;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// 图标按钮（正方形，muted → hover 变 fg + border 底）。
// 方块边长跟着字号走：原实现是 (size * 1.65).max(26.0)。
//
// `danger` 给关闭按钮用：hover 时整块变红、图标反白，符合平台习惯
//（误点关闭的代价最大，它必须看起来跟其它按钮不一样）。
// `active` 给「当前已打开」/「开关已开」的入口用（设置浮层开着时的齿轮、
// JSON 工具条上打开的换行开关）。
// `label` 给「图标字体里没有这个符号」的按钮用（缩进档位的 2 / 4）——
// Lucide 子集里没有数字，硬塞进 font-icons 会画成空白。
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label: "";
    in property <length> icon-size: 18px;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> active: false;
    // 悬停提示。图标按钮没有文字，不给提示等于让用户猜。
    in property <string> tooltip: "";
    callback clicked();

    property <length> side: max(root.icon-size * 1.65, 26px);
    // 只声明 min-*（Slint 不允许 width 与 min-width 同时给）：
    // 布局据此分配空间，且不会把标题栏里挤在一起的按钮压扁。
    min-width: side;
    min-height: side;
    horizontal-stretch: 0;
    border-radius: 9px;
    background: !root.enabled
        ? transparent
        : (ta.has-hover
            ? (root.danger ? Theme.danger : Theme.border)
            : (root.active ? Theme.accent-soft : transparent));

    Text {
        width: 100%;
        height: 100%;
        text: root.label != "" ? root.label : root.icon;
        font-family: root.label != "" ? Theme.font-mono-medium : Theme.font-icons;
        font-size: root.label != "" ? root.icon-size - 2px : root.icon-size;
        color: !root.enabled
            ? Theme.faint
            : (ta.has-hover
                ? (root.danger ? #ffffff : Theme.fg)
                : (root.active ? Theme.accent-strong : Theme.muted));
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            // 点下去就把气泡收掉：点完还悬着一句说明反而挡住刚变化的界面。
            Tooltip.text = "";
            root.clicked();
        }
    }

    // 提示气泡：悬停 450ms 后出现（立刻出现的话扫过一排按钮会一路闪）。
    //
    // 气泡本体由 `AppWindow` 画在**最上层**（见下面的 `Tooltip` global）。
    // 曾经用 PopupWindow：弹层会抢输入 —— 悬停出气泡之后按钮的下一次点击
    // 被弹层吃掉，表现为「同一个按钮点第二下没反应」。
    // 定时器**不能**在 triggered 里写 `self.running = false` —— 那会把上面的
    // 绑定顶掉，气泡从此只出现一次。让它照常重复即可：每次触发写的是同一份
    // 内容，幂等。
    delay := Timer {
        interval: 450ms;
        running: root.tooltip != "" && root.enabled && ta.has-hover;
        triggered => {
            Tooltip.text = root.tooltip;
            Tooltip.x = root.absolute-position.x;
            Tooltip.y = root.absolute-position.y + root.height + 6px;
        }
    }

    property <bool> hovering: ta.has-hover;
    changed hovering => {
        if (!root.hovering && Tooltip.text == root.tooltip) {
            Tooltip.text = "";
        }
    }
}

// 提示气泡的传声筒。
//
// 气泡必须画在所有内容之上，而 Slint 里「画在最上层」= 出现在根组件的最后 ——
// 按钮自己画不到那儿去。于是按钮往这个 global 里写内容与坐标，
// `AppWindow` 末尾照它渲染一层。
export global Tooltip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
}

// 分段控件（segmented pill）。`options` 是标签数组，`current` 双向。
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    callback changed(int);

    height: 36px;
    border-radius: 9px;
    background: Theme.code-bg;
    min-width: row.min-width;

    row := HorizontalLayout {
        padding: 3px;
        spacing: 0px;

        for opt[i] in root.options: Rectangle {
            property <bool> on: i == root.current;
            border-radius: 7px;
            height: 30px;
            min-width: seg-label.min-width + 28px;
            background: on ? Theme.accent-soft : transparent;

            seg-label := Text {
                x: 14px;
                width: parent.width - 28px;
                height: 100%;
                text: opt;
                font-family: Theme.font-ui-medium;
                font-size: 13px;
                color: on ? Theme.accent-strong : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

// 单行输入框（原 widgets 里的 TextEdit 包装：field 底 + field_bd 边 + 聚焦光环）。
export component FerricLineEdit inherits Rectangle {
    in property <string> placeholder: "";
    in-out property <string> text;
    in property <bool> read-only: false;
    in property <bool> mono: false;
    // 左内边距。默认 12px；搜索框把放大镜画在里面时需要更大的留白。
    in property <length> pad-left: 12px;
    callback edited(string);
    callback accepted(string);
    height: 38px;
    border-radius: 9px;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-bd;
    // 不让内容撑宽：里面的 TextInput 不换行，一条 130 hex 的 SM2 公钥会把整个
    // 布局顶出可视区（实测国密工具右半边被裁掉）。给一个小的 min-width，
    // 超出部分由内层 clip 裁掉、随光标横向滚动。
    //
    // clip 放在**内层**而不是根节点：根节点裁的话连外面那圈聚焦光环
    //（x: -3px）一起没了。
    //
    // ⚠️ 里面那个 TextInput 的宽度**必须**等于 clip 框，不能按文本
    // `preferred-width` 撑开：撑开之后选区矩形是按 TextInput 自己的几何画的，
    // 而它比 clip 框宽得多 —— 全选一条长公钥时，蓝色选中条会从输入框里
    // 一路铺到侧栏上（用户报的就是这个）。
    min-width: 80px;
    // 让外部能 `focus()` 这个包装组件（命令面板打开即聚焦要用）。
    forward-focus: input;

    // 聚焦光环：外圈再画一层半透明主色（对位 egui 的 accent_ring）。
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 12px;
        border-width: 3px;
        border-color: input.has-focus ? Theme.accent-ring : transparent;
    }

    Rectangle {
        x: root.pad-left;
        y: 0;
        width: parent.width - root.pad-left - 12px;
        height: parent.height;
        clip: true;

        input := TextInput {
            width: 100%;
            height: parent.height;
            text <=> root.text;
            read-only: root.read-only;
            font-family: root.mono ? Theme.font-mono-medium : Theme.font-ui;
            font-size: 13.5px;
            color: Theme.fg;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: root.pad-left;
        width: parent.width - root.pad-left - 12px;
        height: 100%;
        text: root.placeholder;
        font-family: Theme.font-ui;
        font-size: 13.5px;
        color: Theme.faint;
        vertical-alignment: center;
    }
}

// 卡片容器：主内容区里那一格格的白/深底 + 圆角 + 细边。
export component Card inherits Rectangle {
    in property <length> pad: 16px;
    background: Theme.bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
}

// 提示条（toast）。存活时长由 Rust 侧控制（`TOAST_TTL`），这里只管样式与「×」。
//
// 级别：0 普通 / 1 警告 / 2 失败。失败的那条最需要被看见，用左侧色条标出来，
// 而不是把整块涂红 —— 白字在红底上读起来更累，且与「危险操作」按钮混淆。
export component Toast inherits Rectangle {
    in property <string> text;
    in property <int> level: 0;
    callback dismissed();

    property <color> mark: root.level == 2
        ? Theme.danger
        : (root.level == 1 ? #e0a23a : Theme.accent);

    height: max(40px, toast-label.min-height + 20px);
    border-radius: 10px;
    background: Theme.dark ? #232a33 : #2a3138;
    min-width: toast-label.min-width + 64px;

    // 左侧级别色条
    Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 2px;
        background: root.mark;
    }

    toast-label := Text {
        x: 14px;
        width: parent.width - 46px;
        height: 100%;
        text: root.text;
        font-family: Theme.font-ui-medium;
        font-size: 13px;
        color: #ffffff;
        vertical-alignment: center;
        wrap: word-wrap;
    }

    // 手动关掉：失败信息可能很长，用户读完就想清掉，不该等它自己走。
    close-ta := TouchArea {
        x: parent.width - 30px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        clicked => { root.dismissed(); }
        Text {
            width: 100%;
            height: 100%;
            text: Icons.x;
            font-family: Theme.font-icons;
            font-size: 12px;
            color: close-ta.has-hover ? #ffffff : rgba(255, 255, 255, 0.55);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}