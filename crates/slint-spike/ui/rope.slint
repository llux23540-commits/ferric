// Rope 风险验证：把一份大 JSON 灌进 Slint 原生 TextEdit，看内存与响应。
//
// 要回答的问题只有一个：**Slint 的 TextEdit 能不能扛住 ferric 的 JSON 工具**。
// egui 时代为此专门写了 egui-rope-editor（rope 存储 + 视口虚拟化 + 增量布局），
// 因为 egui 的 TextEdit 把整个字符串每帧重新布局，5MB 直接卡死。
//
// Slint 是 retained mode，理论上不重复布局；但 TextEdit 内部是否虚拟化、
// 输入时是否整篇重排，文档没说 —— 只能量。

import { TextEdit, Button, ComboBox } from "std-widgets.slint";

export component RopeSpike inherits Window {
    title: "Slint TextEdit · 大文本压力测试";
    preferred-width: 1100px;
    preferred-height: 760px;
    background: #0e1014;

    in-out property <string> payload;
    in property <string> stats: "—";
    in property <string> last-op: "—";

    callback load-size(int);
    callback measure-edit();
    callback clear-text();

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // 控制条
        Rectangle {
            height: 44px;
            background: #14171c;
            border-radius: 8px;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "载入";
                    color: #8a9099;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Button {
                    text: "0.5 MB";
                    clicked => { root.load-size(512); }
                }
                Button {
                    text: "1 MB";
                    clicked => { root.load-size(1024); }
                }
                Button {
                    text: "5 MB";
                    clicked => { root.load-size(5120); }
                }
                Button {
                    text: "10 MB";
                    clicked => { root.load-size(10240); }
                }
                Rectangle { width: 12px; }
                Button {
                    text: "在开头插入一个字符（计时）";
                    clicked => { root.measure-edit(); }
                }
                Button {
                    text: "清空";
                    clicked => { root.clear-text(); }
                }
            }
        }

        // 读数
        Rectangle {
            height: 56px;
            background: #14171c;
            border-radius: 8px;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 2px;
                Text {
                    text: root.stats;
                    color: #c8ccd2;
                    font-family: "JetBrainsMono-Medium";
                    font-size: 12px;
                }
                Text {
                    text: root.last-op;
                    color: #6ee7a8;
                    font-family: "JetBrainsMono-Medium";
                    font-size: 12px;
                }
            }
        }

        // 被测对象
        TextEdit {
            vertical-stretch: 1;
            text <=> root.payload;
            font-family: "JetBrainsMono-Medium";
            font-size: 13px;
            wrap: no-wrap;
        }
    }
}