                        sig-hex-edited(h) => { root.gm-sig-hex-edited(h); }
                        do-encrypt => { root.gm-encrypt(); }
                        do-decrypt => { root.gm-decrypt(); }
                        send-to-decrypt => { root.gm-send-to-decrypt(); }
