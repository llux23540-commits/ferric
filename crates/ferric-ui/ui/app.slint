                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-fold(w, r) => { root.editor-fold(w, r); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "crypto": CryptoView {
                        vertical-stretch: 1;
                        algos: root.crypto-algos;
                        enc-algo: root.crypto-enc-algo;
                        dec-algo: root.crypto-dec-algo;
                        enc-key <=> root.crypto-enc-key;
                        dec-key <=> root.crypto-dec-key;
                        enc-in: root.crypto-enc-in;
                        enc-out: root.crypto-enc-out;
                        dec-in: root.crypto-dec-in;
