import { Theme, Icons } from "theme.slint";

// 语法着色：一行的片段顺次排出来（`TokenLine.runs`），颜色种类与
// `editor_bridge::token_kind` 一一对应：
// 0 其它（含空白）/ 1 键 / 2 字符串 / 3 数字 / 4 true·false·null / 5 标点。
//
// 为什么不是「按 char 列绝对定位」：中文是双宽字符，一个 char 一格会让
// 相邻片段互相压字（实测中文键名整段糊在一起）。顺次排出来由字体决定宽度。
export struct TokenRun {
    text: string,
    kind: int,
}

export struct TokenLine {
    runs: [TokenRun],
}

// 一段横向高亮（选区 / 字符级差异）。`x` 与 `w` 的单位是**窄字宽的倍数**：
// 中文由回退字体渲染、步进比窄字宽大，按「一个 char 一格」算会整段错开。
export struct CellSpan {
    row: int,
    x: float,
    w: float,
}

export component CodeEditor inherits Rectangle {
    in property <[string]> lines;
    in property <[int]> line-nos;
    in property <int> first-line: 0;
    in property <int> total-lines: 1;
    in property <int> cursor-line: 0;
    // 光标横向位置（窄字宽的倍数，Rust 侧按真实字宽算好）
    in property <float> cursor-x: 0;
    in property <bool> cursor-visible: true;
    in property <[CellSpan]> selection-spans;
    in property <length> font-size: 13px;
    in property <length> line-height: 18px;
    in property <bool> show-gutter: true;
    in property <bool> read-only: false;
    // 折叠标记（与 `lines` 一一对应）：0 不是区块开头 / 1 可折叠 / 2 已折叠
    in property <[int]> fold-marks;
    in property <bool> foldable: false;
    // 差异种类（与 `lines` 一一对应）：0 相同 / 1 删除 / 2 新增
    in property <[int]> row-kinds;
    in property <bool> diffed: false;
    // 字符级高亮：改动行里被改掉的那几个字
    in property <[CellSpan]> emph-spans;
    // 语法着色：每个可见行一份片段序列。空 = 不着色，走纯文本那条。
    in property <[TokenLine]> tokens;
    in property <bool> highlighted: false;

    callback viewport-changed(int, int);
    /// 宽字符（中文等）的步进 / 窄字宽。字体一变就报一次，Rust 侧据此算横向坐标。
    callback wide-ratio-changed(float);
    /// 点击 / 拖动。第二个参数是横向位置（窄字宽的倍数），不是字符数。
    callback clicked(int, float, bool);
    callback dragged(int, float);
    callback triple-clicked();
    callback scrolled(int, int);
    callback scroll-to-line(int);
    /// 点了行号槽里的折叠箭头。参数是视口内行号。
    callback fold-toggled(int);
    /// 按键。`text` 是 Slint 的原始按键字符（功能键是约定码点，见文件末尾说明）。
    callback key-pressed(string/* text */, bool/* ctrl */, bool/* shift */);

    background: Theme.code-bg;
    border-radius: 9px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : Theme.border;
    forward-focus: focus;

    probe := Text {
        visible: false;
        text: "0";
        font-family: Theme.font-mono;
        font-size: root.font-size;
    }
    // 量一个宽字符：中文由回退字体渲染，步进不是窄字宽的整数倍，只能量。
    wide-probe := Text {
        visible: false;
        text: "字";
        font-family: Theme.font-mono;
        font-size: root.font-size;
    }
    property <length> char-w: probe.preferred-width;
    property <float> wide-ratio: root.char-w > 0
        ? wide-probe.preferred-width / root.char-w
        : 2;
    property <length> pad: 8px;
    property <int> visible-rows: max(1, floor((self.height - root.pad * 2) / root.line-height));
    property <int> visible-cols: max(1, floor((self.width - root.pad * 2) / root.char-w));

    changed visible-rows => { root.viewport-changed(root.visible-rows, root.visible-cols); }
    changed visible-cols => { root.viewport-changed(root.visible-rows, root.visible-cols); }
    // 字体 / 字号变了才会变，首帧也会来一次。
    changed wide-ratio => { root.wide-ratio-changed(root.wide-ratio); }
    init => { root.wide-ratio-changed(root.wide-ratio); }

    // 折叠列：只有这一屏真有区块开头时才占位，否则纯文本白让 18px
    property <length> fold-w: root.show-gutter && root.foldable ? 18px : 0px;
    // 差异符号列（-/+）：只有对比工具的编辑区会用到
    property <length> sign-w: root.show-gutter && root.diffed ? 14px : 0px;
    property <length> gutter-w: root.show-gutter
        ? (root.total-lines >= 100000 ? 62px
            : root.total-lines >= 10000 ? 54px
            : root.total-lines >= 1000 ? 46px : 38px) + root.fold-w + root.sign-w
        : 0px;

    // ===== 拖选到区域外的自动滚动 =====
    //
    // 指针离上/下沿多远（还在里面 = 0）。`touch` 在下面才声明 —— 同一个
    // 组件里的 id 是整体可见的，向后引用没问题。
    property <length> drag-out: !touch.pressed
        ? 0px
        : (touch.mouse-y < 0px
            ? -touch.mouse-y
            : (touch.mouse-y > root.height ? touch.mouse-y - root.height : 0px));
    // 方向：-1 往上、1 往下、0 不滚。
    property <int> autoscroll: root.drag-out <= 0px ? 0 : (touch.mouse-y < 0px ? -1 : 1);
    // 离得越远滚得越快 —— 一行一拍的话，往下选一千行要等半分钟。
    property <int> autoscroll-step: root.drag-out > 180px ? 8 : (root.drag-out > 70px ? 3 : 1);

    // ===== 行号槽（底色）=====
    //
    // 内缩 1px 并把左侧两个角圆掉：整块方角铺在 (0,0) 会把编辑区自己的
    // 1px 左边框连同左上/左下圆角一起盖成不透明底色 —— 逐像素量过，
    // 左缘从窗口白直接变成槽底色（用户报的「所有输入框左边没有边框」）。
    // 靠根节点 `clip` 解决不了：Slint 的 clip 只按矩形裁，不认圆角。
    if root.show-gutter: Rectangle {
        x: 1px;
        y: 1px;
        width: root.gutter-w - 1px;
        height: parent.height - 2px;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        background: Theme.dark ? #0d1014 : #f1f3f6;
    }

    // ===== 行号槽（内容）=====
    //
    // 与底色分开画，坐标系保持和正文区一致：行号要和它那一行严格同基线，
    // 跟着底色一起内缩 1px 就会整槽下移一像素、与右边的文字错开。
    if root.show-gutter: Rectangle {
        x: 0;
        y: 0;
        width: root.gutter-w;
        height: parent.height;
        background: transparent;

        for no[i] in root.line-nos: Text {
            x: root.fold-w;
            y: root.pad + i * root.line-height;
            width: root.gutter-w - root.fold-w - root.sign-w - 8px;
            height: root.line-height;
            text: no;
            font-family: Theme.font-mono;
            font-size: root.font-size - 1px;
            color: i == root.cursor-line ? Theme.fg-soft : Theme.faint;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        // 折叠箭头。已折叠 → 朝右（还有东西收着），展开 → 朝下。
        for mark[i] in root.fold-marks: Rectangle {
            x: 0;
            y: root.pad + i * root.line-height;
            width: root.fold-w;
            height: root.line-height;
            visible: mark != 0;

            Text {
                width: 100%;
                height: 100%;
                text: mark == 2 ? Icons.chevron-right : Icons.chevron-down;
                font-family: Theme.font-icons;
                font-size: 14px;
                // 未折叠的箭头平时压得很淡：一屏几十个箭头全画实了会盖过行号。
                color: fold-ta.has-hover
                    ? Theme.accent
                    : (mark == 2 ? Theme.fg-soft : Theme.faint);
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            fold-ta := TouchArea {
                enabled: mark != 0;
                mouse-cursor: pointer;
                clicked => { root.fold-toggled(i); }
            }
        }

        // 差异符号：删除 `-`、新增 `+`（git 的记号）。
        for kind[i] in root.row-kinds: Text {
            x: root.gutter-w - root.sign-w - 3px;
            y: root.pad + i * root.line-height;
            width: root.sign-w;
            height: root.line-height;
            text: kind == 1 ? "-" : kind == 2 ? "+" : "";
            font-family: Theme.font-mono-medium;
            font-size: root.font-size;
            color: kind == 1 ? Theme.danger : Theme.ok;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            height: parent.height;
            background: Theme.border;
        }
    }

    // ===== 正文区 =====
    Rectangle {
        x: root.gutter-w;
        y: 0;
        width: parent.width - root.gutter-w;
        height: parent.height;
        clip: true;

        // 差异底色：删除行偏红、新增行偏绿，整行铺满（git 的读法）。
        // 画在最底层 —— 选区与字符级高亮要能盖在它上面。
        for kind[i] in root.row-kinds: Rectangle {
            x: 0;
            y: root.pad + i * root.line-height;
            width: parent.width;
            height: root.line-height;
            background: kind == 1 ? Theme.del-bg : kind == 2 ? Theme.add-bg : transparent;
        }

        // 字符级高亮：改动行里被改掉的那几个字，底色比整行再深一档。
        for span[i] in root.emph-spans: Rectangle {
            x: root.pad + span.x * root.char-w;
            y: root.pad + span.row * root.line-height;
            width: span.w * root.char-w;
            height: root.line-height;
            background: root.row-kinds[span.row] == 1 ? Theme.del-mark : Theme.add-mark;
        }

        // 选区高亮（画在文本下面）
        for span[i] in root.selection-spans: Rectangle {
            x: root.pad + span.x * root.char-w;
            y: root.pad + span.row * root.line-height;
            width: span.w * root.char-w;
            height: root.line-height;
            background: Theme.accent-soft;
        }

        // 无语法着色：一行一个 Text（绝大多数编辑区走这条）。
        if !root.highlighted: Rectangle {
            width: 100%;
            height: 100%;
            for line[i] in root.lines: Text {
                x: root.pad;
                y: root.pad + i * root.line-height;
                width: parent.width - root.pad;
                height: root.line-height;
                text: line;
                font-family: Theme.font-mono;
                font-size: root.font-size;
                color: Theme.fg;
                vertical-alignment: center;
                // 不换行：换行会让「一行 = 一个 y 坐标」的前提失效，
                // 光标与选区的坐标换算全部作废。横向滚动由 Rust 侧裁剪。
                wrap: no-wrap;
            }
        }

        // 有语法着色：一行的片段顺次排出来。宽度交给字体（中文双宽），
        // 所以不会像「一个 char 一格」那样把相邻片段压在一起。
        if root.highlighted: Rectangle {
            width: 100%;
            height: 100%;
            for line[i] in root.tokens: HorizontalLayout {
                x: root.pad;
                y: root.pad + i * root.line-height;
                height: root.line-height;
                alignment: start;
                spacing: 0px;
                for t in line.runs: Text {
                    text: t.text;
                    font-family: Theme.font-mono;
                    font-size: root.font-size;
                    color: t.kind == 1 ? Theme.code-key
                        : t.kind == 2 ? Theme.code-str
                        : t.kind == 3 ? Theme.code-num
                        : t.kind == 4 ? Theme.code-lit
                        : t.kind == 5 ? Theme.code-punct
                        : Theme.fg;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }
        }

        if root.cursor-visible && focus.has-focus && !root.read-only: Rectangle {
            x: root.pad + root.cursor-x * root.char-w;
            y: root.pad + root.cursor-line * root.line-height;
            width: 2px;
            height: root.line-height;
            background: Theme.accent;
        }

        touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: text;

            property <int> hit-line: max(0, floor((self.mouse-y - root.pad) / root.line-height));
            // 命中位置按**窄字宽的倍数**报给 Rust（不四舍五入成字符数）：
            // 中文一个字宽过一格，取整会让光标落在别的字上。
            property <float> hit-cells: max(0, (self.mouse-x - root.pad) / root.char-w);

            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    // 必须显式抢焦点：键盘事件走 FocusScope，而点击落在 TouchArea 上。
                    // 少了这一行的表现是「光标能点、字打不进去」。
                    focus.focus();
                    // Shift+点 = 从原锚点扩到这里（各家编辑器的通例）。原来这里
                    // 硬写 false，于是「点开头 → 翻页 → Shift+点结尾」选不出东西，
                    // 超过一屏的选区用鼠标根本做不出来。
                    root.clicked(self.hit-line, self.hit-cells, ev.modifiers.shift);
                }
            }
            moved => {
                if (self.pressed) {
                    root.dragged(self.hit-line, self.hit-cells);
                }
            }
            double-clicked => { root.triple-clicked(); }
            scroll-event(ev) => {
                // delta 是 length，要除以 1px 才能当数字用（单位系统是强类型的）
                root.scrolled(-round(ev.delta-y / 40px), -round(ev.delta-x / 40px));
                accept
            }
        }

        // 拖出上/下沿之后继续滚 —— 指针被 TouchArea 抓着，停在区域外就不再有
        // `moved`，选区会卡在最后一个可见行：实测按住往窗口外拖再久，选中的
        // 也只有一屏。每跳一拍滚几行、顺手把选区扩到新的首/末行。
        Timer {
            interval: 40ms;
            running: root.autoscroll != 0;
            triggered => {
                root.scrolled(root.autoscroll * root.autoscroll-step, 0);
                root.dragged(root.autoscroll < 0 ? 0 : root.visible-rows - 1, touch.hit-cells);
            }
        }
    }


    // ===== 纵向滚动条 =====
    if root.total-lines > root.visible-rows: Rectangle {
        x: parent.width - 10px;
        y: 2px;
        width: 8px;
        height: parent.height - 4px;

        property <float> frac-visible: min(1.0, root.visible-rows / max(1, root.total-lines));
        property <float> frac-pos: root.first-line / max(1, root.total-lines);

        Rectangle {
            x: 1px;
            width: 6px;
            y: parent.height * parent.frac-pos;
            height: max(24px, parent.height * parent.frac-visible);
            border-radius: 3px;
            background: bar.has-hover || bar.pressed ? Theme.muted : Theme.border-2;
        }

        bar := TouchArea {
            moved => {
                if (self.pressed) {
                    root.scroll-to-line(round((self.mouse-y / parent.height) * root.total-lines));
                }
            }
        }
    }
    // ===== 键盘 =====
    //
    // 刻意**不在这里分派按键**：原本写成一串 `if (ev.text == Key.Backspace) …`
    // （十三个分支），Slint 编译器在那上面**栈溢出**（`has overflowed its stack`）。
    // 改成把原始 `ev.text` 直接交给 Rust —— Slint 的功能键就是约定好的码点
    // （Backspace = U+0008、方向键 = U+F700..F703 等，见 i-slint-common 的
    // key_codes.rs），Rust 侧 match 一下即可，顺便省掉这层重复。
    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(ev) => {
            root.key-pressed(ev.text, ev.modifiers.control, ev.modifiers.shift);
            accept
        }
    }
}