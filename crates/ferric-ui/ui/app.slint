                        generate => { root.rsa-generate(); }
                        copy-pub => { root.rsa-copy-pub(); }
                        copy-priv => { root.rsa-copy-priv(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
