// Ferric 外壳（Slint 版）。
//
// 对位原 egui 版的结构：自绘无边框窗口（标题栏 44px）+ 可搜索侧栏（默认 264px）
// + 主内容区 + 设置浮层 + toast 区。
//
// 与 egui 版的关键差别：这里是 retained mode —— 状态放在 property 上，Rust 侧用
// setter 灌数据、用 callback 收事件；不再每帧重跑 UI 代码。

import { Theme } from "theme.slint";
// 把 Theme 再导出一次：Slint 只为**本文件导出**的 global 生成 Rust 侧类型，
// 光 import 进来不够 —— Rust 需要 `win.global::<Theme>()` 来切深浅色。
export { Theme }
import { FieldLabel, FerricButton, IconButton, Segmented, FerricLineEdit, Card, Toast } from "widgets.slint";
import { CodeEditor } from "editor.slint";
import { ScrollView, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";

// 侧栏一行工具。
struct ToolEntry {
    id: string,
    name: string,
    desc: string,
    icon: string,
    group: string,
    // 是否已迁到 Slint（false = 显示「迁移中」占位）
    migrated: bool,
    favorite: bool,
    // 是否通过当前搜索过滤（Rust 侧按 name / desc / keywords 计算）
    visible: bool,
}

// 一条正则匹配结果（已由 Rust 侧摊平成可直接显示的形状）。
struct RegexMatch {
    label: string,
    text: string,
    groups: [string],
}

// 插件 manifest 声明的一个选项控件。
// kind: 0 分段 / 1 开关 / 2 文本
struct PluginOption {
    kind: int,
    label: string,
    values: [string],
    selected: int,
    on: bool,
    text: string,
    hint: string,
}

// 插件市场的一张卡片。
struct PluginCard {
    slug: string,
    name: string,
    desc: string,
    version: string,
    installed: string,
    has-update: bool,
    is-installed: bool,
    size-text: string,
    downloads-text: string,
    // 这张卡正在安装
    busy: bool,
}

// 差异结果的一个行内片段。emph = 被改动的部分（加深底色）。
struct DiffSeg {
    text: string,
    emph: bool,
}

// 差异结果的一行。
struct DiffRow {
    sign: string,
    left-no: string,
    right-no: string,
    segs: [DiffSeg],
    // 0 相同 / 1 删除 / 2 新增 —— 决定整行底色
    kind: int,
}

// 时区列表里的一项。
struct TzRow {
    name: string,
    label: string,
}

// UUID 工具的一次执行记录。
struct UuidHistEntry {
    label: string,
    body: string,
}

// 一个编辑区的全部可见状态。
//
// 打包成 struct 而不是散成十几个 property：编辑区会被每个文本类工具用到
//（json / diff 各两个、yaml / sql / regex / crypto / gm …），散着写等于
// 每加一个工具就往 AppWindow 上堆十几行。
struct EditorState {
    // 当前可见的那几十行（已由 Rust 侧按滚动位置与横向偏移裁好）
    lines: [string],
    // 视口顶端的绝对行号，行号槽显示用
    first-line: int,
    // 文档总行数，滚动条比例用
    total-lines: int,
    // 光标的视口内坐标
    cursor-line: int,
    cursor-col: int,
    cursor-visible: bool,
    // 选区高亮 (视口行, 起列, 列数)，已裁到视口内
    selection-spans: [[int]],
}

// 带标题栏的编辑区面板。
//
// `which` 是编辑区标识（如 "yaml-in" / "json-out"），所有回调都把它带回去 ——
// Rust 侧一个 match 就能分派到对应的 TextBuffer，不必为每个编辑区接一遍回调。
component EditorPane inherits Rectangle {
    in property <string> title;
    in property <string> which;
    in property <EditorState> state;
    in property <bool> read-only: false;
    in property <string> hint: "";

    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            FieldLabel {
                text: root.title;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.state.total-lines + " 行";
                font-family: Theme.font-mono;
                font-size: 11px;
                color: Theme.faint;
                vertical-alignment: center;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-family: Theme.font-ui;
                font-size: 11px;
                color: Theme.faint;
                vertical-alignment: center;
            }
        }

        CodeEditor {
            vertical-stretch: 1;
            lines: root.state.lines;
            first-line: root.state.first-line;
            total-lines: root.state.total-lines;
            cursor-line: root.state.cursor-line;
            cursor-col: root.state.cursor-col;
            cursor-visible: root.state.cursor-visible;
            selection-spans: root.state.selection-spans;
            read-only: root.read-only;

            viewport-changed(r, c) => { root.editor-viewport(root.which, r, c); }
            clicked(l, c, e) => { root.editor-click(root.which, l, c, e); }
            dragged(l, c) => { root.editor-drag(root.which, l, c); }
            triple-clicked => { root.editor-triple(root.which); }
            scrolled(dl, dc) => { root.editor-scroll(root.which, dl, dc); }
            scroll-to-line(l) => { root.editor-scroll-line(root.which, l); }
            key-pressed(t, ctrl, shift) => { root.editor-key(root.which, t, ctrl, shift); }
        }
    }
}

// ——— JSON → YAML（已迁移） ———
component YamlView inherits Rectangle {
    in property <EditorState> input-state;
    in property <EditorState> output-state;
    in property <bool> ok: true;
    in property <string> status;

    callback load-sample();
    callback clear-input();
    callback copy-output();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // 工具条
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "示例";
                clicked => { root.load-sample(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
            }
            FerricButton {
                text: "复制 YAML";
                variant: "primary";
                clicked => { root.copy-output(); }
            }
        }

        // 左输入 / 右输出
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            EditorPane {
                title: "JSON 输入";
                which: "yaml-in";
                state: root.input-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
            EditorPane {
                title: "YAML 输出";
                which: "yaml-out";
                state: root.output-state;
                read-only: true;
                hint: "只读";
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

// ——— SQL 格式化（已迁移） ———
component SqlView inherits Rectangle {
    in property <EditorState> input-state;
    in property <bool> uppercase: true;
    in property <string> status;

    callback do-format();
    callback do-minify();
    callback toggle-uppercase();
    callback clear-input();
    callback copy-input();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "格式化";
                variant: "primary";
                clicked => { root.do-format(); }
            }
            FerricButton {
                text: "压缩为单行";
                clicked => { root.do-minify(); }
            }
            // 关键字大写：用分段控件表达开关，与设置页同一套语言
            Segmented {
                options: ["关键字大写", "原样"];
                current: root.uppercase ? 0 : 1;
                changed(i) => { root.toggle-uppercase(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
            }
            FerricButton {
                text: "复制";
                variant: "subtle";
                clicked => { root.copy-input(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
        }

        EditorPane {
            title: "SQL";
            which: "sql-in";
            state: root.input-state;
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }
    }
}

// 正则标志的独立开关。不用分段控件：五个标志可以任意组合，
// 分段控件表达的是互斥选择，语义不对。
component FlagChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();

    height: 30px;
    min-width: chip-label.min-width + 20px;
    border-radius: 7px;
    background: root.on
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.border : Theme.code-bg);

    chip-label := Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text: root.label;
        font-family: Theme.font-ui-medium;
        font-size: 12px;
        color: root.on ? Theme.accent-strong : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ——— 正则表达式（已迁移） ———
component RegexView inherits Rectangle {
    in-out property <string> pattern;
    in property <bool> fg;
    in property <bool> fi;
    in property <bool> fm;
    in property <bool> fs;
    in property <bool> fx;
    in property <EditorState> text-state;
    in property <[RegexMatch]> matches;
    in property <bool> ok: true;
    in property <string> status;

    callback pattern-edited(string);
    callback toggle-flag(int);
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // 模式 + 标志
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                FieldLabel { text: "模式"; }
                FerricLineEdit {
                    text <=> root.pattern;
                    placeholder: "如 (\\w+)@(\\w+\\.\\w+)";
                    mono: true;
                    edited(t) => { root.pattern-edited(t); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    FieldLabel { text: "标志"; vertical-alignment: center; }
                    // 五个标志各是一个独立开关（不是互斥分段）
                    FlagChip { label: "g 全局"; on: root.fg; clicked => { root.toggle-flag(0); } }
                    FlagChip { label: "i 忽略大小写"; on: root.fi; clicked => { root.toggle-flag(1); } }
                    FlagChip { label: "m 多行"; on: root.fm; clicked => { root.toggle-flag(2); } }
                    FlagChip { label: "s 点匹配换行"; on: root.fs; clicked => { root.toggle-flag(3); } }
                    FlagChip { label: "x 忽略空白"; on: root.fx; clicked => { root.toggle-flag(4); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.status;
                        font-family: Theme.font-ui;
                        font-size: 12px;
                        color: root.ok ? Theme.muted : Theme.danger;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 待匹配文本 / 匹配结果
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            EditorPane {
                title: "待匹配文本";
                which: "regex-in";
                state: root.text-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                HorizontalLayout {
                    FieldLabel { text: "匹配结果"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.matches.length + " 处";
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            alignment: start;
                            for m in root.matches: Rectangle {
                                background: Theme.bg;
                                border-radius: 7px;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: m.label;
                                            font-family: Theme.font-mono;
                                            font-size: 11px;
                                            color: Theme.faint;
                                        }
                                        Text {
                                            text: m.text;
                                            font-family: Theme.font-mono-medium;
                                            font-size: 12.5px;
                                            color: Theme.accent-strong;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    for g[gi] in m.groups: Text {
                                        text: "  $" + (gi + 1) + " = " + g;
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— RSA 密钥对（已迁移） ———
component RsaView inherits Rectangle {
    in property <int> bits-index;
    in property <bool> busy;
    in property <bool> ok: true;
    in property <string> status;
    in property <EditorState> pub-state;
    in property <EditorState> priv-state;

    callback bits-changed(int);
    callback generate();
    callback copy-pub();
    callback copy-priv();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            FieldLabel { text: "位数"; vertical-alignment: center; }
            Segmented {
                options: ["1024", "2048", "3072", "4096"];
                current: root.bits-index;
                changed(i) => { root.bits-changed(i); }
            }
            FerricButton {
                text: root.busy ? "生成中…" : "生成";
                variant: "primary";
                enabled: !root.busy;
                clicked => { root.generate(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                EditorPane {
                    title: "公钥 (PEM)";
                    which: "rsa-pub-out";
                    state: root.pub-state;
                    read-only: true;
                    hint: "只读";
                    vertical-stretch: 1;
                    editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                    editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                    editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                    editor-triple(w) => { root.editor-triple(w); }
                    editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                    editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                    editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                }
                FerricButton {
                    text: "复制公钥";
                    clicked => { root.copy-pub(); }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                EditorPane {
                    title: "私钥 (PEM)";
                    which: "rsa-priv-out";
                    state: root.priv-state;
                    read-only: true;
                    // 提醒用户这东西不会被存下来 —— 关掉窗口就没了
                    hint: "只读 · 不持久化";
                    vertical-stretch: 1;
                    editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                    editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                    editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                    editor-triple(w) => { root.editor-triple(w); }
                    editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                    editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                    editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                }
                FerricButton {
                    text: "复制私钥";
                    clicked => { root.copy-priv(); }
                }
            }
        }
    }
}

// 加密 / 解密的一侧。两侧同构，收成一个组件 —— 散着写等于同一段抄两遍。
component CryptoSide inherits Rectangle {
    in property <string> title;
    in property <string> action-label;
    in property <string> which-in;
    in property <string> which-out;
    in property <[string]> algos;
    in property <int> algo-index;
    in-out property <string> key;
    in property <EditorState> input-state;
    in property <EditorState> output-state;
    in property <bool> ok: true;
    in property <string> status;
    in property <string> input-title;
    in property <string> output-title;

    callback algo-changed(int);
    callback key-edited(string);
    callback run();
    callback copy-output();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        spacing: 8px;

        Text {
            text: root.title;
            font-family: Theme.font-ui-semibold;
            font-size: 14px;
            color: Theme.fg;
        }

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                spacing: 4px;
                width: 40%;
                FieldLabel { text: "算法"; }
                ComboBox {
                    model: root.algos;
                    current-index: root.algo-index;
                    selected(v) => { root.algo-changed(self.current-index); }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                FieldLabel { text: "口令（不持久化）"; }
                FerricLineEdit {
                    text <=> root.key;
                    placeholder: "口令";
                    edited(t) => { root.key-edited(t); }
                }
            }
        }

        EditorPane {
            title: root.input-title;
            which: root.which-in;
            state: root.input-state;
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }

        HorizontalLayout {
            spacing: 8px;
            FerricButton {
                text: root.action-label;
                variant: "primary";
                clicked => { root.run(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 11.5px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
                overflow: elide;
            }
            FerricButton {
                text: "复制";
                variant: "subtle";
                clicked => { root.copy-output(); }
            }
        }

        EditorPane {
            title: root.output-title;
            which: root.which-out;
            state: root.output-state;
            read-only: true;
            hint: "只读";
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }
    }
}

// ——— 加密 / 解密文本（已迁移） ———
component CryptoView inherits Rectangle {
    in property <[string]> algos;
    in property <int> enc-algo;
    in property <int> dec-algo;
    in-out property <string> enc-key;
    in-out property <string> dec-key;
    in property <EditorState> enc-in;
    in property <EditorState> enc-out;
    in property <EditorState> dec-in;
    in property <EditorState> dec-out;
    in property <bool> enc-ok: true;
    in property <bool> dec-ok: true;
    in property <string> enc-status;
    in property <string> dec-status;

    callback enc-algo-changed(int);
    callback dec-algo-changed(int);
    callback enc-key-edited(string);
    callback dec-key-edited(string);
    callback do-encrypt();
    callback do-decrypt();
    callback send-to-decrypt();
    callback copy-enc();
    callback copy-dec();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            alignment: start;
            FerricButton {
                text: "把密文送去解密";
                icon: "→";
                clicked => { root.send-to-decrypt(); }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            CryptoSide {
                horizontal-stretch: 1;
                title: "加密";
                action-label: "加密";
                which-in: "crypto-enc-in";
                which-out: "crypto-enc-out";
                input-title: "明文";
                output-title: "密文 (Base64)";
                algos: root.algos;
                algo-index: root.enc-algo;
                key <=> root.enc-key;
                input-state: root.enc-in;
                output-state: root.enc-out;
                ok: root.enc-ok;
                status: root.enc-status;
                algo-changed(i) => { root.enc-algo-changed(i); }
                key-edited(k) => { root.enc-key-edited(k); }
                run => { root.do-encrypt(); }
                copy-output => { root.copy-enc(); }
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }

            CryptoSide {
                horizontal-stretch: 1;
                title: "解密";
                action-label: "解密";
                which-in: "crypto-dec-in";
                which-out: "crypto-dec-out";
                input-title: "密文 (Base64)";
                output-title: "明文";
                algos: root.algos;
                algo-index: root.dec-algo;
                key <=> root.dec-key;
                input-state: root.dec-in;
                output-state: root.dec-out;
                ok: root.dec-ok;
                status: root.dec-status;
                algo-changed(i) => { root.dec-algo-changed(i); }
                key-edited(k) => { root.dec-key-edited(k); }
                run => { root.do-decrypt(); }
                copy-output => { root.copy-dec(); }
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

// ——— 国密 SM（已迁移） ———
component GmView inherits Rectangle {
    // 密钥对
    in-out property <string> pub-key;
    in-out property <string> priv-key;
    in property <string> key-status;
    // 加密 / 解密
    in property <[string]> enc-algos;
    in property <[string]> dec-algos;
    in property <[string]> fmts;
    in property <int> enc-algo;
    in property <int> dec-algo;
    in property <int> fmt-index;
    in property <bool> enc-needs-key: true;
    in property <string> enc-key-label: "口令";
    in property <string> dec-key-label: "口令";
    in-out property <string> enc-key;
    in-out property <string> dec-key;
    in property <EditorState> enc-in;
    in property <EditorState> enc-out;
    in property <EditorState> dec-in;
    in property <EditorState> dec-out;
    in property <bool> enc-ok: true;
    in property <bool> dec-ok: true;
    in property <string> enc-status;
    in property <string> dec-status;
    // 签名
    in property <EditorState> sig-state;
    in-out property <string> sig-hex;
    in property <bool> sig-ok: true;
    in property <string> sig-status;

    callback gen-keypair();
    callback derive-pub();
    callback enc-algo-changed(int);
    callback dec-algo-changed(int);
    callback fmt-changed(int);
    callback enc-key-edited(string);
    callback dec-key-edited(string);
    callback pub-key-edited(string);
    callback priv-key-edited(string);
    callback sig-hex-edited(string);
    callback do-encrypt();
    callback do-decrypt();
    callback send-to-decrypt();
    callback do-sign();
    callback do-verify();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    // 只允许纵向滚动：内容宽度钉在可视宽度上。不钉的话长公钥 / 双栏编辑区
    // 会把布局顶出右边界（实测右半边被裁掉），而横向滚动条对这种表单没意义。
    ScrollView {
        VerticalLayout {
            width: root.width;
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // ===== SM2 密钥对 =====
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SM2 密钥对";
                            font-family: Theme.font-ui-semibold;
                            font-size: 14px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        FerricButton {
                            text: "生成密钥对";
                            variant: "primary";
                            clicked => { root.gen-keypair(); }
                        }
                        FerricButton {
                            text: "由私钥推公钥";
                            clicked => { root.derive-pub(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.key-status;
                            font-family: Theme.font-ui;
                            font-size: 11.5px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            FieldLabel { text: "公钥"; }
                            FerricLineEdit {
                                text <=> root.pub-key;
                                placeholder: "04…";
                                mono: true;
                                edited(t) => { root.pub-key-edited(t); }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            FieldLabel { text: "私钥"; }
                            FerricLineEdit {
                                text <=> root.priv-key;
                                placeholder: "hex";
                                mono: true;
                                edited(t) => { root.priv-key-edited(t); }
                            }
                        }
                    }
                }
            }

            // ===== 加密 / 解密 =====
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "加密 / 解密";
                            font-family: Theme.font-ui-semibold;
                            font-size: 14px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        FieldLabel { text: "SM2 密文排布"; vertical-alignment: center; }
                        ComboBox {
                            model: root.fmts;
                            current-index: root.fmt-index;
                            selected(v) => { root.fmt-changed(self.current-index); }
                        }
                        FerricButton {
                            text: "把密文送去解密";
                            clicked => { root.send-to-decrypt(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        // 加密侧
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    width: 45%;
                                    FieldLabel { text: "算法"; }
                                    ComboBox {
                                        model: root.enc-algos;
                                        current-index: root.enc-algo;
                                        selected(v) => { root.enc-algo-changed(self.current-index); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    // SM3 是摘要，没有口令可言 —— 那一栏整体隐掉，
                                    // 比留一个灰掉的空框清楚
                                    FieldLabel {
                                        text: root.enc-needs-key ? root.enc-key-label : "（SM3 摘要，无需口令）";
                                    }
                                    if root.enc-needs-key: FerricLineEdit {
                                        text <=> root.enc-key;
                                        mono: true;
                                        edited(t) => { root.enc-key-edited(t); }
                                    }
                                }
                            }
                            EditorPane {
                                title: "输入";
                                which: "gm-enc-in";
                                state: root.enc-in;
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                FerricButton {
                                    text: "加密 / 摘要";
                                    variant: "primary";
                                    clicked => { root.do-encrypt(); }
                                }
                                Text {
                                    text: root.enc-status;
                                    font-family: Theme.font-ui;
                                    font-size: 11.5px;
                                    color: root.enc-ok ? Theme.muted : Theme.danger;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            EditorPane {
                                title: "输出 (hex)";
                                which: "gm-enc-out";
                                state: root.enc-out;
                                read-only: true;
                                hint: "只读";
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                        }

                        // 解密侧
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    width: 45%;
                                    FieldLabel { text: "算法"; }
                                    ComboBox {
                                        model: root.dec-algos;
                                        current-index: root.dec-algo;
                                        selected(v) => { root.dec-algo-changed(self.current-index); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    FieldLabel { text: root.dec-key-label; }
                                    FerricLineEdit {
                                        text <=> root.dec-key;
                                        mono: true;
                                        edited(t) => { root.dec-key-edited(t); }
                                    }
                                }
                            }
                            EditorPane {
                                title: "密文 (hex)";
                                which: "gm-dec-in";
                                state: root.dec-in;
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                FerricButton {
                                    text: "解密";
                                    variant: "primary";
                                    clicked => { root.do-decrypt(); }
                                }
                                Text {
                                    text: root.dec-status;
                                    font-family: Theme.font-ui;
                                    font-size: 11.5px;
                                    color: root.dec-ok ? Theme.muted : Theme.danger;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            EditorPane {
                                title: "明文";
                                which: "gm-dec-out";
                                state: root.dec-out;
                                read-only: true;
                                hint: "只读";
                                height: 150px;
                                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                                editor-triple(w) => { root.editor-triple(w); }
                                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                            }
                        }
                    }
                }
            }

            // ===== 签名 / 验签 =====
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "SM2 签名 / 验签";
                            font-family: Theme.font-ui-semibold;
                            font-size: 14px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        FerricButton {
                            text: "签名（用私钥）";
                            variant: "primary";
                            clicked => { root.do-sign(); }
                        }
                        FerricButton {
                            text: "验签（用公钥）";
                            clicked => { root.do-verify(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.sig-status;
                            font-family: Theme.font-ui-medium;
                            font-size: 12px;
                            color: root.sig-ok ? Theme.ok : Theme.danger;
                            vertical-alignment: center;
                        }
                    }
                    EditorPane {
                        title: "待签名 / 待验签文本";
                        which: "gm-sig-in";
                        state: root.sig-state;
                        height: 130px;
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: "签名 (hex)"; }
                        FerricLineEdit {
                            text <=> root.sig-hex;
                            placeholder: "签名结果，也可粘入他人的签名做验签";
                            mono: true;
                            edited(t) => { root.sig-hex-edited(t); }
                        }
                    }
                }
            }
        }
    }
}

// ——— 时间戳（已迁移） ———
component TimestampView inherits Rectangle {
    in property <string> now-text;
    in property <string> now-ms-text;
    in property <bool> running;
    in property <string> offset;
    in property <string> tz-label;
    in-out property <string> tz-filter;
    in property <[TzRow]> tz-hits;
    in-out property <string> ts-input;
    in property <string> ts-output;
    in property <bool> ts-ok: true;
    in-out property <string> date-input;
    in property <string> date-output;
    in property <bool> date-ok: true;

    callback toggle-running();
    callback refresh-now();
    callback use-now();
    callback copy-now();
    callback filter-edited(string);
    callback select-tz(string);
    callback ts-edited(string);
    callback date-edited(string);

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        // ===== 当前时间戳 =====
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    FieldLabel { text: "当前 Unix 时间戳"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.offset;
                        font-family: Theme.font-mono;
                        font-size: 11.5px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                    Segmented {
                        options: ["实时刷新", "手动"];
                        current: root.running ? 0 : 1;
                        changed(i) => { root.toggle-running(); }
                    }
                    if !root.running: FerricButton {
                        text: "刷新";
                        clicked => { root.refresh-now(); }
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: root.now-text;
                        font-family: Theme.font-mono-medium;
                        font-size: 22px;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.now-ms-text;
                        font-family: Theme.font-mono;
                        font-size: 13px;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    FerricButton {
                        text: "填入下方";
                        clicked => { root.use-now(); }
                    }
                    FerricButton {
                        text: "复制";
                        variant: "subtle";
                        clicked => { root.copy-now(); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            // ===== 双向转换 =====
            VerticalLayout {
                spacing: 12px;
                horizontal-stretch: 1;

                Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        FieldLabel { text: "时间戳 → 日期时间（秒 / 毫秒自动识别）"; }
                        FerricLineEdit {
                            text <=> root.ts-input;
                            placeholder: "1700000000 或 1700000000000";
                            mono: true;
                            edited(t) => { root.ts-edited(t); }
                        }
                        Text {
                            text: root.ts-output;
                            font-family: Theme.font-mono-medium;
                            font-size: 13px;
                            color: root.ts-ok ? Theme.accent-strong : Theme.danger;
                            wrap: word-wrap;
                        }
                    }
                }

                Card {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        FieldLabel { text: "日期时间 → 时间戳"; }
                        FerricLineEdit {
                            text <=> root.date-input;
                            placeholder: "2023-11-14 22:13:20";
                            mono: true;
                            edited(t) => { root.date-edited(t); }
                        }
                        Text {
                            text: root.date-output;
                            font-family: Theme.font-mono-medium;
                            font-size: 13px;
                            color: root.date-ok ? Theme.accent-strong : Theme.danger;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            // ===== 时区选择 =====
            VerticalLayout {
                spacing: 6px;
                width: 40%;
                HorizontalLayout {
                    FieldLabel { text: "目标时区"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.tz-hits.length + " / 597";
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        color: Theme.faint;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.tz-label;
                    font-family: Theme.font-mono-medium;
                    font-size: 12.5px;
                    color: Theme.accent-strong;
                    overflow: elide;
                }
                FerricLineEdit {
                    placeholder: "搜索时区（支持中文，如「上海」）";
                    text <=> root.tz-filter;
                    edited(t) => { root.filter-edited(t); }
                }
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            alignment: start;
                            for z in root.tz-hits: Rectangle {
                                height: 26px;
                                border-radius: 5px;
                                background: tz-ta.has-hover ? Theme.border : transparent;
                                Text {
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 100%;
                                    text: z.label;
                                    font-family: Theme.font-ui;
                                    font-size: 12px;
                                    color: Theme.fg-soft;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                tz-ta := TouchArea {
                                    clicked => { root.select-tz(z.name); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— JSON 工具（已迁移） ———
component JsonView inherits Rectangle {
    in property <EditorState> input-state;
    in property <int> indent-index;
    in property <bool> sort;
    in property <bool> wrap;
    in property <bool> ok: true;
    in property <string> status;
    in-out property <string> find;
    in property <int> hit-count;
    in property <int> hit-index;
    in property <bool> can-undo;
    in property <bool> can-redo;

    callback do-format();
    callback do-minify();
    callback do-escape();
    callback do-unescape();
    callback toggle-sort();
    callback toggle-wrap();
    callback indent-changed(int);
    callback clear-input();
    callback copy-output();
    callback do-undo();
    callback do-redo();
    callback find-edited(string);
    callback do-search();
    callback next-hit();
    callback prev-hit();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // 工具条
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            FerricButton {
                text: "格式化";
                variant: "primary";
                clicked => { root.do-format(); }
            }
            FerricButton {
                text: "压缩";
                clicked => { root.do-minify(); }
            }
            FerricButton {
                text: "转义";
                clicked => { root.do-escape(); }
            }
            FerricButton {
                text: "去转义";
                clicked => { root.do-unescape(); }
            }
            Rectangle { width: 6px; }
            Segmented {
                options: ["2 空格", "4 空格", "Tab"];
                current: root.indent-index;
                changed(i) => { root.indent-changed(i); }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                icon: "↶";
                icon-size: 15px;
                enabled: root.can-undo;
                clicked => { root.do-undo(); }
            }
            IconButton {
                icon: "↷";
                icon-size: 15px;
                enabled: root.can-redo;
                clicked => { root.do-redo(); }
            }
        }

        // 第二行：开关 + 状态
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Segmented {
                options: ["原始键序", "键名排序"];
                current: root.sort ? 1 : 0;
                changed(i) => { root.toggle-sort(); }
            }
            Segmented {
                options: ["自动换行", "不换行"];
                current: root.wrap ? 0 : 1;
                changed(i) => { root.toggle-wrap(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
                overflow: elide;
            }
            FerricButton {
                text: "复制";
                variant: "subtle";
                clicked => { root.copy-output(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
        }

        // 搜索条
        HorizontalLayout {
            spacing: 8px;
            FieldLabel { text: "查找"; vertical-alignment: center; }
            FerricLineEdit {
                horizontal-stretch: 1;
                text <=> root.find;
                placeholder: "输入后按 Enter 或点「查找」";
                mono: true;
                edited(t) => { root.find-edited(t); }
                accepted(t) => { root.do-search(); }
            }
            FerricButton {
                text: "查找";
                clicked => { root.do-search(); }
            }
            IconButton {
                icon: "‹";
                icon-size: 16px;
                enabled: root.hit-count > 0;
                clicked => { root.prev-hit(); }
            }
            Text {
                text: root.hit-count > 0
                    ? (root.hit-index + 1) + " / " + root.hit-count
                    : "—";
                font-family: Theme.font-mono;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-alignment: center;
                min-width: 56px;
            }
            IconButton {
                icon: "›";
                icon-size: 16px;
                enabled: root.hit-count > 0;
                clicked => { root.next-hit(); }
            }
        }

        EditorPane {
            title: "JSON";
            which: "json-in";
            state: root.input-state;
            vertical-stretch: 1;
            editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
            editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
            editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
            editor-triple(w) => { root.editor-triple(w); }
            editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
            editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
            editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
        }
    }
}

// ——— 文本 / 文件对比（已迁移） ———
component DiffView inherits Rectangle {
    in property <EditorState> left-state;
    in property <EditorState> right-state;
    in property <[DiffRow]> rows;
    in property <bool> only-changes;
    in property <string> status;

    callback do-compare();
    callback toggle-only-changes();
    callback do-swap();
    callback clear-input();
    callback copy-result();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // 工具条
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            FerricButton {
                text: "对比";
                variant: "primary";
                clicked => { root.do-compare(); }
            }
            FerricButton {
                text: "左右互换";
                icon: "⇄";
                clicked => { root.do-swap(); }
            }
            Segmented {
                options: ["含上下文", "只看差异"];
                current: root.only-changes ? 1 : 0;
                changed(i) => { root.toggle-only-changes(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-mono;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
            }
            FerricButton {
                text: "复制结果";
                variant: "subtle";
                clicked => { root.copy-result(); }
            }
            FerricButton {
                text: "清空";
                variant: "subtle";
                clicked => { root.clear-input(); }
            }
        }

        // 上：左右输入
        HorizontalLayout {
            spacing: 12px;
            height: 34%;
            EditorPane {
                title: "左侧（原文）";
                which: "diff-left-in";
                state: root.left-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
            EditorPane {
                title: "右侧（新文）";
                which: "diff-right-in";
                state: root.right-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }

        // 下：统一差异视图
        VerticalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            HorizontalLayout {
                FieldLabel { text: "差异"; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.rows.length + " 行";
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                background: Theme.code-bg;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.border;
                vertical-stretch: 1;
                clip: true;

                ScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 0px;
                        alignment: start;
                        for row in root.rows: Rectangle {
                            height: 18px;
                            // 整行底色按 kind：删除偏红、新增偏绿、相同透明
                            background: row.kind == 1 ? Theme.del-bg
                                : row.kind == 2 ? Theme.add-bg
                                : transparent;

                            HorizontalLayout {
                                spacing: 0px;
                                // 左右行号槽
                                Text {
                                    width: 42px;
                                    text: row.left-no;
                                    font-family: Theme.font-mono;
                                    font-size: 11px;
                                    color: Theme.faint;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 42px;
                                    text: row.right-no;
                                    font-family: Theme.font-mono;
                                    font-size: 11px;
                                    color: Theme.faint;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    width: 18px;
                                    text: row.sign;
                                    font-family: Theme.font-mono-medium;
                                    font-size: 12px;
                                    color: row.kind == 1 ? Theme.danger
                                        : row.kind == 2 ? Theme.ok : Theme.faint;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                // 行内片段：改动部分加深底色（字符级高亮）
                                HorizontalLayout {
                                    spacing: 0px;
                                    alignment: start;
                                    horizontal-stretch: 1;
                                    for seg in row.segs: Rectangle {
                                        background: seg.emph
                                            ? (row.kind == 1 ? Theme.del-mark : Theme.add-mark)
                                            : transparent;
                                        min-width: seg-text.min-width;
                                        seg-text := Text {
                                            text: seg.text;
                                            font-family: Theme.font-mono;
                                            font-size: 12px;
                                            color: Theme.fg;
                                            vertical-alignment: center;
                                            wrap: no-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— 插件市场（已迁移） ———
component MarketView inherits Rectangle {
    in-out property <string> query;
    in property <[PluginCard]> cards;
    in property <bool> loading;
    in property <bool> ok: true;
    in property <string> status;
    in property <int> progress-pct;
    in property <bool> installing;
    in property <int> pending-updates;

    callback query-edited(string);
    callback do-refresh();
    callback do-install(string);
    callback do-uninstall(string);
    callback do-update-all();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            FerricLineEdit {
                horizontal-stretch: 1;
                text <=> root.query;
                placeholder: "搜索插件，回车刷新";
                edited(t) => { root.query-edited(t); }
                accepted(t) => { root.do-refresh(); }
            }
            FerricButton {
                text: root.loading ? "获取中…" : "刷新";
                enabled: !root.loading;
                clicked => { root.do-refresh(); }
            }
            FerricButton {
                text: root.pending-updates > 0
                    ? "全部更新（" + root.pending-updates + "）"
                    : "全部更新";
                variant: "primary";
                enabled: root.pending-updates > 0 && !root.installing;
                clicked => { root.do-update-all(); }
            }
        }

        // 状态 + 安装进度
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.installing: Rectangle {
                width: 180px;
                height: 6px;
                y: (parent.height - 6px) / 2;
                border-radius: 3px;
                background: Theme.border;
                Rectangle {
                    x: 0;
                    width: parent.width * (root.progress-pct / 100);
                    height: parent.height;
                    border-radius: 3px;
                    background: Theme.accent;
                }
            }
            if root.installing: Text {
                text: root.progress-pct + "%";
                font-family: Theme.font-mono;
                font-size: 11px;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }

        // 卡片列表
        Rectangle {
            background: Theme.code-bg;
            border-radius: 9px;
            border-width: 1px;
            border-color: Theme.border;
            vertical-stretch: 1;
            clip: true;

            if root.cards.length == 0 && !root.loading: Text {
                width: parent.width;
                height: parent.height;
                text: "没有插件";
                font-family: Theme.font-ui;
                font-size: 13px;
                color: Theme.faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: start;
                    for c in root.cards: Rectangle {
                        background: Theme.bg;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 78px;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: c.name;
                                        font-family: Theme.font-ui-semibold;
                                        font-size: 13.5px;
                                        color: Theme.fg;
                                    }
                                    Text {
                                        text: "v" + c.version;
                                        font-family: Theme.font-mono;
                                        font-size: 11.5px;
                                        color: Theme.faint;
                                        vertical-alignment: center;
                                    }
                                    if c.has-update: Text {
                                        text: "有更新（已装 v" + c.installed + "）";
                                        font-family: Theme.font-ui-medium;
                                        font-size: 11px;
                                        color: Theme.accent-strong;
                                        vertical-alignment: center;
                                    }
                                    if c.is-installed && !c.has-update: Text {
                                        text: "已安装";
                                        font-family: Theme.font-ui-medium;
                                        font-size: 11px;
                                        color: Theme.ok;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: c.desc;
                                    font-family: Theme.font-ui;
                                    font-size: 12px;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                                Text {
                                    text: c.size-text + " · " + c.downloads-text;
                                    font-family: Theme.font-mono;
                                    font-size: 10.5px;
                                    color: Theme.faint;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                FerricButton {
                                    text: c.has-update ? "更新" : (c.is-installed ? "重装" : "安装");
                                    variant: c.has-update ? "primary" : "default";
                                    enabled: !c.busy;
                                    clicked => { root.do-install(c.slug); }
                                }
                                if c.is-installed: FerricButton {
                                    text: "卸载";
                                    variant: "subtle";
                                    enabled: !c.busy;
                                    clicked => { root.do-uninstall(c.slug); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— WASM 插件的通用视图（按 manifest 渲染控件） ———
//
// 插件 ABI 是「JSON 进、JSON 出」，选项由 manifest 声明。这里按声明的三种
// 形态（分段 / 开关 / 文本）各画一段，插件本身不需要知道界面长什么样。
component PluginView inherits Rectangle {
    in property <[PluginOption]> options;
    in property <EditorState> input-state;
    in property <EditorState> output-state;
    in property <bool> ok: true;
    in property <string> status;

    callback option-changed(int, int, string);
    callback do-run();
    callback copy-output();
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // manifest 声明的选项
        if root.options.length > 0: Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                for opt[i] in root.options: HorizontalLayout {
                    spacing: 10px;
                    height: 38px;
                    FieldLabel {
                        text: opt.label;
                        width: 120px;
                        vertical-alignment: center;
                    }
                    // 分段单选
                    if opt.kind == 0: Segmented {
                        options: opt.values;
                        current: opt.selected;
                        changed(n) => { root.option-changed(i, n, ""); }
                    }
                    // 开关
                    if opt.kind == 1: Segmented {
                        options: ["开", "关"];
                        current: opt.on ? 0 : 1;
                        changed(n) => { root.option-changed(i, n == 0 ? 1 : 0, ""); }
                    }
                    // 单行文本
                    if opt.kind == 2: FerricLineEdit {
                        horizontal-stretch: 1;
                        text: opt.text;
                        placeholder: opt.hint;
                        edited(t) => { root.option-changed(i, 0, t); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            FerricButton {
                text: "运行";
                variant: "primary";
                clicked => { root.do-run(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status;
                font-family: Theme.font-ui;
                font-size: 12px;
                color: root.ok ? Theme.muted : Theme.danger;
                vertical-alignment: center;
                overflow: elide;
            }
            FerricButton {
                text: "复制输出";
                variant: "subtle";
                clicked => { root.copy-output(); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;
            EditorPane {
                title: "输入";
                which: "plugin-in";
                state: root.input-state;
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
            EditorPane {
                title: "输出";
                which: "plugin-out";
                state: root.output-state;
                read-only: true;
                hint: "只读";
                horizontal-stretch: 1;
                editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                editor-triple(w) => { root.editor-triple(w); }
                editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
            }
        }
    }
}

component SidebarRow inherits Rectangle {
    in property <ToolEntry> entry;
    in property <bool> active;
    callback selected();
    callback toggle-favorite();

    height: 40px;
    border-radius: 9px;
    background: active
        ? Theme.accent-soft
        : (ta.has-hover ? Theme.border : transparent);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        Text {
            text: root.entry.icon;
            font-family: Theme.font-icons;
            font-size: 17px;
            color: root.active ? Theme.accent-strong : Theme.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.entry.name;
                font-family: Theme.font-ui-medium;
                font-size: 13.5px;
                color: root.active ? Theme.fg : Theme.fg-soft;
                overflow: elide;
            }
        }
        // 未迁移的工具挂一个小圆点提示
        if !root.entry.migrated: Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - 7px) / 2;
            border-radius: 4px;
            background: Theme.faint;
        }
        // 收藏星标：hover 或已收藏时可见
        if ta.has-hover || root.entry.favorite: IconButton {
            icon: root.entry.favorite ? "★" : "☆";
            icon-size: 13px;
            clicked => { root.toggle-favorite(); }
        }
    }

    ta := TouchArea {
        clicked => { root.selected(); }
    }
}

// ——— 迁移中占位（9 个尚未迁的工具共用） ———
component MigrationPlaceholder inherits Rectangle {
    in property <string> tool-name;
    in property <string> tool-desc;

    VerticalLayout {
        alignment: center;
        spacing: 14px;

        Text {
            text: "⚙";
            font-family: Theme.font-icons;
            font-size: 40px;
            color: Theme.faint;
            horizontal-alignment: center;
        }
        Text {
            text: root.tool-name + " · 正在迁移到 Slint";
            font-family: Theme.font-ui-semibold;
            font-size: 16px;
            color: Theme.fg;
            horizontal-alignment: center;
        }
        Text {
            text: root.tool-desc;
            font-family: Theme.font-ui;
            font-size: 13px;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "该工具的业务逻辑在 ferric-core 里已就绪且带单测；\n这里只差 Slint 视图层。见 feat/slint-migration 分支的 phase 3。";
            font-family: Theme.font-ui;
            font-size: 12px;
            color: Theme.faint;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// ——— UUID 生成器（已完整迁移） ———
component UuidView inherits Rectangle {
    // 输入侧（双向：Rust 灌初值，UI 改了回写）
    in-out property <int> kind-index: 0;
    in-out property <int> count: 10;
    in-out property <int> namespace-index: 0;
    in-out property <string> custom-ns;
    in-out property <string> name-input: "example.com";
    in-out property <bool> upper: false;
    in-out property <bool> nohyphen: false;
    in-out property <bool> as-json: false;
    in-out property <int> hist-keep-index: 0;

    // 输出侧（只读：Rust 算完写进来）
    in property <string> output;
    in property <bool> ok: true;
    in property <string> status: "就绪";
    in property <[UuidHistEntry]> history;

    // v5 才需要命名空间 + name
    property <bool> needs-namespace: root.kind-index == 2;

    callback regenerate();
    callback copy-output();
    callback restore-history(int);

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // —— 参数区 ——
        Card {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: "版本"; }
                        Segmented {
                            options: ["v4 随机", "v7 时间序", "v5 命名", "v6 时间序"];
                            current <=> root.kind-index;
                            changed(i) => { root.regenerate(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        width: 140px;
                        FieldLabel { text: "数量"; }
                        SpinBox {
                            minimum: 1;
                            maximum: 1000;
                            value <=> root.count;
                            edited(v) => { root.regenerate(); }
                        }
                    }
                }

                // v5 专属：命名空间 + name
                if root.needs-namespace: HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 6px;
                        width: 200px;
                        FieldLabel { text: "命名空间"; }
                        ComboBox {
                            model: ["DNS", "URL", "OID", "X500", "自定义"];
                            current-index <=> root.namespace-index;
                            selected(v) => { root.regenerate(); }
                        }
                    }
                    if root.namespace-index == 4: VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "自定义命名空间 UUID"; }
                        FerricLineEdit {
                            text <=> root.custom-ns;
                            placeholder: "如 6ba7b810-9dad-11d1-80b4-00c04fd430c8";
                            mono: true;
                            edited(t) => { root.regenerate(); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "名称"; }
                        FerricLineEdit {
                            text <=> root.name-input;
                            placeholder: "example.com";
                            edited(t) => { root.regenerate(); }
                        }
                    }
                }

                // 输出格式开关
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;
                    CheckBox {
                        text: "大写";
                        checked <=> root.upper;
                        toggled => { root.regenerate(); }
                    }
                    CheckBox {
                        text: "去连字符";
                        checked <=> root.nohyphen;
                        toggled => { root.regenerate(); }
                    }
                    CheckBox {
                        text: "JSON 数组";
                        checked <=> root.as-json;
                        toggled => { root.regenerate(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    FerricButton {
                        text: "重新生成";
                        icon: "⟳";
                        variant: "primary";
                        clicked => { root.regenerate(); }
                    }
                }
            }
        }

        // —— 输出区 ——
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "输出"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.status;
                        font-family: Theme.font-ui;
                        font-size: 12px;
                        color: root.ok ? Theme.ok : Theme.danger;
                        vertical-alignment: center;
                    }
                    FerricButton {
                        text: "复制";
                        icon: "⧉";
                        variant: "default";
                        clicked => { root.copy-output(); }
                    }
                }

                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 9px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;

                    ScrollView {
                        Text {
                            x: 12px;
                            y: 10px;
                            width: parent.width - 24px;
                            text: root.output;
                            font-family: Theme.font-mono-medium;
                            font-size: 13px;
                            color: Theme.fg;
                            wrap: no-wrap;
                        }
                    }
                }
            }
        }

        // —— 执行历史 ——
        Card {
            vertical-stretch: 0;
            height: 132px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "执行记录"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    FieldLabel { text: "保留"; vertical-alignment: center; }
                    Segmented {
                        options: ["3", "5", "10", "20"];
                        current <=> root.hist-keep-index;
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for h[i] in root.history: Rectangle {
                            height: 26px;
                            border-radius: 6px;
                            background: hist-ta.has-hover ? Theme.border : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: h.label;
                                    font-family: Theme.font-ui;
                                    font-size: 12px;
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if hist-ta.has-hover: Text {
                                    text: "点击恢复";
                                    font-family: Theme.font-ui;
                                    font-size: 11px;
                                    color: Theme.accent-strong;
                                    vertical-alignment: center;
                                }
                            }
                            hist-ta := TouchArea {
                                clicked => { root.restore-history(i); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ——— 设置浮层 ———
component SettingsOverlay inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> tab: 0;
    in-out property <int> theme-mode: 0;     // 0 系统 / 1 亮 / 2 暗
    in-out property <float> ui-scale: 1.0;
    in-out property <bool> auto-update: true;
    in property <string> backend-label;
    in property <string> gpu-desc;
    in property <bool> gpu-software;
    in property <string> version;
    in property <string> data-dir;
    in property <string> mem-status: "";

    callback close();
    callback open-data-dir();
    callback record-memory();
    callback check-update();
    callback reset-demo();

    visible: root.open;
    background: rgba(0, 0, 0, 0.45);

    // 点背景关闭
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(720px, parent.width - 80px);
        height: min(560px, parent.height - 80px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border-2;

        // 吞掉点击，避免穿透到背景的关闭逻辑
        TouchArea { }

        VerticalLayout {
            // 标题栏
            Rectangle {
                height: 48px;
                background: Theme.titlebar;
                border-radius: 14px;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    Text {
                        text: "设置";
                        font-family: Theme.font-ui-semibold;
                        font-size: 15px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: "✕";
                        icon-size: 14px;
                        clicked => { root.close(); }
                    }
                }
            }

            HorizontalLayout {
                // 分类栏
                Rectangle {
                    width: 148px;
                    background: Theme.rail;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        alignment: start;
                        for label[i] in ["外观", "字体", "渲染", "更新", "数据", "关于"]: Rectangle {
                            height: 34px;
                            border-radius: 8px;
                            background: i == root.tab
                                ? Theme.accent-soft
                                : (cat-ta.has-hover ? Theme.border : transparent);
                            Text {
                                x: 12px;
                                width: parent.width - 12px;
                                height: 100%;
                                text: label;
                                font-family: Theme.font-ui-medium;
                                font-size: 13px;
                                color: i == root.tab ? Theme.accent-strong : Theme.fg-soft;
                                vertical-alignment: center;
                            }
                            cat-ta := TouchArea {
                                clicked => { root.tab = i; }
                            }
                        }
                    }
                }

                // 内容区
                ScrollView {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;
                        alignment: start;

                        // —— 外观 ——
                        if root.tab == 0: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "主题"; }
                            Segmented {
                                options: ["跟随系统", "亮色", "暗色"];
                                current <=> root.theme-mode;
                            }
                            FieldLabel { text: "界面缩放"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: Math.round(root.ui-scale * 100) + "%";
                                    font-family: Theme.font-mono-medium;
                                    font-size: 13px;
                                    color: Theme.fg;
                                    vertical-alignment: center;
                                    width: 56px;
                                }
                                FerricButton {
                                    text: "−";
                                    clicked => {
                                        root.ui-scale = max(0.8, root.ui-scale - 0.1);
                                    }
                                }
                                FerricButton {
                                    text: "+";
                                    clicked => {
                                        root.ui-scale = min(1.6, root.ui-scale + 0.1);
                                    }
                                }
                                FerricButton {
                                    text: "重置 100%";
                                    variant: "subtle";
                                    clicked => { root.ui-scale = 1.0; }
                                }
                            }
                        }

                        // —— 字体 ——
                        if root.tab == 1: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "内嵌字体"; }
                            Text {
                                text: "UI：Plus Jakarta Sans（Regular / Medium / SemiBold / Bold）\n等宽：JetBrains Mono（Regular / Medium）\n图标：Lucide\n中文：从系统加载（微软雅黑 / 苹方 / Noto CJK）";
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }

                        // —— 渲染 ——
                        if root.tab == 2: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "渲染后端"; }
                            Text {
                                text: root.backend-label;
                                font-family: Theme.font-ui-medium;
                                font-size: 13px;
                                color: Theme.fg;
                            }
                            Text {
                                text: root.gpu-desc;
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: root.gpu-software ? Theme.danger : Theme.muted;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Slint 软件渲染：不建任何 GPU 上下文，进程内存与「一个窗口 + 一块位图」相当。\n这是迁移的主要收益 —— egui/wgpu 时代同一台机器上是 ~611MB。";
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.faint;
                                wrap: word-wrap;
                            }
                        }

                        // —— 更新 ——
                        if root.tab == 3: VerticalLayout {
                            spacing: 10px;
                            CheckBox {
                                text: "自动检查更新并后台下载";
                                checked <=> root.auto-update;
                            }
                            FerricButton {
                                text: "立即检查更新";
                                variant: "default";
                                clicked => { root.check-update(); }
                            }
                        }

                        // —— 数据 ——
                        if root.tab == 4: VerticalLayout {
                            spacing: 10px;
                            FieldLabel { text: "数据目录"; }
                            Text {
                                text: root.data-dir;
                                font-family: Theme.font-mono-medium;
                                font-size: 12px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                FerricButton {
                                    text: "打开数据文件夹";
                                    icon: "⌸";
                                    clicked => { root.open-data-dir(); }
                                }
                                FerricButton {
                                    text: "记录 30 秒内存";
                                    clicked => { root.record-memory(); }
                                }
                                FerricButton {
                                    text: "重置演示数据";
                                    variant: "subtle";
                                    clicked => { root.reset-demo(); }
                                }
                            }
                            if root.mem-status != "": Text {
                                text: root.mem-status;
                                font-family: Theme.font-ui;
                                font-size: 12px;
                                color: Theme.accent-strong;
                            }
                        }

                        // —— 关于 ——
                        if root.tab == 5: VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "Ferric " + root.version;
                                font-family: Theme.font-ui-semibold;
                                font-size: 16px;
                                color: Theme.fg;
                            }
                            Text {
                                text: "跨平台原生 Rust 开发者工具箱。\nGUI：Slint（软件渲染）。";
                                font-family: Theme.font-ui;
                                font-size: 12.5px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Ferric";
    // 与原 eframe 版一致的默认尺寸与下限。
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 360px;
    min-height: 280px;
    no-frame: true;
    background: Theme.canvas;

    // ——— 状态（Rust 侧读写） ———
    in property <[ToolEntry]> tools;
    in-out property <int> active-tool: 0;
    in-out property <string> rail-filter: "";
    in-out property <length> rail-width: 264px;
    in-out property <bool> settings-open: false;
    in property <string> version: "0.2.0";
    in property <string> backend-label: "软渲染（CPU）";
    in property <string> gpu-desc: "CPU 软渲染（Slint software renderer）";
    in property <bool> gpu-software: true;
    in property <string> data-dir: "";
    in property <string> mem-status: "";
    // 侧栏底部的迁移进度（Rust 侧按 registry 里 migrated 的数量算）
    in property <string> migration-note: "";
    in property <[string]> toasts;

    // 设置项（双向）
    in-out property <int> theme-mode: 0;
    in-out property <float> ui-scale: 1.0;
    in-out property <bool> auto-update: true;
    in-out property <int> settings-tab: 0;

    // UUID 工具状态
    in-out property <int> uuid-kind: 0;
    in-out property <int> uuid-count: 10;
    in-out property <int> uuid-namespace: 0;
    in-out property <string> uuid-custom-ns: "";
    in-out property <string> uuid-name: "example.com";
    in-out property <bool> uuid-upper: false;
    in-out property <bool> uuid-nohyphen: false;
    in-out property <bool> uuid-as-json: false;
    in-out property <int> uuid-hist-keep: 0;
    in property <string> uuid-output: "";
    in property <bool> uuid-ok: true;
    in property <string> uuid-status: "就绪";
    in property <[UuidHistEntry]> uuid-history;

    // YAML 工具状态
    in property <EditorState> yaml-input;
    in property <EditorState> yaml-output;
    in property <bool> yaml-ok: true;
    in property <string> yaml-status: "";

    // SQL 工具状态
    in property <EditorState> sql-input;
    in property <bool> sql-uppercase: true;
    in property <string> sql-status: "";

    // 正则工具状态
    in-out property <string> regex-pattern;
    in property <bool> regex-fg: true;
    in property <bool> regex-fi;
    in property <bool> regex-fm;
    in property <bool> regex-fs;
    in property <bool> regex-fx;
    in property <EditorState> regex-text;
    in property <[RegexMatch]> regex-matches;
    in property <bool> regex-ok: true;
    in property <string> regex-status: "";

    // RSA 工具状态
    in property <int> rsa-bits: 1;
    in property <bool> rsa-busy;
    in property <bool> rsa-ok: true;
    in property <string> rsa-status: "";
    in property <EditorState> rsa-pub;
    in property <EditorState> rsa-priv;

    // 加密 / 解密工具状态
    in property <[string]> crypto-algos;
    in property <int> crypto-enc-algo;
    in property <int> crypto-dec-algo;
    in-out property <string> crypto-enc-key;
    in-out property <string> crypto-dec-key;
    in property <EditorState> crypto-enc-in;
    in property <EditorState> crypto-enc-out;
    in property <EditorState> crypto-dec-in;
    in property <EditorState> crypto-dec-out;
    in property <bool> crypto-enc-ok: true;
    in property <bool> crypto-dec-ok: true;
    in property <string> crypto-enc-status: "";
    in property <string> crypto-dec-status: "";

    // 国密 SM 工具状态
    in-out property <string> gm-pub-key;
    in-out property <string> gm-priv-key;
    in property <string> gm-key-status: "";
    in property <[string]> gm-enc-algos;
    in property <[string]> gm-dec-algos;
    in property <[string]> gm-fmts;
    in property <int> gm-enc-algo;
    in property <int> gm-dec-algo;
    in property <int> gm-fmt;
    in property <bool> gm-enc-needs-key: true;
    in property <string> gm-enc-key-label: "口令";
    in property <string> gm-dec-key-label: "口令";
    in-out property <string> gm-enc-key;
    in-out property <string> gm-dec-key;
    in property <EditorState> gm-enc-in;
    in property <EditorState> gm-enc-out;
    in property <EditorState> gm-dec-in;
    in property <EditorState> gm-dec-out;
    in property <bool> gm-enc-ok: true;
    in property <bool> gm-dec-ok: true;
    in property <string> gm-enc-status: "";
    in property <string> gm-dec-status: "";
    in property <EditorState> gm-sig;
    in-out property <string> gm-sig-hex;
    in property <bool> gm-sig-ok: true;
    in property <string> gm-sig-status: "";

    // 时间戳工具状态
    in property <string> ts-now: "";
    in property <string> ts-now-ms: "";
    in property <bool> ts-running;
    in property <string> ts-offset: "";
    in property <string> ts-tz-label: "";
    in-out property <string> ts-tz-filter;
    in property <[TzRow]> ts-tz-hits;
    in-out property <string> ts-ts-input;
    in property <string> ts-ts-output: "";
    in property <bool> ts-ts-ok: true;
    in-out property <string> ts-date-input;
    in property <string> ts-date-output: "";
    in property <bool> ts-date-ok: true;

    // JSON 工具状态
    in property <EditorState> json-input;
    in property <int> json-indent;
    in property <bool> json-sort;
    in property <bool> json-wrap: true;
    in property <bool> json-ok: true;
    in property <string> json-status: "";
    in-out property <string> json-find;
    in property <int> json-hit-count;
    in property <int> json-hit-index;
    in property <bool> json-can-undo;
    in property <bool> json-can-redo;

    // 对比工具状态
    in property <EditorState> diff-left;
    in property <EditorState> diff-right;
    in property <[DiffRow]> diff-rows;
    in property <bool> diff-only-changes;
    in property <string> diff-status: "";

    // 插件市场状态
    in-out property <string> market-query;
    in property <[PluginCard]> market-cards;
    in property <bool> market-loading;
    in property <bool> market-ok: true;
    in property <string> market-status: "";
    in property <int> market-progress;
    in property <bool> market-installing;
    in property <int> market-pending;

    // 当前选中的 WASM 插件（内置工具时为空）
    in property <[PluginOption]> plugin-options;
    in property <EditorState> plugin-in;
    in property <EditorState> plugin-out;
    in property <bool> plugin-ok: true;
    in property <string> plugin-status: "";
    // 当前工具是不是插件 —— 决定走 PluginView 还是内置分支
    in property <bool> current-is-plugin;

    // 更新器状态
    // 0 空闲 / 1 检查中 / 2 已最新 / 3 发现新版 / 4 下载中 / 5 可安装 / 6 失败
    in property <int> update-phase;
    in property <string> update-version: "";
    in property <int> update-progress;
    in property <string> update-note: "";
    in-out property <bool> update-dialog-open;

    // ——— 回调（Rust 侧接管） ———
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    callback select-tool(int);
    callback toggle-favorite(int);
    callback theme-changed(int);
    callback scale-changed(float);
    callback open-data-dir();
    callback record-memory();
    callback check-update();
    callback uuid-regenerate();
    callback uuid-copy();
    callback uuid-restore-history(int);

    // 编辑区通用回调。第一个参数是编辑区标识（如 "yaml-in"），
    // Rust 侧一个 match 分派到对应的 TextBuffer —— 每加一个文本类工具
    // 不需要再接一遍回调。
    callback editor-viewport(string, int, int);
    callback editor-click(string, int, int, bool);
    callback editor-drag(string, int, int);
    callback editor-triple(string);
    callback editor-scroll(string, int, int);
    callback editor-scroll-line(string, int);
    callback editor-key(string, string, bool, bool);

    // YAML 工具
    callback yaml-sample();
    callback yaml-clear();
    callback yaml-copy();

    // SQL 工具
    callback sql-format();
    callback sql-minify();
    callback sql-toggle-uppercase();
    callback sql-clear();
    callback sql-copy();

    // 正则工具
    callback regex-pattern-edited(string);
    callback regex-toggle-flag(int);

    // RSA 工具
    callback rsa-bits-changed(int);
    callback rsa-generate();
    callback rsa-copy-pub();
    callback rsa-copy-priv();

    // 加密 / 解密工具
    callback crypto-enc-algo-changed(int);
    callback crypto-dec-algo-changed(int);
    callback crypto-enc-key-edited(string);
    callback crypto-dec-key-edited(string);
    callback crypto-encrypt();
    callback crypto-decrypt();
    callback crypto-send-to-decrypt();
    callback crypto-copy-enc();
    callback crypto-copy-dec();

    // 国密 SM 工具
    callback gm-gen-keypair();
    callback gm-derive-pub();
    callback gm-enc-algo-changed(int);
    callback gm-dec-algo-changed(int);
    callback gm-fmt-changed(int);
    callback gm-enc-key-edited(string);
    callback gm-dec-key-edited(string);
    callback gm-pub-key-edited(string);
    callback gm-priv-key-edited(string);
    callback gm-sig-hex-edited(string);
    callback gm-encrypt();
    callback gm-decrypt();
    callback gm-send-to-decrypt();
    callback gm-sign();
    callback gm-verify();

    // 时间戳工具
    callback ts-toggle-running();
    callback ts-refresh-now();
    callback ts-use-now();
    callback ts-copy-now();
    callback ts-filter-edited(string);
    callback ts-select-tz(string);
    callback ts-input-edited(string);
    callback ts-date-edited(string);

    // JSON 工具
    callback json-format();
    callback json-minify();
    callback json-escape();
    callback json-unescape();
    callback json-toggle-sort();
    callback json-toggle-wrap();
    callback json-indent-changed(int);
    callback json-clear();
    callback json-copy();
    callback json-undo();
    callback json-redo();
    callback json-find-edited(string);
    callback json-search();
    callback json-next-hit();
    callback json-prev-hit();

    // 对比工具
    callback diff-compare();
    callback diff-toggle-only-changes();
    callback diff-swap();
    callback diff-clear();
    callback diff-copy();

    // 插件市场
    callback market-query-edited(string);
    callback market-refresh();
    callback market-install(string);
    callback market-uninstall(string);
    callback market-update-all();

    // WASM 插件
    callback plugin-option-changed(int, int, string);
    callback plugin-run();
    callback plugin-copy();

    // 更新器
    callback update-install();
    callback update-dismiss();
    callback reset-demo();

    // 当前工具（tools 可能为空，取值前保护）
    property <ToolEntry> current: root.tools.length > 0
        ? root.tools[min(root.active-tool, root.tools.length - 1)]
        : { id: "", name: "", desc: "", icon: "", group: "", migrated: false, favorite: false, visible: true };

    VerticalLayout {
        // ===== 标题栏 44px =====
        Rectangle {
            height: 44px;
            background: Theme.titlebar;

            // 拖拽区（右侧留出 180px 给窗口按钮，按钮声明在后面因此覆盖其上）。
            //
            // 在**按下瞬间**就交给系统拖动，而不是等 `moved`：winit 的
            // drag_window 要求在鼠标仍按下时调用，等移动事件到达时那一拍
            // 已经过去了（实测「拖了没反应」就是这个原因）。
            drag-ta := TouchArea {
                width: parent.width - 180px;
                height: parent.height;
                mouse-cursor: default;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.window-drag();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 4px;
                spacing: 0px;

                Text {
                    text: "Ferric";
                    font-family: Theme.font-ui-bold;
                    font-size: 14.5px;
                    color: Theme.fg;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 12px;
                }
                Text {
                    text: root.version;
                    font-family: Theme.font-mono-medium;
                    font-size: 11.5px;
                    color: Theme.faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // 更新就绪时顶栏常驻一个入口。用户点了「稍后」之后
                // 仍然要能找回来 —— 否则那次更新就等于被丢掉了。
                if root.update-phase == 5: FerricButton {
                    text: "安装 v" + root.update-version;
                    variant: "primary";
                    clicked => { root.update-dialog-open = true; }
                }
                if root.update-phase == 4: Text {
                    text: "更新下载中 " + root.update-progress + "%";
                    font-family: Theme.font-ui;
                    font-size: 11.5px;
                    color: Theme.muted;
                    vertical-alignment: center;
                }

                // 设置入口
                IconButton {
                    icon: "⚙";
                    icon-size: 16px;
                    clicked => { root.settings-open = true; }
                }
                Rectangle { width: 4px; }
                // 窗口按钮
                IconButton {
                    icon: "—";
                    icon-size: 14px;
                    clicked => { root.window-minimize(); }
                }
                IconButton {
                    icon: "▢";
                    icon-size: 13px;
                    clicked => { root.window-maximize(); }
                }
                IconButton {
                    icon: "✕";
                    icon-size: 14px;
                    clicked => { root.window-close(); }
                }
            }

            // 底部分隔线
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }
        }

        HorizontalLayout {
            // ===== 侧栏 =====
            Rectangle {
                width: root.rail-width;
                background: Theme.rail;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // 搜索框
                    FerricLineEdit {
                        placeholder: "搜索工具…";
                        text <=> root.rail-filter;
                    }

                    // 工具列表
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for t[i] in root.tools: SidebarRow {
                                entry: t;
                                active: i == root.active-tool;
                                // 搜索过滤在 Rust 侧做（Slint 的 string 没有
                                // contains；且中文匹配要按 char 比，交给 Rust 更稳）。
                                visible: t.visible;
                                selected => { root.select-tool(i); }
                                toggle-favorite => { root.toggle-favorite(i); }
                            }
                        }
                    }

                    // 底部：迁移进度提示
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    Text {
                        text: root.migration-note;
                        font-family: Theme.font-ui;
                        font-size: 11px;
                        color: Theme.faint;
                        horizontal-alignment: center;
                    }
                }

                // 右边缘分隔线
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.border;
                }
            }

            // ===== 主内容区 =====
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg;

                VerticalLayout {
                    // 工具标题条
                    Rectangle {
                        height: 64px;
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.current.name;
                                    font-family: Theme.font-ui-bold;
                                    font-size: 19px;
                                    color: Theme.fg;
                                }
                                Text {
                                    text: root.current.desc;
                                    font-family: Theme.font-ui;
                                    font-size: 12.5px;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            width: parent.width;
                            background: Theme.border;
                        }
                    }

                    // 工具主体：已迁移的走真实视图，其余走占位
                    if root.current.id == "uuid": UuidView {
                        vertical-stretch: 1;
                        kind-index <=> root.uuid-kind;
                        count <=> root.uuid-count;
                        namespace-index <=> root.uuid-namespace;
                        custom-ns <=> root.uuid-custom-ns;
                        name-input <=> root.uuid-name;
                        upper <=> root.uuid-upper;
                        nohyphen <=> root.uuid-nohyphen;
                        as-json <=> root.uuid-as-json;
                        hist-keep-index <=> root.uuid-hist-keep;
                        output: root.uuid-output;
                        ok: root.uuid-ok;
                        status: root.uuid-status;
                        history: root.uuid-history;
                        regenerate => { root.uuid-regenerate(); }
                        copy-output => { root.uuid-copy(); }
                        restore-history(i) => { root.uuid-restore-history(i); }
                    }
                    if root.current.id == "yaml": YamlView {
                        vertical-stretch: 1;
                        input-state: root.yaml-input;
                        output-state: root.yaml-output;
                        ok: root.yaml-ok;
                        status: root.yaml-status;
                        load-sample => { root.yaml-sample(); }
                        clear-input => { root.yaml-clear(); }
                        copy-output => { root.yaml-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "sql": SqlView {
                        vertical-stretch: 1;
                        input-state: root.sql-input;
                        uppercase: root.sql-uppercase;
                        status: root.sql-status;
                        do-format => { root.sql-format(); }
                        do-minify => { root.sql-minify(); }
                        toggle-uppercase => { root.sql-toggle-uppercase(); }
                        clear-input => { root.sql-clear(); }
                        copy-input => { root.sql-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "regex": RegexView {
                        vertical-stretch: 1;
                        pattern <=> root.regex-pattern;
                        fg: root.regex-fg;
                        fi: root.regex-fi;
                        fm: root.regex-fm;
                        fs: root.regex-fs;
                        fx: root.regex-fx;
                        text-state: root.regex-text;
                        matches: root.regex-matches;
                        ok: root.regex-ok;
                        status: root.regex-status;
                        pattern-edited(t) => { root.regex-pattern-edited(t); }
                        toggle-flag(i) => { root.regex-toggle-flag(i); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "rsa": RsaView {
                        vertical-stretch: 1;
                        bits-index: root.rsa-bits;
                        busy: root.rsa-busy;
                        ok: root.rsa-ok;
                        status: root.rsa-status;
                        pub-state: root.rsa-pub;
                        priv-state: root.rsa-priv;
                        bits-changed(i) => { root.rsa-bits-changed(i); }
                        generate => { root.rsa-generate(); }
                        copy-pub => { root.rsa-copy-pub(); }
                        copy-priv => { root.rsa-copy-priv(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "crypto": CryptoView {
                        vertical-stretch: 1;
                        algos: root.crypto-algos;
                        enc-algo: root.crypto-enc-algo;
                        dec-algo: root.crypto-dec-algo;
                        enc-key <=> root.crypto-enc-key;
                        dec-key <=> root.crypto-dec-key;
                        enc-in: root.crypto-enc-in;
                        enc-out: root.crypto-enc-out;
                        dec-in: root.crypto-dec-in;
                        dec-out: root.crypto-dec-out;
                        enc-ok: root.crypto-enc-ok;
                        dec-ok: root.crypto-dec-ok;
                        enc-status: root.crypto-enc-status;
                        dec-status: root.crypto-dec-status;
                        enc-algo-changed(i) => { root.crypto-enc-algo-changed(i); }
                        dec-algo-changed(i) => { root.crypto-dec-algo-changed(i); }
                        enc-key-edited(k) => { root.crypto-enc-key-edited(k); }
                        dec-key-edited(k) => { root.crypto-dec-key-edited(k); }
                        do-encrypt => { root.crypto-encrypt(); }
                        do-decrypt => { root.crypto-decrypt(); }
                        send-to-decrypt => { root.crypto-send-to-decrypt(); }
                        copy-enc => { root.crypto-copy-enc(); }
                        copy-dec => { root.crypto-copy-dec(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "gm": GmView {
                        vertical-stretch: 1;
                        pub-key <=> root.gm-pub-key;
                        priv-key <=> root.gm-priv-key;
                        key-status: root.gm-key-status;
                        enc-algos: root.gm-enc-algos;
                        dec-algos: root.gm-dec-algos;
                        fmts: root.gm-fmts;
                        enc-algo: root.gm-enc-algo;
                        dec-algo: root.gm-dec-algo;
                        fmt-index: root.gm-fmt;
                        enc-needs-key: root.gm-enc-needs-key;
                        enc-key-label: root.gm-enc-key-label;
                        dec-key-label: root.gm-dec-key-label;
                        enc-key <=> root.gm-enc-key;
                        dec-key <=> root.gm-dec-key;
                        enc-in: root.gm-enc-in;
                        enc-out: root.gm-enc-out;
                        dec-in: root.gm-dec-in;
                        dec-out: root.gm-dec-out;
                        enc-ok: root.gm-enc-ok;
                        dec-ok: root.gm-dec-ok;
                        enc-status: root.gm-enc-status;
                        dec-status: root.gm-dec-status;
                        sig-state: root.gm-sig;
                        sig-hex <=> root.gm-sig-hex;
                        sig-ok: root.gm-sig-ok;
                        sig-status: root.gm-sig-status;
                        gen-keypair => { root.gm-gen-keypair(); }
                        derive-pub => { root.gm-derive-pub(); }
                        enc-algo-changed(i) => { root.gm-enc-algo-changed(i); }
                        dec-algo-changed(i) => { root.gm-dec-algo-changed(i); }
                        fmt-changed(i) => { root.gm-fmt-changed(i); }
                        enc-key-edited(k) => { root.gm-enc-key-edited(k); }
                        dec-key-edited(k) => { root.gm-dec-key-edited(k); }
                        pub-key-edited(k) => { root.gm-pub-key-edited(k); }
                        priv-key-edited(k) => { root.gm-priv-key-edited(k); }
                        sig-hex-edited(h) => { root.gm-sig-hex-edited(h); }
                        do-encrypt => { root.gm-encrypt(); }
                        do-decrypt => { root.gm-decrypt(); }
                        send-to-decrypt => { root.gm-send-to-decrypt(); }
                        do-sign => { root.gm-sign(); }
                        do-verify => { root.gm-verify(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "timestamp": TimestampView {
                        vertical-stretch: 1;
                        now-text: root.ts-now;
                        now-ms-text: root.ts-now-ms;
                        running: root.ts-running;
                        offset: root.ts-offset;
                        tz-label: root.ts-tz-label;
                        tz-filter <=> root.ts-tz-filter;
                        tz-hits: root.ts-tz-hits;
                        ts-input <=> root.ts-ts-input;
                        ts-output: root.ts-ts-output;
                        ts-ok: root.ts-ts-ok;
                        date-input <=> root.ts-date-input;
                        date-output: root.ts-date-output;
                        date-ok: root.ts-date-ok;
                        toggle-running => { root.ts-toggle-running(); }
                        refresh-now => { root.ts-refresh-now(); }
                        use-now => { root.ts-use-now(); }
                        copy-now => { root.ts-copy-now(); }
                        filter-edited(f) => { root.ts-filter-edited(f); }
                        select-tz(n) => { root.ts-select-tz(n); }
                        ts-edited(v) => { root.ts-input-edited(v); }
                        date-edited(v) => { root.ts-date-edited(v); }
                    }
                    if root.current.id == "json": JsonView {
                        vertical-stretch: 1;
                        input-state: root.json-input;
                        indent-index: root.json-indent;
                        sort: root.json-sort;
                        wrap: root.json-wrap;
                        ok: root.json-ok;
                        status: root.json-status;
                        find <=> root.json-find;
                        hit-count: root.json-hit-count;
                        hit-index: root.json-hit-index;
                        can-undo: root.json-can-undo;
                        can-redo: root.json-can-redo;
                        do-format => { root.json-format(); }
                        do-minify => { root.json-minify(); }
                        do-escape => { root.json-escape(); }
                        do-unescape => { root.json-unescape(); }
                        toggle-sort => { root.json-toggle-sort(); }
                        toggle-wrap => { root.json-toggle-wrap(); }
                        indent-changed(i) => { root.json-indent-changed(i); }
                        clear-input => { root.json-clear(); }
                        copy-output => { root.json-copy(); }
                        do-undo => { root.json-undo(); }
                        do-redo => { root.json-redo(); }
                        find-edited(f) => { root.json-find-edited(f); }
                        do-search => { root.json-search(); }
                        next-hit => { root.json-next-hit(); }
                        prev-hit => { root.json-prev-hit(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "diff": DiffView {
                        vertical-stretch: 1;
                        left-state: root.diff-left;
                        right-state: root.diff-right;
                        rows: root.diff-rows;
                        only-changes: root.diff-only-changes;
                        status: root.diff-status;
                        do-compare => { root.diff-compare(); }
                        toggle-only-changes => { root.diff-toggle-only-changes(); }
                        do-swap => { root.diff-swap(); }
                        clear-input => { root.diff-clear(); }
                        copy-result => { root.diff-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "market": MarketView {
                        vertical-stretch: 1;
                        query <=> root.market-query;
                        cards: root.market-cards;
                        loading: root.market-loading;
                        ok: root.market-ok;
                        status: root.market-status;
                        progress-pct: root.market-progress;
                        installing: root.market-installing;
                        pending-updates: root.market-pending;
                        query-edited(q) => { root.market-query-edited(q); }
                        do-refresh => { root.market-refresh(); }
                        do-install(s) => { root.market-install(s); }
                        do-uninstall(s) => { root.market-uninstall(s); }
                        do-update-all => { root.market-update-all(); }
                    }
                    // WASM 插件：按 manifest 渲染控件。所有内置工具的 id 都不会
                    // 命中这里，所以用一个显式标记而不是「id 不在白名单里」。
                    if root.current-is-plugin: PluginView {
                        vertical-stretch: 1;
                        options: root.plugin-options;
                        input-state: root.plugin-in;
                        output-state: root.plugin-out;
                        ok: root.plugin-ok;
                        status: root.plugin-status;
                        option-changed(i, n, t) => { root.plugin-option-changed(i, n, t); }
                        do-run => { root.plugin-run(); }
                        copy-output => { root.plugin-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    // 未迁移的工具走占位。条件用 `migrated` 而不是逐个列 id ——
                    // 每迁完一个只需把 Tool::migrated 翻成 true 并加上面那样一个分支。
                    if !root.current.migrated: MigrationPlaceholder {
                        vertical-stretch: 1;
                        tool-name: root.current.name;
                        tool-desc: root.current.desc;
                    }
                }
            }
        }
    }

    // ===== Toast 区（右下角堆叠） =====
    VerticalLayout {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
        width: 340px;
        spacing: 8px;
        alignment: end;
        for msg in root.toasts: Toast { text: msg; }
    }

    // ===== 更新框 =====
    //
    // 后台**绝不自动安装**：那一步会关掉用户正在用的应用，必须他自己点。
    if root.update-dialog-open && root.update-phase == 5: Rectangle {
        width: parent.width;
        height: parent.height;
        background: rgba(0, 0, 0, 0.45);
        TouchArea {
            clicked => { root.update-dialog-open = false; }
        }

        Rectangle {
            width: min(520px, parent.width - 80px);
            height: min(360px, parent.height - 80px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-2;
            TouchArea { }

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "发现新版本 v" + root.update-version;
                    font-family: Theme.font-ui-bold;
                    font-size: 17px;
                    color: Theme.fg;
                }
                Text {
                    text: "已下载并通过 sha256 + 魔数 + 离线签名三重校验。";
                    font-family: Theme.font-ui;
                    font-size: 12.5px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    ScrollView {
                        Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: root.update-note;
                            font-family: Theme.font-ui;
                            font-size: 12px;
                            color: Theme.fg-soft;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    FerricButton {
                        text: "稍后";
                        variant: "subtle";
                        clicked => { root.update-dismiss(); }
                    }
                    FerricButton {
                        text: "立即安装并重启";
                        variant: "primary";
                        clicked => { root.update-install(); }
                    }
                }
            }
        }
    }

    // ===== 设置浮层 =====
    SettingsOverlay {
        width: parent.width;
        height: parent.height;
        open <=> root.settings-open;
        tab <=> root.settings-tab;
        theme-mode <=> root.theme-mode;
        ui-scale <=> root.ui-scale;
        auto-update <=> root.auto-update;
        backend-label: root.backend-label;
        gpu-desc: root.gpu-desc;
        gpu-software: root.gpu-software;
        version: root.version;
        data-dir: root.data-dir;
        mem-status: root.mem-status;
        close => { root.settings-open = false; }
        open-data-dir => { root.open-data-dir(); }
        record-memory => { root.record-memory(); }
        check-update => { root.check-update(); }
        reset-demo => { root.reset-demo(); }
    }
}