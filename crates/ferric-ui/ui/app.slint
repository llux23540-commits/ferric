                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-fold(w, r) => { root.editor-fold(w, r); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                    if root.current.id == "market": MarketView {
                        vertical-stretch: 1;
                        query <=> root.market-query;
                        cards: root.market-cards;
                        loading: root.market-loading;
                        ok: root.market-ok;
                        status: root.market-status;
                        progress-pct: root.market-progress;
                        installing: root.market-installing;
                        pending-updates: root.market-pending;
                        tab: root.market-tab;
                        count-all: root.market-count-all;
                        count-installed: root.market-count-installed;
                        query-edited(q) => { root.market-query-edited(q); }
                        do-refresh => { root.market-refresh(); }
                        do-install(s) => { root.market-install(s); }
                        do-uninstall(s) => { root.market-uninstall(s); }
                        do-update-all => { root.market-update-all(); }
                        tab-changed(i) => { root.market-tab-changed(i); }
                    }
                    // WASM 插件：按 manifest 渲染控件。所有内置工具的 id 都不会
                    // 命中这里，所以用一个显式标记而不是「id 不在白名单里」。
                    if root.current-is-plugin: PluginView {
                        vertical-stretch: 1;
                        options: root.plugin-options;
                        input-state: root.plugin-in;
                        output-state: root.plugin-out;
                        ok: root.plugin-ok;
                        status: root.plugin-status;
                        option-changed(i, n, t) => { root.plugin-option-changed(i, n, t); }
                        do-run => { root.plugin-run(); }
                        copy-output => { root.plugin-copy(); }
                        editor-viewport(w, r, c) => { root.editor-viewport(w, r, c); }
                        editor-wide-ratio(v) => { root.editor-wide-ratio(v); }
                        editor-click(w, l, c, e) => { root.editor-click(w, l, c, e); }
                        editor-drag(w, l, c) => { root.editor-drag(w, l, c); }
                        editor-triple(w) => { root.editor-triple(w); }
                        editor-fold(w, r) => { root.editor-fold(w, r); }
                        editor-scroll(w, dl, dc) => { root.editor-scroll(w, dl, dc); }
                        editor-scroll-line(w, l) => { root.editor-scroll-line(w, l); }
                        editor-key(w, t, ctrl, shift) => { root.editor-key(w, t, ctrl, shift); }
                    }
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== Toast 区（右下角堆叠） =====
    //
    // 过期由 Rust 侧的每秒心跳剔除（`prune_toasts`），点「×」立即关掉那一条。
    VerticalLayout {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
        width: 360px;
        spacing: 8px;
        alignment: end;
        for t in root.toasts: Toast {
            text: t.text;
            level: t.level;
            dismissed => { root.dismiss-toast(t.id); }
        }
    }

    // ===== 更新框 =====
    //
    // 后台**绝不自动安装**：那一步会关掉用户正在用的应用，必须他自己点。
    if root.update-dialog-open && root.update-phase == 5: Rectangle {
        // 浮层一律从标题栏**下面**开始（44px）。铺满整窗的话，主标题栏连同
        // 最小化 / 最大化 / 关闭三颗按钮全被这层挡住：浮层一开，窗口既挪不动
        // 也关不掉，而且在标题栏上按一下还会被背景那层当成「点外面 → 关弹框」。
        y: 44px;
        width: parent.width;
        height: parent.height - 44px;
        background: rgba(0, 0, 0, 0.45);
        TouchArea {
            clicked => { root.update-dialog-open = false; }
        }

        Rectangle {
            width: min(520px, parent.width - 80px);
            height: min(360px, parent.height - 80px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.bg;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border-2;
            TouchArea { }

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                // 标题行：标题 + 关闭。以前只能点背景或「稍后」关掉 ——
                // 弹框右上角没有 ✕ 时，第一反应是去点主窗口的关闭按钮，
                // 而那颗按钮此刻正被这层浮层盖着。
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "发现新版本 v" + root.update-version;
                        font-family: Theme.font-ui-bold;
                        font-weight: Theme.weight-bold;
                        font-size: 17px;
                        color: Theme.fg;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: Icons.x;
                        icon-size: 14px;
                        tooltip: "稍后再说";
                        clicked => { root.update-dismiss(); }
                    }
                }
                Text {
                    text: "已下载并通过 sha256 + 魔数 + 离线签名三重校验。";
                    font-family: Theme.font-ui;
                    font-size: 12.5px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                Rectangle {
                    background: Theme.code-bg;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    ScrollView {
                        Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text: root.update-note;
                            font-family: Theme.font-ui;
                            font-size: 12px;
                            color: Theme.fg-soft;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    FerricButton {
                        text: "稍后";
                        variant: "subtle";
                        clicked => { root.update-dismiss(); }
                    }
                    FerricButton {
                        text: "立即安装并重启";
                        variant: "primary";
                        clicked => { root.update-install(); }
                    }
                }
            }
        }
    }

    // ===== 设置浮层 =====
    SettingsOverlay {
        // 同上：不盖标题栏，窗口按钮与拖动始终可用
        y: 44px;
        width: parent.width;
        height: parent.height - 44px;
        open <=> root.settings-open;
        tab <=> root.settings-tab;
        theme-mode <=> root.theme-mode;
        ui-scale <=> root.ui-scale;
        auto-update <=> root.auto-update;
        version: root.version;
        build-number: root.build-number;
        data-dir: root.data-dir;
        mem-status: root.mem-status;
        update-phase: root.update-phase;
        update-version: root.update-version;
        update-progress: root.update-progress;
        update-note: root.update-note;
        updater-busy: root.updater-busy;
        last-check: root.last-check;
        last-check-stale: root.last-check-stale;
        source-index: root.source-index;
        close => { root.settings-open = false; }
        window-drag => { root.window-drag(); }
        open-data-dir => { root.open-data-dir(); }
        record-memory => { root.record-memory(); }
        check-update => { root.check-update(); }
        reset-demo => { root.reset-demo(); }
        source-changed(i) => { root.source-changed(i); }
        clear-drafts => { root.clear-drafts(); }
        reset-rail-width => { root.reset-rail-width(); }
    }

    // ===== 命令面板（Ctrl+K，快捷键在 Rust 侧的 winit 事件里拦） =====
    //
    // 用 `if` 而不是 `visible`：每次打开都重建一次，`init` 里的 focus()
    // 才会重新跑（面板是键盘入口，打开后必须已经能直接打字）。
    if root.palette-open: CommandPalette {
        y: 44px;
        width: parent.width;
        height: parent.height - 44px;
        rows: root.palette-rows;
        query <=> root.palette-query;
        sel <=> root.palette-sel;
        query-edited(t) => { root.palette-query-changed(t); }
        pick(i) => {
            root.palette-open = false;
            root.select-tool(i);
        }
        dismiss => { root.palette-open = false; }
    }

    // ===== 操作记录（侧栏左下角那个图标打开） =====
    if root.log-open: ActivityPanel {
        y: 44px;
        width: parent.width;
        height: parent.height - 44px;
        rows: root.activity;
        clear => { root.clear-activity(); }
        dismiss => { root.log-open = false; }
        window-drag => { root.window-drag(); }
    }

    // ===== 窗口轮廓 =====
    //
    // `no-frame: true` 意味着系统不给边框，而亮色主题的窗口底色接近白 ——
    // 压在浅色桌面或另一个白底窗口上时，边界完全看不出来。
    // 这一条 1px 描边就是窗口的全部轮廓；画在内容之后（= 最上层），
    // 且不接输入，所以不会挡住任何点击，也不参与布局。
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        border-width: 1px;
        border-color: Theme.window-bd;
    }

    // ===== 提示气泡层 =====
    //
    // 放在所有内容之后 = 画在最上层。图标按钮把文字与坐标写进 `Tooltip`
    // global（见 widgets.slint），这里只负责画 —— 全程不接输入，
    // 所以不会像 PopupWindow 那样把按钮的下一次点击吃掉。
    if Tooltip.text != "": Rectangle {
        x: min(Tooltip.x, parent.width - self.width - 8px);
        y: Tooltip.y;
        width: tip-text.preferred-width + 16px;
        height: tip-text.preferred-height + 10px;
        background: Theme.dark ? #0f1319 : #22272e;
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.border-2;

        tip-text := Text {
            width: 100%;
            height: 100%;
            text: Tooltip.text;
            font-family: Theme.font-ui;
            font-size: 12px;
            color: #f0f3f7;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== 剪贴板出口 =====
    //
    // Slint 的公开 Rust API 没有剪贴板（`Platform::set_clipboard_text` 是后端
    // 内部实现），但 `TextInput` 自带 `copy()`。所以留一个 0×0 的隐形输入框：
    // Rust 侧把要复制的文本灌进来 → 全选 → copy()。
    //
    // 不能只做「toast 说已复制」而不真写剪贴板 —— 迁移期就是这样，所有工具的
    // 复制按钮都在骗人。
    clip := TextInput {
        width: 0px;
        height: 0px;
        // single-line 会把多行内容截断，UUID 列表 / PEM 私钥都是多行。
        single-line: false;
    }
    // 每次用完都清空：选区矩形是按 TextInput 自己的几何画的，而这个框
    // 装着刚复制的整段文本且处于「全选」状态 —— 留着就会在界面上留一条
    // 与任何输入框都无关的蓝带。
    property <string> clip-out;
    public function copy-to-clipboard(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // 读剪贴板走同一个 0×0 输入框：Slint 的 Rust API 也没有「读剪贴板」的入口，
    // 但 TextInput 自己有 `paste()`。清空 → 粘贴 → 把文本交回 Rust。
    // 少了这一段，Ctrl+V 在所有编辑区里都是**静默无效**（`KeyOutcome.paste`
    // 一直没有消费者）。
    public function paste-from-clipboard() -> string {
        clip.text = "";
        clip.select-all();
        clip.paste();
        self.clip-out = clip.text;
        clip.text = "";
        return self.clip-out;
    }
}